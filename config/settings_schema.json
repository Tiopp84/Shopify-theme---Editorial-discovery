[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "instrument_serif_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "range",
        "id": "type_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "t:labels.type_scale",
        "default": 100
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "70rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.standard"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      }
    ]
  },
  {
    "name": "t:general.color_schemes",
    "settings": [
      { "type": "header", "content": "t:options.color_scheme.base" },
      { "type": "color", "id": "scheme_base_background", "default": "#FAF8F5", "label": "t:labels.background" },
      { "type": "color", "id": "scheme_base_foreground", "default": "#1A1A1A", "label": "t:labels.foreground" },
      { "type": "color", "id": "scheme_base_accent", "default": "#8B7355", "label": "t:labels.accent" },
      { "type": "color", "id": "scheme_base_border", "default": "#E5DFD6", "label": "t:labels.border" },
      { "type": "header", "content": "t:options.color_scheme.soft" },
      { "type": "color", "id": "scheme_soft_background", "default": "#F0EBE3", "label": "t:labels.background" },
      { "type": "color", "id": "scheme_soft_foreground", "default": "#2B2B2B", "label": "t:labels.foreground" },
      { "type": "color", "id": "scheme_soft_accent", "default": "#A08D6F", "label": "t:labels.accent" },
      { "type": "color", "id": "scheme_soft_border", "default": "#D9D0C3", "label": "t:labels.border" },
      { "type": "header", "content": "t:options.color_scheme.dark" },
      { "type": "color", "id": "scheme_dark_background", "default": "#1A1A1A", "label": "t:labels.background" },
      { "type": "color", "id": "scheme_dark_foreground", "default": "#FAF8F5", "label": "t:labels.foreground" },
      { "type": "color", "id": "scheme_dark_accent", "default": "#C4A876", "label": "t:labels.accent" },
      { "type": "color", "id": "scheme_dark_border", "default": "#4A4540", "label": "t:labels.border" }
    ]
  }
]
