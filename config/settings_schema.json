[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "instrument_serif_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "range",
        "id": "type_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "t:labels.type_scale",
        "default": 100
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "70rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.standard"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      { "type": "header", "content": "t:general.general" },
      { "type": "color", "id": "background_color", "default": "#FAF8F5", "label": "t:labels.background" },
      { "type": "color", "id": "text_color", "default": "#1A1A1A", "label": "t:labels.foreground" },
      { "type": "color", "id": "border_color", "default": "#E5DFD6", "label": "t:labels.border_and_divider" },
      { "type": "header", "content": "t:general.interactive_states" },
      { "type": "color", "id": "interactive_color", "default": "#8B7355", "label": "t:labels.interactive_color", "info": "t:descriptions.interactive_color" },
      { "type": "color", "id": "interactive_background", "default": "#E4E8DC", "label": "t:labels.interactive_background", "info": "t:descriptions.interactive_background" },
      { "type": "header", "content": "t:general.header" },
      { "type": "color", "id": "header_background_color", "default": "#F5F3EE", "label": "t:labels.header_background_color" },
      { "type": "color", "id": "header_navigation_color", "default": "#242119", "label": "t:labels.navigation_color" },
      { "type": "color", "id": "header_navigation_hover_color", "default": "#242119", "label": "t:labels.navigation_hover_color" },
      { "type": "color", "id": "header_navigation_hover_text_color", "default": "#F5F3EE", "label": "t:labels.navigation_hover_text_color" },
      { "type": "color", "id": "header_dropdown_background_color", "default": "#F5F3EE", "label": "t:labels.dropdown_background_color" },
      { "type": "color", "id": "header_dropdown_text_color", "default": "#242119", "label": "t:labels.dropdown_text_color" },
      { "type": "header", "content": "t:general.announcement_bar" },
      { "type": "color", "id": "announcement_background_color", "default": "#1A1A1A", "label": "t:labels.background_color" },
      { "type": "color", "id": "announcement_text_color", "default": "#FAF8F5", "label": "t:labels.text_color" },
      { "type": "header", "content": "t:general.footer" },
      { "type": "color", "id": "footer_background_color", "default": "#1A1A1A", "label": "t:labels.background_color" },
      { "type": "color", "id": "footer_text_color", "default": "#FAF8F5", "label": "t:labels.text_color" },
      { "type": "header", "content": "t:general.overlays" },
      { "type": "color", "id": "overlay_color", "default": "#000000", "label": "t:labels.background_color" },
      { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "t:labels.overlay_opacity", "default": 45 },
      { "type": "header", "content": "t:general.commerce" },
      { "type": "color", "id": "price_color", "default": "#1A1A1A", "label": "t:labels.price" },
      { "type": "color", "id": "compare_price_color", "default": "#767676", "label": "t:labels.compare_price" },
      { "type": "color", "id": "sale_price_color", "default": "#A33F2B", "label": "t:labels.sale_price" },
      { "type": "color", "id": "sale_badge_background", "default": "#F7BEBE", "label": "t:labels.sale_badge_background" },
      { "type": "color", "id": "sale_badge_text", "default": "#1A1A1A", "label": "t:labels.sale_badge_text" }
    ]
  },
  {
    "name": "t:general.buttons",
    "settings": [
      { "type": "color", "id": "button_background", "default": "#1A1A1A", "label": "t:labels.theme_button_background" },
      { "type": "color", "id": "button_text", "default": "#FAF8F5", "label": "t:labels.theme_button_text" },
      { "type": "color", "id": "button_hover_background", "default": "#3A3A3A", "label": "t:labels.theme_button_hover_background" },
      { "type": "range", "id": "button_corner_radius", "min": 0, "max": 24, "step": 1, "unit": "px", "label": "t:labels.button_corner_radius", "default": 0 }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "t:labels.instagram" },
      { "type": "url", "id": "social_threads", "label": "t:labels.threads" },
      { "type": "url", "id": "social_facebook", "label": "t:labels.facebook" },
      { "type": "url", "id": "social_x", "label": "t:labels.x" },
      { "type": "url", "id": "social_pinterest", "label": "t:labels.pinterest" },
      { "type": "url", "id": "social_youtube", "label": "t:labels.youtube" },
      { "type": "url", "id": "social_tiktok", "label": "t:labels.tiktok" },
      { "type": "url", "id": "social_snapchat", "label": "t:labels.snapchat" },
      { "type": "url", "id": "social_tumblr", "label": "t:labels.tumblr" },
      { "type": "url", "id": "social_linkedin", "label": "t:labels.linkedin" },
      { "type": "url", "id": "social_vimeo", "label": "t:labels.vimeo" }
    ]
  }
]
