      { "type": "url", "id": "social_youtube", "label": "t:labels.youtube" },
      { "type": "url", "id": "social_tiktok", "label": "t:labels.tiktok" },
      { "type": "url", "id": "social_snapchat", "label": "t:labels.snapchat" },
      { "type": "url", "id": "social_tumblr", "label": "t:labels.tumblr" },
      { "type": "url", "id": "social_linkedin", "label": "t:labels.linkedin" },
