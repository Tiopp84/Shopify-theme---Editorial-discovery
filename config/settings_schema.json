  {
    "name": "t:general.social_media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "t:labels.instagram" },
      { "type": "url", "id": "social_threads", "label": "t:labels.threads" },
      { "type": "url", "id": "social_facebook", "label": "t:labels.facebook" },
      { "type": "url", "id": "social_x", "label": "t:labels.x" },
