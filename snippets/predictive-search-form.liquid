{% doc %}
  Renders the shared predictive search form with standard GET fallback.

  @param {string} context_id - Unique suffix for input and result IDs.
  @param {string} [search_terms] - Existing search terms.
  @param {boolean} [in_drawer] - Use drawer-contained result presentation.
{% enddoc %}

{% assign predictive_resource_types = 'product' %}
{% if settings.predictive_search_content != 'products' %}
  {% assign predictive_resource_types = 'product,collection,page,article' %}
{% endif %}

<predictive-search
  class="predictive-search{% if in_drawer %} predictive-search--drawer{% endif %}"
  data-predictive-url="{{ routes.predictive_search_url }}"
  data-predictive-types="{{ predictive_resource_types }}"
  data-loading-text="{{ 'search.predictive.loading' | t | escape }}"
  data-updated-text="{{ 'search.predictive.updated' | t | escape }}"
  data-error-text="{{ 'search.predictive.error' | t | escape }}"
>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="SearchInput-{{ context_id }}">{{ 'search.placeholder' | t }}</label>
    <input
      id="SearchInput-{{ context_id }}"
      type="search"
      name="q"
      value="{{ search_terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="PredictiveResults-{{ context_id }}"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
    >
    <button type="submit" aria-label="{{ 'search.submit' | t }}">
      {% render 'icon', name: 'search' %}
    </button>
  </form>
  <p class="visually-hidden" role="status" aria-live="polite" data-predictive-status></p>
  <div id="PredictiveResults-{{ context_id }}" class="predictive-search__results" data-predictive-results hidden></div>
</predictive-search>

{% stylesheet %}
  .predictive-search {
    position: relative;
    z-index: 2;
    display: block;
    max-width: 52rem;
  }

  .search-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: .25rem;
  }

  .search-form input {
    min-width: 0;
    min-height: 3.25rem;
    padding-inline: var(--space-3);
    border: 1px solid color-mix(in srgb, var(--color-border) 84%, var(--color-background));
    border-radius: var(--field-theme-radius);
    background: var(--color-background);
    box-shadow: none;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .search-form input:focus-visible { border-color: var(--color-foreground); box-shadow: var(--focus-ring); outline: 0; }

  .search-form button {
    min-width: 3.25rem;
    min-height: 3.25rem;
    border: 0;
    border-radius: var(--button-theme-radius);
    background: var(--button-theme-background);
    color: var(--button-theme-color);
    display: grid;
    place-items: center;
    padding: 0;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .search-form button:is(:hover, :focus-visible) { background: var(--button-theme-hover-background); outline: 0; transform: translateY(-.06rem); }
  .search-form button:focus-visible { box-shadow: var(--focus-ring); }

  .search-form button svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .predictive-search__results[hidden] {
    display: none;
  }

  .predictive-search__results {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline: 0;
    max-height: min(65vh, 36rem);
    overflow-y: auto;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-background);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 10%);
    transition: opacity 120ms ease;
  }

  .predictive-search--drawer {
    max-width: none;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .predictive-search--drawer .search-form {
    gap: .25rem;
  }

  .predictive-search--drawer .search-form input,
  .predictive-search--drawer .search-form button {
    min-height: 3.25rem;
  }

  .predictive-search--drawer .search-form input {
    padding-inline: var(--space-4);
  }

  .predictive-search--drawer .search-form button {
    width: 3.25rem;
  }

  .predictive-search--drawer .predictive-search__results {
    position: static;
    min-height: 0;
    max-height: calc(100dvh - 16rem);
    margin-block-start: var(--space-5);
    padding: 0;
    border: 0;
    border-radius: 0;
    overflow-y: auto;
    box-shadow: none;
    scrollbar-width: thin;
  }

  .predictive-search[aria-busy] .predictive-search__results {
    opacity: 0.68;
  }

  .predictive-search__loading,
  .predictive-search__empty {
    padding-block: var(--space-6);
    color: color-mix(in srgb, currentcolor 65%, transparent);
  }

  .predictive-search__group + .predictive-search__group {
    margin-block-start: var(--space-5);
  }

  .predictive-search__group h2 {
    margin-block-end: var(--space-3);
    font-family: var(--font-primary--family);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .predictive-search__group ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .predictive-search__group a {
    color: currentcolor;
    text-decoration: none;
  }

  .predictive-search__group a:hover,
  .predictive-search__group a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .predictive-search__product {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
  }

  .predictive-search__product-media {
    display: block;
    width: 4rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--color-border) 30%, var(--color-background));
  }

  .predictive-search__product-media > img,
  .predictive-search__product-media > svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .predictive-search__product > span {
    min-width: 0;
    display: grid;
    gap: var(--space-1);
  }

  .predictive-search--drawer .predictive-search__group + .predictive-search__group {
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--color-border);
  }

  .predictive-search--drawer .predictive-search__group h2 {
    margin-block-end: var(--space-4);
    color: color-mix(in srgb, currentcolor 62%, transparent);
  }

  .predictive-search--drawer .predictive-search__group ul {
    gap: var(--space-3);
  }

  .predictive-search--drawer .predictive-search__product strong {
    font-weight: 500;
    line-height: 1.25;
  }

  @media (max-width: 47.99rem) {
    .predictive-search--drawer .predictive-search__results {
      max-height: calc(82dvh - 13rem);
      margin-block-start: var(--space-4);
      padding-inline-end: var(--space-1);
    }

    .predictive-search--drawer .predictive-search__product {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }

    .predictive-search--drawer .predictive-search__product-media {
      width: 3.5rem;
    }

    .predictive-search--drawer .predictive-search__product strong {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .predictive-search__results {
      transition: none;
    }
  }
{% endstylesheet %}
