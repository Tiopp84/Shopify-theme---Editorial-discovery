{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--style: {{ settings.type_heading_font.style }};
    --font-heading--weight: {{ settings.type_heading_font.weight }};
    --font-commerce: var(--font-primary--family);
    --font-campaign: var(--font-heading--family);
    --heading-letter-spacing: {{ settings.heading_letter_spacing | default: 25 | divided_by: 1000.0 }}em;
    --heading-base-size: {{ settings.heading_base_size | default: 50 }}px;
    --heading-size-32: {{ settings.heading_base_size | default: 50 | times: 0.32 }}px;
    --heading-size-35: {{ settings.heading_base_size | default: 50 | times: 0.35 }}px;
    --heading-size-40: {{ settings.heading_base_size | default: 50 | times: 0.4 }}px;
    --heading-size-43: {{ settings.heading_base_size | default: 50 | times: 0.43 }}px;
    --heading-size-44: {{ settings.heading_base_size | default: 50 | times: 0.44 }}px;
    --heading-size-45: {{ settings.heading_base_size | default: 50 | times: 0.45 }}px;
    --heading-size-46: {{ settings.heading_base_size | default: 50 | times: 0.46 }}px;
    --heading-size-48: {{ settings.heading_base_size | default: 50 | times: 0.48 }}px;
    --heading-size-53: {{ settings.heading_base_size | default: 50 | times: 0.53 }}px;
    --heading-size-56: {{ settings.heading_base_size | default: 50 | times: 0.56 }}px;
    --heading-size-64: {{ settings.heading_base_size | default: 50 | times: 0.64 }}px;
    --heading-size-72: {{ settings.heading_base_size | default: 50 | times: 0.72 }}px;
    --heading-size-75: {{ settings.heading_base_size | default: 50 | times: 0.75 }}px;
    --heading-size-76: {{ settings.heading_base_size | default: 50 | times: 0.76 }}px;
    --heading-size-78: {{ settings.heading_base_size | default: 50 | times: 0.78 }}px;
    --heading-size-80: {{ settings.heading_base_size | default: 50 | times: 0.8 }}px;
    --heading-size-86: {{ settings.heading_base_size | default: 50 | times: 0.86 }}px;
    --heading-size-88: {{ settings.heading_base_size | default: 50 | times: 0.88 }}px;
    --heading-size-96: {{ settings.heading_base_size | default: 50 | times: 0.96 }}px;
    --heading-size-102: {{ settings.heading_base_size | default: 50 | times: 1.02 }}px;
    --heading-size-112: {{ settings.heading_base_size | default: 50 | times: 1.12 }}px;
    --heading-size-128: {{ settings.heading_base_size | default: 50 | times: 1.28 }}px;
    --heading-size-141: {{ settings.heading_base_size | default: 50 | times: 1.41 }}px;
    --heading-size-144: {{ settings.heading_base_size | default: 50 | times: 1.44 }}px;
    --heading-size-160: {{ settings.heading_base_size | default: 50 | times: 1.6 }}px;
    --heading-size-176: {{ settings.heading_base_size | default: 50 | times: 1.76 }}px;
    --heading-size-192: {{ settings.heading_base_size | default: 50 | times: 1.92 }}px;
    --heading-size-240: {{ settings.heading_base_size | default: 50 | times: 2.4 }}px;
    --heading-line-height: {{ settings.heading_line_height | default: 1.1 }};
    --navigation-size: {{ settings.navigation_size | default: 14 }}px;
    --navigation-font: {% if settings.navigation_font == 'heading' %}var(--font-campaign){% else %}var(--font-commerce){% endif %};
    --product-card-font: {% if settings.product_card_font == 'heading' %}var(--font-campaign){% else %}var(--font-commerce){% endif %};
    --product-price-font: {% if settings.product_price_font == 'heading' %}var(--font-campaign){% else %}var(--font-commerce){% endif %};
    --product-price-size: {{ settings.product_price_size | default: 15 }}px;
    --product-price-size-quick-add: {{ settings.product_price_size | default: 15 | times: 1.33 }}px;
    --product-price-size-cart-line: {{ settings.product_price_size | default: 15 | times: 0.93 }}px;
    --product-price-size-cart-total: {{ settings.product_price_size | default: 15 | times: 1.07 }}px;
    --product-price-size-product-min: {{ settings.product_price_size | default: 15 | times: 1.55 }}px;
    --product-price-size-product-max: {{ settings.product_price_size | default: 15 | times: 1.81 }}px;
    --collection-title-font: {% if settings.collection_title_font == 'body' %}var(--font-commerce){% else %}var(--font-campaign){% endif %};
    --collection-title-size: {{ settings.collection_title_size | default: 15 }}px;
    --body-text-letter-spacing: {{ settings.body_text_letter_spacing | default: 25 | divided_by: 1000.0 }}em;
    --body-text-base-size: {{ settings.body_text_base_size | default: 17 }}px;
    --body-text-line-spacing: {{ settings.body_text_line_spacing | default: 1.4 }};
    --small-label-font: {% if settings.small_label_font == 'heading' %}var(--font-campaign){% else %}var(--font-commerce){% endif %};
    --small-label-size: {{ settings.small_label_size | default: 12 }}px;
    --small-label-letter-spacing: {{ settings.small_label_letter_spacing | default: 80 | divided_by: 1000.0 }}em;
    --small-label-line-height: {{ settings.small_label_line_height | default: 1.2 }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color | default: '#FAF8F5' }};
    --color-foreground: {{ settings.text_color | default: '#1A1A1A' }};
    --color-interactive: {{ settings.interactive_color | default: '#8B7355' }};
    --color-interactive-background: {{ settings.interactive_background | default: '#E4E8DC' }};
    --color-border: {{ settings.border_color | default: '#E5DFD6' }};
    --color-panel-01: color-mix(in srgb, var(--color-background) 92%, var(--color-foreground));
    --color-panel-02: color-mix(in srgb, var(--color-background) 88%, var(--color-foreground));
    --color-status-success: #287a54;
    --color-status-unavailable: #b3523d;
    --color-status-error: #a33f2b;
    --color-status-error-strong: #8c2a19;
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-chapter: 4rem;
    --space-chapter-mobile: 2.5rem;
    --space-8px: 0.5rem;
    --space-16px: 1rem;
    --space-24px: 1.5rem;
    --space-40px: 2.5rem;
    --space-64px: 4rem;
    --focus-ring: 0 0 0 0.1875rem color-mix(in srgb, var(--color-interactive) 75%, transparent);
    --button-theme-background: {{ settings.button_background | default: '#1A1A1A' }};
    --button-theme-color: {{ settings.button_text | default: '#FAF8F5' }};
    --button-theme-hover-background: {{ settings.button_hover_background | default: '#3A3A3A' }};
    --button-theme-font: {% if settings.button_font == 'heading' %}var(--font-campaign){% else %}var(--font-commerce){% endif %};
    --button-theme-font-size: {{ settings.button_text_size | default: 14 }}px;
    --button-theme-letter-spacing: {{ settings.button_letter_spacing | default: 40 | divided_by: 1000.0 }}em;
    --button-theme-height: {{ settings.button_height | default: 44 }}px;
    --button-theme-padding-inline: {{ settings.button_horizontal_padding | default: 24 }}px;
    --button-theme-border-width: {{ settings.button_border_width | default: 1 }}px;
    --button-theme-radius: {{ settings.button_corner_radius | default: 0 }}px;
    --field-theme-height: {{ settings.field_height | default: 44 }}px;
    --field-theme-border-width: {{ settings.field_border_width | default: 1 }}px;
    --field-theme-radius: {{ settings.field_corner_radius | default: 0 }}px;
    --overlay-color: {{ settings.overlay_color | default: '#000000' }};
    --overlay-opacity: {{ settings.overlay_opacity | default: 45 }}%;
    --price-color: {{ settings.price_color | default: '#1A1A1A' }};
    --compare-price-color: {{ settings.compare_price_color | default: '#767676' }};
    --sale-price-color: {{ settings.sale_price_color | default: '#A33F2B' }};
    --sale-badge-background: {{ settings.sale_badge_background | default: '#F7BEBE' }};
    --sale-badge-color: {{ settings.sale_badge_text | default: '#1A1A1A' }};
  }
{% endstyle %}
