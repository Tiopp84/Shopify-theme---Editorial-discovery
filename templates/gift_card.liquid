{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% style %}
      .gift-card-page { display: grid; min-block-size: 100dvh; padding: clamp(1.5rem, 5vw, 4rem) var(--page-gutter); place-items: center; }
      .gift-card-page__card { background: var(--color-background); border: 1px solid var(--color-border); box-shadow: 0 1.25rem 3.5rem color-mix(in srgb, var(--color-foreground) 10%, transparent); inline-size: min(100%, 38rem); padding: clamp(1.5rem, 5vw, 3.5rem); text-align: center; }
      .gift-card-page__eyebrow { color: var(--color-accent); font-size: .75rem; font-weight: 700; letter-spacing: .12em; margin: 0 0 var(--space-3); text-transform: uppercase; }
      .gift-card-page h1 { font-family: var(--font-commerce); font-size: clamp(2rem, 5vw, 3.5rem); font-style: normal; font-weight: 500; letter-spacing: -.045em; line-height: 1; margin: 0; }
      .gift-card-page__status { color: #8c2a19; line-height: 1.5; margin: var(--space-4) auto 0; max-inline-size: 28rem; }
      .gift-card-page__visual { aspect-ratio: 3 / 2; display: block; margin: var(--space-5) auto 0; max-inline-size: 19rem; object-fit: contain; }
      .gift-card-page__shop { font-size: 1rem; font-weight: 600; margin: var(--space-5) 0 0; }
      .gift-card-page__instruction { color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background)); line-height: 1.5; margin: var(--space-2) auto 0; max-inline-size: 28rem; }
      .gift-card-page__code-label { font-size: .75rem; font-weight: 700; letter-spacing: .1em; margin: var(--space-5) 0 var(--space-2); text-transform: uppercase; }
      .gift-card-page__code { border: 1px dashed var(--color-border); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: clamp(1.05rem, 3vw, 1.35rem); letter-spacing: .1em; margin: 0; overflow-wrap: anywhere; padding: var(--space-3); }
      .gift-card-page__expiry { color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background)); font-size: .875rem; line-height: 1.5; margin: var(--space-3) 0 0; }
      .gift-card-page__wallet { display: inline-block; margin-block-start: var(--space-5); }
      .gift-card-page__wallet img { block-size: auto; display: block; inline-size: 12.5rem; }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main class="gift-card-page">
      <article class="gift-card-page__card" aria-labelledby="GiftCardTitle">
        <p class="gift-card-page__eyebrow">{{ 'gift_card.title' | t }}</p>
        <h1 id="GiftCardTitle">{{ gift_card.balance | money }}</h1>

        {% if gift_card.enabled == false or gift_card.expired %}
          <p class="gift-card-page__status" role="status">{{ 'gift_card.expired' | t }}</p>
        {% endif %}

        {% if gift_card.expires_on %}
          {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}
          <p class="gift-card-page__expiry">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
        {% endif %}

        {% if settings.logo %}
          {{ settings.logo | image_url: width: 600 | image_tag: class: 'gift-card-page__visual', alt: shop.name, widths: '300, 450, 600', sizes: '(min-width: 40rem) 19rem, calc(100vw - 6rem)' }}
        {% else %}
          <img
            class="gift-card-page__visual"
            src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.card' | t }}"
            width="300"
            height="200"
          >
        {% endif %}

        <p class="gift-card-page__shop">{{ shop.name | escape }}</p>
        <p class="gift-card-page__instruction">{{ 'gift_card.use_at_checkout' | t }}</p>
        <p class="gift-card-page__code-label">{{ 'gift_card.code' | t }}</p>
        <p class="gift-card-page__code">{{ gift_card.code | format_code }}</p>

        {% if gift_card.pass_url %}
          <a class="gift-card-page__wallet" href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              width="200"
              height="60"
            >
          </a>
        {% endif %}
      </article>
    </main>
  </body>
</html>
