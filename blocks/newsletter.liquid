<div class="newsletter" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2>{{ block.settings.heading | escape }}</h2>
  {% endif %}
  {% if block.settings.text != blank %}
    <div class="newsletter__text">{{ block.settings.text }}</div>
  {% endif %}

  {% form 'customer', class: 'newsletter__form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label class="visually-hidden" for="NewsletterEmail-{{ block.id }}">{{ 'newsletter.email' | t }}</label>
    <input
      id="NewsletterEmail-{{ block.id }}"
      type="email"
      name="contact[email]"
      value="{{ form.email | escape }}"
      placeholder="{{ 'newsletter.email' | t }}"
      autocapitalize="off"
      autocomplete="email"
      required
    >
    <button type="submit">{{ 'newsletter.submit' | t }}</button>

    {% if form.posted_successfully? %}
      <p class="newsletter__message" role="status">{{ 'newsletter.success' | t }}</p>
    {% elsif form.errors %}
      <div class="newsletter__message" role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}
  {% endform %}
</div>

{% stylesheet %}
  .newsletter {
    container-type: inline-size;
    max-width: 30rem;
  }

  .newsletter h2 {
    margin-block-end: var(--space-3);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
  }

  .newsletter__text {
    margin-block-end: var(--space-4);
  }

  .newsletter__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .newsletter__form input {
    min-width: 0;
    border-start-end-radius: 0;
    border-end-end-radius: 0;
  }

  .newsletter__form button {
    border-start-start-radius: 0;
    border-end-start-radius: 0;
  }

  .newsletter__message {
    grid-column: 1 / -1;
    margin-block-start: var(--space-3);
  }

  @container (max-width: 13rem) {
    .newsletter__form {
      grid-template-columns: minmax(0, 1fr);
    }

    .newsletter__form input {
      border-radius: var(--field-theme-radius);
    }

    .newsletter__form button {
      border-radius: var(--button-theme-radius);
      justify-self: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Notes for a considered wardrobe"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>New studies, material stories, and useful dispatches.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:general.newsletter"
    }
  ]
}
{% endschema %}
