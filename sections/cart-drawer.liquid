{% liquid
  assign line_total = 0
  for item in cart.items
    assign line_total = line_total | plus: item.final_line_price
  endfor
%}

<cart-drawer class="cart-drawer" data-cart-drawer data-cart-url="{{ routes.cart_url }}" data-cart-currency="{{ cart.currency.iso_code }}" data-cart-total-cents="{{ line_total }}" data-cart-discount-cents="0" data-cart-empty-text="{{ 'cart.empty_text' | t | escape }}" data-cart-continue-shopping="{{ 'cart.continue_shopping' | t | escape }}" data-cart-view-cart="{{ 'cart.view_cart' | t | escape }}" data-cart-subtotal-label="{{ 'cart.subtotal' | t | escape }}" data-cart-checkout-label="{{ 'cart.checkout' | t | escape }}" data-cart-taxes-note="{{ 'cart.taxes_and_shipping_at_checkout' | t | escape }}" data-cart-remove-label="{{ 'cart.remove' | t | escape }}" data-cart-decrease-label="{{ 'cart.decrease_quantity' | t | escape }}" data-cart-increase-label="{{ 'cart.increase_quantity' | t | escape }}" data-cart-maximum-quantity="{{ 'cart.maximum_quantity' | t | escape }}">
  <dialog class="cart-drawer__dialog" aria-labelledby="CartDrawerTitle-{{ section.id }}" data-cart-dialog scroll-lock>
    <div class="cart-drawer__header">
      <h2 id="CartDrawerTitle-{{ section.id }}">{{ 'cart.title' | t }}</h2>
      <button type="button" aria-label="{{ 'cart.close' | t }}" data-cart-close>×</button>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite" data-cart-status></p>
    <div class="cart-drawer__body" data-cart-content>
      {% if cart.item_count == 0 %}
        <div class="cart-drawer__empty"><p>{{ 'cart.empty_text' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a></div>
      {% else %}
        <form action="{{ routes.cart_url }}" method="post" data-cart-form>
          <div class="cart-drawer__lines">
            {% for item in cart.items %}
              {% assign cart_stock_limit = blank %}
              {% if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' %}{% assign cart_stock_limit = item.variant.inventory_quantity %}{% endif %}
              <article class="cart-drawer__line" data-cart-line="{{ item.key }}" data-cart-variant-id="{{ item.variant.id }}"{% if cart_stock_limit != blank %} data-cart-stock-limit="{{ cart_stock_limit }}"{% endif %} data-cart-quantity="{{ item.quantity }}" data-cart-unit-price="{{ item.final_price }}">
                <a href="{{ item.url }}">{% render 'image', image: item.image, alt: item.product.title, width: 160, sizes: '80px' %}</a>
                <div class="cart-drawer__line-details">
                  <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}
                  {% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
                  {% if item.line_level_discount_allocations.size > 0 %}<ul class="cart-drawer__discounts" role="list">{% for discount in item.line_level_discount_allocations %}<li>{{ discount.discount_application.title | escape }}</li>{% endfor %}</ul>{% endif %}
                  <div class="cart-drawer__line-actions">
                    <label class="visually-hidden" for="DrawerQuantity-{{ item.index }}">{{ 'cart.quantity' | t }}</label>
                    <div class="cart-drawer__quantity-control">
                      <button type="button" aria-label="{{ 'cart.decrease_quantity' | t }}" data-cart-quantity-step="-1" data-cart-key="{{ item.key }}" data-cart-quantity-input="DrawerQuantity-{{ item.index }}">−</button>
                      <input id="DrawerQuantity-{{ item.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"{% if cart_stock_limit != blank %} max="{{ cart_stock_limit }}"{% endif %} step="1" inputmode="numeric" data-cart-quantity data-cart-key="{{ item.key }}">
                      <button type="button" aria-label="{{ 'cart.increase_quantity' | t }}" data-cart-quantity-step="1" data-cart-key="{{ item.key }}" data-cart-quantity-input="DrawerQuantity-{{ item.index }}">+</button>
                    </div>
                    <button type="button" aria-label="{{ 'cart.remove' | t }}" title="{{ 'cart.remove' | t }}" data-cart-remove data-cart-key="{{ item.key }}">{% render 'icon', name: 'trash' %}</button>
                  </div>
                </div>
                <strong class="cart-drawer__line-price" data-cart-line-total>{{ item.final_line_price | money }}</strong>
              </article>
            {% endfor %}
          </div>
          <footer class="cart-drawer__footer">
            <p class="cart-drawer__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong data-cart-subtotal>{{ line_total | money_with_currency }}</strong></p>
            <p class="cart-drawer__checkout-note">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>
            <button type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
            <a href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
          </footer>
        </form>
      {% endif %}
    </div>
  </dialog>
</cart-drawer>

{% stylesheet %}
  .cart-drawer__dialog { display: grid; grid-template-rows: auto minmax(0, 1fr); inline-size: min(29rem, 100%); block-size: 100svh; max-inline-size: 100%; max-block-size: none; margin: 0 0 0 auto; border: 0; border-radius: 1.25rem 0 0 1.25rem; overflow: hidden; padding: 0; }
  .cart-drawer__header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-block-size: 4.5rem; padding: var(--space-4) var(--space-5); border-block-end: 1px solid var(--color-border); }
  .cart-drawer__header h2 { font-size: clamp(1.35rem, 3vw, 1.65rem); }
  .cart-drawer__header [data-cart-close] { display: grid; place-items: center; inline-size: 2.75rem; min-block-size: 2.75rem; padding: 0; border-color: transparent; border-radius: 50%; background: transparent; color: currentcolor; font-size: 1.4rem; }
  .cart-drawer__header [data-cart-close]:is(:hover, :focus-visible) { background: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background)); }
  .cart-drawer__body { min-block-size: 0; padding: var(--space-5); overflow-y: auto; }
  .cart-drawer__body form { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-block-size: 100%; gap: var(--space-5); }
  .cart-drawer__lines, .cart-drawer__empty { display: grid; align-content: start; gap: var(--space-4); }
  .cart-drawer__line { display: grid; grid-template-columns: 5.25rem minmax(0, 1fr) auto; gap: var(--space-3); border-block-end: 1px solid var(--color-border); padding-block-end: var(--space-4); }
  .cart-drawer__line[hidden] { display: none; }
  .cart-drawer__line img { aspect-ratio: 4 / 5; object-fit: cover; inline-size: 100%; }
  .cart-drawer__line-details { display: grid; align-content: start; gap: var(--space-1); min-inline-size: 0; }
  .cart-drawer__line-details > a { font-weight: 600; line-height: 1.3; text-decoration-thickness: 1px; text-underline-offset: .16em; }
  .cart-drawer__line-details > p { color: color-mix(in srgb, var(--color-foreground) 68%, var(--color-background)); font-size: .9em; }
  .cart-drawer__line-price { align-self: start; white-space: nowrap; }
  .cart-drawer__line-actions { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-block-start: var(--space-3); }
  .cart-drawer__quantity-control { display: inline-grid; grid-template-columns: 2rem 2.5rem 2rem; align-items: center; border: 1px solid var(--color-border); border-radius: var(--style-border-radius-inputs); overflow: hidden; }
  .cart-drawer__quantity-control button { display: grid; place-items: center; min-block-size: 2.35rem; padding: 0; border: 0; border-radius: 0; background: transparent; color: currentcolor; font-size: 1.15rem; }
  .cart-drawer__quantity-control button:is(:hover, :focus-visible) { background: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background)); }
  .cart-drawer__quantity-control input { inline-size: 100%; min-block-size: 2.35rem; padding: 0; border-block: 0; border-inline: 1px solid var(--color-border); border-radius: 0; text-align: center; }
  .cart-drawer__quantity-control input::-webkit-inner-spin-button { appearance: none; margin: 0; }
  .cart-drawer__line-actions [data-cart-remove] { display: grid; place-items: center; inline-size: 2.35rem; min-block-size: 2.35rem; padding: 0; border: 0; border-radius: 50%; background: transparent; color: currentcolor; }
  .cart-drawer__line-actions [data-cart-remove]:is(:hover, :focus-visible) { background: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background)); }
  .cart-drawer__line-actions [data-cart-remove] .icon { inline-size: 1.1rem; block-size: 1.1rem; }
  .cart-drawer__discounts { margin: 0; padding: 0; list-style: none; color: var(--color-accent); font-size: .85em; }
  .cart-drawer__footer { display: grid; gap: var(--space-3); padding-block-start: var(--space-4); border-block-start: 1px solid var(--color-border); }
  .cart-drawer[data-cart-pending] [data-cart-line-total], .cart-drawer[data-cart-pending] [data-cart-subtotal] { opacity: .7; }
  .cart-drawer__subtotal { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); margin: 0; font-size: 1.1rem; }
  .cart-drawer__checkout-note { color: color-mix(in srgb, var(--color-foreground) 68%, var(--color-background)); font-size: .85em; }
  .cart-drawer__footer [name='checkout'] { inline-size: 100%; min-block-size: 3.25rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .cart-drawer__footer > a { justify-self: center; font-size: .9em; text-underline-offset: .18em; }
  .cart-drawer__dialog::backdrop { background: rgb(0 0 0 / .45); }
  @media (max-width: 749px) { .cart-drawer__dialog { inline-size: 100%; block-size: min(82svh, 44rem); margin: auto 0 0; border-radius: 1.25rem 1.25rem 0 0; } }
{% endstylesheet %}

{% schema %}
{ "name": "Cart drawer", "settings": [] }
{% endschema %}
