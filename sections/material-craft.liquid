<section class="material-craft full-width material-craft--media-{{ section.settings.media_position }} material-craft--spacing-{{ section.settings.section_spacing }}" data-aos-section style="--material-craft-background: {{ section.settings.background_color }};" {% if section.settings.heading != blank %}aria-labelledby="MaterialCraftHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="material-craft__images">
    {% for index in (1..2) %}
      {% assign image_key = 'image_' | append: index %}
      {% assign image = section.settings[image_key] %}
      <div class="material-craft__image material-craft__image--{{ index }}"{% unless request.visual_preview_mode %} data-aos="{% if index == 1 %}fade-right{% else %}fade-up-left{% endif %}"{% if index == 2 %} data-aos-delay="120"{% endif %}{% endunless %}>
        {% if image != blank %}
          {% render 'image', image: image, alt: image.alt, width: 1400, widths: '360, 540, 720, 960, 1200, 1400', sizes: '(min-width: 64rem) 32vw, 75vw' %}
        {% else %}
          <span class="material-craft__placeholder" aria-hidden="true">{{ 'lifestyle-' | append: index | placeholder_svg_tag }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  <div class="material-craft__content" data-aos="fade-left" data-aos-delay="80">
    {% if section.settings.eyebrow != blank %}<p class="material-craft__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 id="MaterialCraftHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="material-craft__text">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.link_label != blank and section.settings.link != blank %}<a class="material-craft__link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}
  </div>
</section>

{% stylesheet %}
  .material-craft { align-items: center; background: var(--material-craft-background, var(--color-background)); display: grid; gap: clamp(2.5rem, 7vw, 8rem); margin: 0 0 var(--space-chapter); padding-inline: max(var(--page-margin), calc((100vw - var(--page-width)) / 2)); }
  .material-craft--spacing-compact { margin-block-end: var(--space-6); }
  .material-craft--spacing-spacious { margin-block-end: calc(var(--space-chapter) + var(--space-5)); padding-block: var(--space-5); }
  .material-craft__images { align-items: end; display: grid; gap: var(--space-3); grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }
  .material-craft__image { background: var(--color-panel-02); overflow: hidden; }
  .material-craft__image--1 { aspect-ratio: 4 / 5; }
  .material-craft__image--2 { aspect-ratio: 3 / 4; margin-block-end: clamp(1.5rem, 7vw, 7rem); }
  .material-craft__image .image, .material-craft__image .image > img, .material-craft__placeholder, .material-craft__placeholder svg { block-size: 100%; display: block; height: 100%; inline-size: 100%; object-fit: cover; width: 100%; }
  .material-craft__placeholder { background: var(--color-panel-02); color: color-mix(in srgb, var(--color-foreground) 30%, var(--color-panel-02)); }
  .material-craft__content { display: grid; gap: var(--space-4); max-width: 31rem; }
  .material-craft__eyebrow { font-size: .6875rem; font-weight: 600; letter-spacing: .1em; margin: 0; text-transform: uppercase; }
  .material-craft h2 { font-family: var(--font-campaign); font-size: clamp(2.4rem, 4.1vw, 4.2rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.04em; line-height: .95; margin: 0; }
  .material-craft__text { color: color-mix(in srgb, var(--color-foreground) 74%, var(--color-background)); font-size: .9375rem; line-height: 1.6; }
  .material-craft__text > :first-child { margin-block-start: 0; }
  .material-craft__text > :last-child { margin-block-end: 0; }
  .material-craft__link { background: var(--color-foreground); color: var(--color-background); font-size: .6875rem; font-weight: 600; justify-self: start; letter-spacing: .1em; padding: .95rem 1.35rem; text-decoration: none; text-transform: uppercase; }
  .material-craft__link:is(:hover, :focus-visible) { background: var(--color-accent); }
  @media (min-width: 64rem) { .material-craft { grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .65fr); } .material-craft--media-right { grid-template-columns: minmax(18rem, .65fr) minmax(0, 1.15fr); } .material-craft--media-right .material-craft__images { grid-column: 2; } .material-craft--media-right .material-craft__content { grid-column: 1; grid-row: 1; } }
  @media (min-width: 48rem) and (max-width: 63.99rem) { .material-craft { grid-template-columns: minmax(0, 1.1fr) minmax(17rem, .9fr); } .material-craft--media-right { grid-template-columns: minmax(17rem, .9fr) minmax(0, 1.1fr); } .material-craft--media-right .material-craft__images { grid-column: 2; } .material-craft--media-right .material-craft__content { grid-column: 1; grid-row: 1; } }
  @media (max-width: 63.99rem) { .material-craft { gap: var(--space-5); margin-block-end: var(--space-chapter-mobile); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.material_craft",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "t:labels.image_one" },
    { "type": "image_picker", "id": "image_2", "label": "t:labels.image_two" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Material note" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "The details make the difference" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Fabric, finish and proportion are considered together, so everyday pieces feel distinct without asking for attention.</p>" },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label" },
    { "type": "url", "id": "link", "label": "t:labels.link" },
    { "type": "header", "content": "t:general.style" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "default": "#F5F3EE" },
    { "type": "select", "id": "media_position", "label": "t:labels.media_position", "options": [{ "value": "left", "label": "t:options.position.left" }, { "value": "right", "label": "t:options.position.right" }], "default": "left" },
    { "type": "select", "id": "section_spacing", "label": "t:labels.section_spacing", "options": [{ "value": "compact", "label": "t:options.spacing.compact" }, { "value": "standard", "label": "t:options.spacing.standard" }, { "value": "spacious", "label": "t:options.spacing.spacious" }], "default": "standard" }
  ],
  "enabled_on": { "templates": ["index"] },
  "presets": [{ "name": "t:general.material_craft", "category": "Campaign & editorial" }]
}
{% endschema %}
