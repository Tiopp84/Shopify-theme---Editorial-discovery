{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<section class="password-page" aria-labelledby="PasswordTitle-{{ section.id }}">
  <div class="password-page__inner">
    <p class="password-page__eyebrow">{{ shop.name | escape }}</p>
    <h1 id="PasswordTitle-{{ section.id }}">{{ 'password.title' | t }}</h1>

    {% if shop.password_message != blank %}
      <div class="password-page__message rte">{{ shop.password_message }}</div>
    {% else %}
      <p class="password-page__message">{{ 'password.message' | t }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'password-page__form' %}
      {% if form.errors %}
        <div id="PasswordErrors-{{ section.id }}" class="password-page__errors" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="password-page__field">
        <label for="PasswordInput-{{ section.id }}">{{ 'password.password' | t }}</label>
        <input
          id="PasswordInput-{{ section.id }}"
          type="password"
          name="password"
          autocomplete="current-password"
          {% if form.errors %}aria-invalid="true" aria-describedby="PasswordErrors-{{ section.id }}"{% endif %}
          required
        >
      </div>

      <button type="submit">{{ 'password.enter' | t }}</button>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .password-page { display: grid; min-block-size: 100dvh; padding: clamp(2rem, 7vw, 6rem) var(--page-gutter); place-items: center; }
  .password-page__inner { inline-size: min(100%, 30rem); }
  .password-page__eyebrow { color: var(--color-foreground); font-size: .75rem; font-weight: 700; letter-spacing: .12em; margin: 0 0 var(--space-3); text-align: center; text-transform: uppercase; }
  .password-page h1 { font-family: var(--font-commerce); font-size: clamp(2.35rem, 6vw, 4.5rem); font-style: normal; font-weight: 500; letter-spacing: -.05em; line-height: .98; margin: 0; text-align: center; }
  .password-page__message { color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background)); line-height: 1.6; margin: var(--space-4) auto 0; max-inline-size: 28rem; text-align: center; }
  .password-page__message > :first-child { margin-block-start: 0; }
  .password-page__message > :last-child { margin-block-end: 0; }
  .password-page__form { display: grid; gap: var(--space-4); margin-block-start: var(--space-6); }
  .password-page__field { display: grid; gap: var(--space-2); }
  .password-page__field label { font-size: .875rem; font-weight: 600; }
  .password-page__form button { inline-size: 100%; }
  .password-page__errors { border-inline-start: .1875rem solid var(--color-status-error); color: var(--color-status-error-strong); font-size: .9375rem; line-height: 1.5; padding: var(--space-3); }
  .password-page__errors ul { margin: 0; padding-inline-start: 1.25rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [],
  "enabled_on": { "templates": ["password"] }
}
{% endschema %}
