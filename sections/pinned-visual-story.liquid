{% liquid
  assign has_chapters = false
  for block in section.blocks
    if block.settings.heading != blank or block.settings.text != blank
      assign has_chapters = true
      break
    endif
  endfor
%}

<section class="pinned-visual-story" data-home-reveal="pinned-visual-story" {% if section.settings.heading != blank %}aria-labelledby="PinnedVisualStoryHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <header class="pinned-visual-story__intro">
    {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 id="PinnedVisualStoryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
  </header>
  <div class="pinned-visual-story__layout">
    <div class="pinned-visual-story__media">
      {% if section.settings.image != blank %}
        {% render 'image', class: 'pinned-visual-story__image', image: section.settings.image, alt: section.settings.image.alt, width: 1800, widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 60rem) 50vw, 100vw' %}
      {% else %}
        <div class="pinned-visual-story__placeholder" aria-hidden="true">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>
    {% if has_chapters %}
      <div class="pinned-visual-story__chapters">
        {% for block in section.blocks %}
          {% if block.settings.heading != blank or block.settings.text != blank %}
            <article class="pinned-visual-story__chapter" data-home-reveal-chapter {{ block.shopify_attributes }}>
              <p class="pinned-visual-story__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
              {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
              {% if block.settings.text != blank %}<div class="pinned-visual-story__body">{{ block.settings.text }}</div>{% endif %}
              {% if block.settings.link_label != blank and block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .pinned-visual-story { background: var(--color-panel-01); border-block: 1px solid var(--color-border); margin-block-end: var(--space-chapter); padding: clamp(4rem, 7vw, 7rem) max(var(--page-margin), calc((100vw - var(--page-width)) / 2)); }
  .pinned-visual-story__intro { margin-block-end: clamp(2.5rem, 5vw, 5rem); max-width: 35rem; }
  .pinned-visual-story__intro p, .pinned-visual-story__number { font-size: .6875rem; font-weight: 600; letter-spacing: .1em; margin: 0 0 var(--space-3); text-transform: uppercase; }
  .pinned-visual-story__intro h2 { font-family: var(--font-campaign); font-size: clamp(2.4rem, 4.7vw, 5rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.04em; line-height: .94; margin: 0; }
  .pinned-visual-story__layout { display: grid; gap: clamp(2.5rem, 7vw, 8rem); }
  .pinned-visual-story__media { aspect-ratio: 4 / 5; background: var(--color-panel-02); overflow: hidden; }
  .pinned-visual-story__image, .pinned-visual-story__image > img, .pinned-visual-story__placeholder, .pinned-visual-story__placeholder > svg { block-size: 100%; display: block; height: 100%; inline-size: 100%; object-fit: cover; width: 100%; }
  .pinned-visual-story__chapters { display: grid; }
  .pinned-visual-story__chapter { align-content: center; border-block-start: 1px solid var(--color-border); display: grid; gap: var(--space-3); min-height: clamp(24rem, 52vh, 38rem); padding-block: var(--space-6); }
  .pinned-visual-story__chapter h3 { font-family: var(--font-campaign); font-size: clamp(2rem, 3.6vw, 3.8rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.035em; line-height: .98; margin: 0; max-width: 12ch; }
  .pinned-visual-story__body { color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background)); font-size: .9375rem; line-height: 1.65; max-width: 29rem; }
  .pinned-visual-story__body > :first-child { margin-block-start: 0; }
  .pinned-visual-story__body > :last-child { margin-block-end: 0; }
  .pinned-visual-story__chapter a { color: currentcolor; font-size: .6875rem; font-weight: 600; letter-spacing: .08em; justify-self: start; text-decoration: underline; text-underline-offset: .25em; text-transform: uppercase; }
  .pinned-visual-story__chapter a:is(:hover, :focus-visible) { color: var(--color-accent); }
  @media (min-width: 60rem) {
    .pinned-visual-story__layout { align-items: start; grid-template-columns: minmax(0, 1fr) minmax(18rem, .72fr); }
    .pinned-visual-story__media { position: sticky; top: 6rem; }
  }
  @media (max-width: 59.99rem) {
    .pinned-visual-story { margin-block-end: var(--space-chapter-mobile); padding-block: var(--space-6); }
    .pinned-visual-story__intro { margin-block-end: var(--space-5); }
    .pinned-visual-story__media { aspect-ratio: 4 / 5; }
    .pinned-visual-story__layout { gap: var(--space-5); }
    .pinned-visual-story__chapter { min-height: 0; padding-block: var(--space-5); }
    .pinned-visual-story__chapter h3 { font-size: 2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.pinned_visual_story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "The approach" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Built around the way a day moves" },
    { "type": "image_picker", "id": "image", "label": "t:labels.story_image" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "t:general.story_chapter",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Made for movement" },
        { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Quiet proportions and useful details keep the wardrobe considered from the first appointment to the last plan.</p>" },
        { "type": "text", "id": "link_label", "label": "t:labels.link_label" },
        { "type": "url", "id": "link", "label": "t:labels.link" }
      ]
    }
  ],
  "presets": [{ "name": "t:general.pinned_visual_story", "blocks": [{ "type": "chapter" }, { "type": "chapter" }, { "type": "chapter" }] }]
}
{% endschema %}
