{% liquid
  assign has_products = false
  for block in section.blocks
    if block.settings.product != blank
      assign has_products = true
      break
    endif
  endfor
%}

<section class="outfit-composition full-width outfit-composition--media-{{ section.settings.media_position }} outfit-composition--columns-{{ section.settings.desktop_columns }} outfit-composition--spacing-{{ section.settings.section_spacing }}" data-aos-section style="--outfit-background: {{ section.settings.background_color }}; --outfit-foreground: {{ section.settings.text_color }};" {% if section.settings.heading != blank %}aria-labelledby="OutfitCompositionHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="outfit-composition__lead{% if section.settings.image == blank %} outfit-composition__lead--text-only{% endif %}">
    <div class="outfit-composition__content" data-aos="fade-right">
      {% if section.settings.eyebrow != blank %}
        <p class="outfit-composition__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 id="OutfitCompositionHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="outfit-composition__body rte">{{ section.settings.body }}</div>
      {% endif %}
    </div>
    {% if section.settings.image != blank %}
      <div class="outfit-composition__media" data-aos="fade-left" data-aos-delay="100">
        {% render 'image',
          class: 'outfit-composition__image',
          image: section.settings.image,
          alt: section.settings.image.alt,
          width: 1800,
          widths: '480, 720, 960, 1200, 1500, 1800',
          sizes: '(min-width: 64rem) 50vw, 100vw'
        %}
      </div>
    {% endif %}
  </div>

  {% if has_products %}
    <ul class="outfit-composition__items curated-grid--center-incomplete" role="list">
      {% for block in section.blocks %}
        {% if block.settings.product != blank %}
          <li data-aos-product-item data-aos="fade-up" data-aos-delay="{{ forloop.index0 | at_most: 3 | times: 100 }}" {{ block.shopify_attributes }}>
            {% render 'product-card', product: block.settings.product, card_context: 'homepage', image_ratio: '4 / 5', sizes: '(min-width: 64rem) 22vw, (min-width: 48rem) 42vw, 88vw' %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}
</section>

{% stylesheet %}
  .outfit-composition { display: grid; gap: var(--space-5); margin: 0 0 var(--space-chapter); }
  .outfit-composition--spacing-compact { margin-block-end: var(--space-6); }
  .outfit-composition--spacing-spacious { margin-block-end: calc(var(--space-chapter) + var(--space-5)); }
  .outfit-composition__lead { background: var(--outfit-background, var(--color-foreground)); color: var(--outfit-foreground, var(--color-background)); display: grid; gap: var(--space-6); min-width: 0; padding: clamp(2rem, 5vw, 4rem) max(var(--page-margin), calc((100vw - var(--page-width)) / 2)); }
  .outfit-composition__lead--text-only { max-width: 42rem; }
  .outfit-composition__content { align-content: center; display: grid; gap: var(--space-4); min-width: 0; }
  .outfit-composition__eyebrow { font-size: .6875rem; font-weight: 600; letter-spacing: .1em; margin: 0; text-transform: uppercase; }
  .outfit-composition h2 { font-family: var(--font-campaign); font-size: clamp(2.4rem, 4.5vw, 4.7rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.035em; line-height: .95; margin: 0; overflow-wrap: anywhere; }
  .outfit-composition__body { color: color-mix(in srgb, var(--color-background) 76%, transparent); font-size: .9375rem; line-height: 1.55; max-width: 30rem; }
  .outfit-composition__body > :first-child { margin-block-start: 0; }
  .outfit-composition__body > :last-child { margin-block-end: 0; }
  .outfit-composition__media { aspect-ratio: 4 / 3; background: color-mix(in srgb, var(--color-background) 18%, var(--color-foreground)); overflow: hidden; position: relative; }
  .outfit-composition .outfit-composition__image, .outfit-composition .outfit-composition__image > img { block-size: 100%; height: 100%; inline-size: 100%; object-fit: cover; width: 100%; }
  .outfit-composition .outfit-composition__image { inset: 0; position: absolute; }
  .outfit-composition__items { display: grid; gap: var(--space-3); list-style: none; margin: 0 max(var(--page-margin), calc((100vw - var(--page-width)) / 2)); padding: 0; }
  .outfit-composition__items > li { min-width: 0; }
  .outfit-composition .product-card { gap: var(--space-3); }
  .outfit-composition .product-card__media { border: 1px solid var(--color-border); }
  .outfit-composition .product-card__content { border-block-start: 1px solid var(--color-border); padding-block-start: var(--space-2); }
  .outfit-composition .product-card__meta { display: none; }
  .outfit-composition .product-card__title { font-size: .75rem; font-weight: 600; letter-spacing: .01em; line-height: 1.25; margin: 0; text-transform: uppercase; }
  .outfit-composition .product-card__price { font-size: .8125rem; }
  @media (min-width: 48rem) {
    .outfit-composition__lead { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); }
    .outfit-composition__lead--text-only { grid-template-columns: 1fr; }
    .outfit-composition__items { display: flex; flex-wrap: wrap; justify-content: center; }
    .outfit-composition__items > li { flex: 0 0 calc((100% - var(--space-3)) / 2); }
    .outfit-composition--media-left .outfit-composition__lead { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    .outfit-composition--media-left .outfit-composition__media { grid-column: 1; grid-row: 1; }
    .outfit-composition--media-left .outfit-composition__content { grid-column: 2; }
  }
  @media (min-width: 64rem) {
    .outfit-composition--columns-3 .outfit-composition__items > li { flex-basis: calc((100% - var(--space-3) - var(--space-3)) / 3); }
    .outfit-composition--columns-4 .outfit-composition__items > li { flex-basis: calc((100% - var(--space-3) - var(--space-3) - var(--space-3)) / 4); }
  }
  @media (max-width: 35rem) {
    .outfit-composition { gap: 0; margin-block-end: var(--space-chapter-mobile); }
    .outfit-composition__lead { gap: var(--space-2); padding: var(--space-5) var(--page-margin); }
    .outfit-composition__eyebrow { display: none; }
    .outfit-composition h2 { font-family: var(--font-primary--family); font-size: 1.25rem; font-style: normal; font-weight: 500; letter-spacing: -.015em; }
    .outfit-composition__body { font-size: .625rem; max-width: none; }
    .outfit-composition__media { aspect-ratio: 16 / 9; margin-block-start: var(--space-3); }
    .outfit-composition__items { gap: var(--space-3); margin: 0; padding: var(--space-5) var(--page-margin); }
    .outfit-composition__items > li { flex: 0 0 calc((100% - var(--space-3)) / 2); }
    .outfit-composition .product-card__decision { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
    .outfit-composition .product-card__title { font-size: .55rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .outfit-composition .product-card__price { font-size: .6875rem; justify-content: flex-start; text-align: start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.outfit_composition",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "The composition" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "A look, considered piece by piece" },
    { "type": "richtext", "id": "body", "label": "t:labels.text", "default": "<p>Every item has its own product decision. This composition does not imply a bundle or shared offer.</p>" },
    { "type": "image_picker", "id": "image", "label": "t:labels.look_image" },
    { "type": "header", "content": "t:general.style" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "default": "#242119" },
    { "type": "color", "id": "text_color", "label": "t:labels.text_color", "default": "#F5F3EE" },
    { "type": "select", "id": "media_position", "label": "t:labels.media_position", "options": [{ "value": "left", "label": "t:options.position.left" }, { "value": "right", "label": "t:options.position.right" }], "default": "right" },
    { "type": "select", "id": "desktop_columns", "label": "t:labels.desktop_product_columns", "options": [{ "value": "3", "label": "t:options.columns.three" }, { "value": "4", "label": "t:options.columns.four" }], "default": "4" },
    { "type": "select", "id": "section_spacing", "label": "t:labels.section_spacing", "options": [{ "value": "compact", "label": "t:options.spacing.compact" }, { "value": "standard", "label": "t:options.spacing.standard" }, { "value": "spacious", "label": "t:options.spacing.spacious" }], "default": "standard" }
  ],
  "blocks": [
    {
      "type": "outfit_item",
      "name": "t:general.outfit_item",
      "settings": [
        { "type": "product", "id": "product", "label": "t:labels.product" }
      ]
    }
  ],
  "enabled_on": { "templates": ["index"] },
  "presets": [{ "name": "t:general.outfit_composition" }]
}
{% endschema %}
