{% if section.blocks.size > 0 %}
  {% # theme-check-disable ValidScopedCSSClass %}
  {% assign scroll_speed = section.settings.speed | default: 8 %}
  {% assign scroll_direction = section.settings.direction | default: 'left' %}
  <section
    class="scrolling-text full-width scrolling-text--speed-{{ scroll_speed }} scrolling-text--direction-{{ scroll_direction }}"
    aria-label="{{ 'accessibility.scrolling_text' | t }}"
    style="--scrolling-text-background: {{ section.settings.background_color }}; --scrolling-text-color: {{ section.settings.text_color }}; --scrolling-text-height: {{ section.settings.height }}px; --scrolling-text-gap: {{ section.settings.message_spacing }}px; --scrolling-text-font-size: {{ section.settings.text_size }}px;"
    {{ section.shopify_attributes }}
  >
    <announcement-bar-marquee class="scrolling-text__viewport">
      <div class="scrolling-text__track announcement-bar__marquee-track">
        <div class="scrolling-text__group" data-announcement-marquee-group>
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              {% if block.settings.link != blank %}
                <a class="scrolling-text__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</a>
              {% else %}
                <span class="scrolling-text__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
              {% endif %}
              {% unless forloop.last %}<span class="scrolling-text__separator" aria-hidden="true">✦</span>{% endunless %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </announcement-bar-marquee>
  </section>
  {% # theme-check-enable ValidScopedCSSClass %}
{% endif %}

{% stylesheet %}
  .scrolling-text { align-items: center; background: var(--scrolling-text-background); color: var(--scrolling-text-color); display: flex; inline-size: 100%; min-block-size: var(--scrolling-text-height); overflow: hidden; width: 100%; }
  .scrolling-text__viewport { display: block; inline-size: 100%; overflow: hidden; width: 100%; }
  .scrolling-text__track { display: flex; inline-size: max-content; will-change: transform; }
  .scrolling-text__track.is-ready { animation: scrolling-text-scroll var(--scrolling-text-duration, 12s) linear infinite; }
  .scrolling-text--direction-right .scrolling-text__track.is-ready { animation-name: scrolling-text-scroll-right; }
  .scrolling-text__group { align-items: center; display: flex; flex: 0 0 auto; gap: var(--scrolling-text-gap); inline-size: max-content; padding-inline-end: var(--scrolling-text-gap); }
  .scrolling-text__group::after { content: '✦'; flex: 0 0 auto; font-size: .72em; line-height: 1; }
  .scrolling-text__item { color: inherit; font-family: var(--font-campaign); font-size: var(--scrolling-text-font-size, clamp(1.5rem, 3vw, 3rem)); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.035em; line-height: 1; text-decoration: none; white-space: nowrap; }
  .scrolling-text a.scrolling-text__item:focus-visible { outline: .125rem solid currentColor; outline-offset: .25rem; }
  .scrolling-text__separator { flex: 0 0 auto; font-size: .72em; line-height: 1; }

  .scrolling-text--speed-1 { --scrolling-text-duration: 36s; }
  .scrolling-text--speed-2 { --scrolling-text-duration: 32s; }
  .scrolling-text--speed-3 { --scrolling-text-duration: 28s; }
  .scrolling-text--speed-4 { --scrolling-text-duration: 24s; }
  .scrolling-text--speed-5 { --scrolling-text-duration: 20s; }
  .scrolling-text--speed-6 { --scrolling-text-duration: 17s; }
  .scrolling-text--speed-7 { --scrolling-text-duration: 14s; }
  .scrolling-text--speed-8 { --scrolling-text-duration: 12s; }
  .scrolling-text--speed-9 { --scrolling-text-duration: 10s; }
  .scrolling-text--speed-10 { --scrolling-text-duration: 8s; }
  .scrolling-text--speed-11 { --scrolling-text-duration: 7s; }
  .scrolling-text--speed-12 { --scrolling-text-duration: 6s; }
  .scrolling-text--speed-13 { --scrolling-text-duration: 5.5s; }
  .scrolling-text--speed-14 { --scrolling-text-duration: 5s; }
  .scrolling-text--speed-15 { --scrolling-text-duration: 4.5s; }
  .scrolling-text--speed-16 { --scrolling-text-duration: 4s; }
  .scrolling-text--speed-17 { --scrolling-text-duration: 3.5s; }
  .scrolling-text--speed-18 { --scrolling-text-duration: 3s; }
  .scrolling-text--speed-19 { --scrolling-text-duration: 2.5s; }
  .scrolling-text--speed-20 { --scrolling-text-duration: 2s; }

  .scrolling-text:is(:hover, :focus-within) .scrolling-text__track { animation-play-state: paused; }

  @keyframes scrolling-text-scroll { from { transform: translateX(0); } to { transform: translateX(calc(var(--announcement-marquee-distance) * -1)); } }
  @keyframes scrolling-text-scroll-right { from { transform: translateX(calc(var(--announcement-marquee-distance) * -1)); } to { transform: translateX(0); } }

  @media (prefers-reduced-motion: reduce) {
    .scrolling-text__track { animation: none; inline-size: 100%; }
    .scrolling-text__group { inline-size: 100%; justify-content: center; padding-inline-end: 0; }
    .scrolling-text__group > :not(:first-child) { display: none; }
    .scrolling-text__group[data-announcement-marquee-copy] { display: none; }
    .scrolling-text__group::after { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.scrolling_text",
  "settings": [
    { "type": "header", "content": "t:general.layout" },
    { "type": "range", "id": "message_spacing", "label": "t:labels.message_spacing", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "header", "content": "t:general.motion" },
    { "type": "select", "id": "direction", "label": "t:labels.scroll_direction", "options": [{ "value": "left", "label": "t:options.position.left" }, { "value": "right", "label": "t:options.position.right" }], "default": "left" },
    { "type": "range", "id": "speed", "label": "t:labels.marquee_speed", "min": 1, "max": 20, "step": 1, "default": 8 },
    { "type": "header", "content": "t:general.style" },
    { "type": "range", "id": "height", "label": "t:labels.bar_height", "min": 28, "max": 120, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "text_size", "label": "t:labels.text_size", "min": 14, "max": 64, "step": 2, "unit": "px", "default": 28 },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "default": "#1A1A1A" },
    { "type": "color", "id": "text_color", "label": "t:labels.text_color", "default": "#FAF8F5" }
  ],
  "blocks": [
    { "type": "message", "name": "t:general.scrolling_message", "settings": [{ "type": "text", "id": "text", "label": "t:labels.text", "default": "A note from the studio" }, { "type": "url", "id": "link", "label": "t:labels.link" }] }
  ],
  "max_blocks": 6,
  "enabled_on": { "templates": ["index"] },
  "presets": [{ "name": "t:general.scrolling_text", "category": "Campaign & editorial", "blocks": [{ "type": "message" }, { "type": "message", "settings": { "text": "Discover the collection" } }] }]
}
{% endschema %}
