<section class="about-closing full-width" data-about-reveal{% if section.settings.heading != blank %} aria-labelledby="AboutClosingHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="about-closing__content">
    {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 id="AboutClosingHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.link_label != blank and section.settings.link != blank %}<a class="about-closing__action" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}
  </div>
</section>

{% stylesheet %}
  .about-closing { display: grid; justify-items: center; margin-block: var(--space-chapter); padding: clamp(4rem, 9vw, 9rem) var(--layout-gutter); text-align: center; }
  .about-closing__content { display: grid; gap: var(--space-4); justify-items: center; max-inline-size: 48rem; }
  .about-closing p { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; text-transform: uppercase; }
  .about-closing h2 { font-family: var(--font-campaign); font-size: clamp(2.8rem, 5.5vw, 5.8rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.045em; line-height: .93; margin: 0; }
  .about-closing .rte { color: color-mix(in srgb, var(--color-foreground) 76%, var(--color-background)); line-height: calc(var(--body-text-line-spacing) + .08); max-inline-size: 34rem; }
  .about-closing .rte > :first-child { margin-block-start: 0; }
  .about-closing .rte > :last-child { margin-block-end: 0; }
  .about-closing__action { align-items: center; background: var(--button-theme-background); border: var(--button-theme-border-width) solid var(--button-theme-background); border-radius: var(--button-theme-radius); color: var(--button-theme-color); display: inline-flex; font-family: var(--button-theme-font); font-size: var(--button-theme-font-size); font-weight: 600; justify-self: center; letter-spacing: var(--button-theme-letter-spacing); line-height: 1.2; min-block-size: var(--button-theme-height); padding-inline: var(--button-theme-padding-inline); text-decoration: none; text-transform: uppercase; }
  .about-closing__action:is(:hover, :focus-visible) { background: var(--button-theme-hover-background); }
  @media (prefers-reduced-motion: no-preference) { .about-closing--motion-enabled.is-revealed .about-closing__content { animation: about-closing-in 680ms cubic-bezier(.22, 1, .36, 1) both; } @keyframes about-closing-in { from { opacity: 0; transform: translate3d(0, 2.75rem, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } } }
  @media (max-width: 63.99rem) { .about-closing { margin-block: var(--space-chapter-mobile); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_closing",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "header", "content": "t:general.content" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Made to be lived in" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Find the pieces that stay with you." },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Explore the latest collection and build a wardrobe on your own terms.</p>" },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "t:labels.link" }
  ],
  "presets": [{ "name": "t:general.about_closing", "category": "Content" }]
}
{% endschema %}
