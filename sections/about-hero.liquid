<section class="about-hero full-width" data-about-hero data-autoplay="{{ section.settings.enable_autoplay }}" data-autoplay-delay="{{ section.settings.autoplay_speed | times: 1000 }}" style="--about-hero-desktop-height: {{ section.settings.desktop_height }}vh; --about-hero-mobile-height: {{ section.settings.mobile_height }}vh; --about-hero-text-color: {{ section.settings.text_color }};" aria-roledescription="carousel" aria-label="{{ 'accessibility.about_hero' | t }}" {{ section.shopify_attributes }}>
  <div class="about-hero__slides">
    {% for block in section.blocks %}
      {% assign heading_id = 'AboutHeroHeading-' | append: section.id | append: '-' | append: block.id %}
      {% assign text_protection_alpha = block.settings.text_protection | times: 0.01 %}
      {% assign desktop_image_position = block.settings.image.presentation.focal_point | default: '50% 50%' %}
      {% assign mobile_image_position = block.settings.mobile_image.presentation.focal_point | default: desktop_image_position %}
      <article class="about-hero__slide about-hero__slide--position-{{ block.settings.content_position }}{% if forloop.first %} is-active{% endif %}" data-about-hero-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" style="--about-hero-text-protection: {{ text_protection_alpha }}; --about-hero-desktop-image-position: {{ desktop_image_position }}; --about-hero-mobile-image-position: {{ mobile_image_position }};" {{ block.shopify_attributes }}>
        <div class="about-hero__media" data-about-hero-media>
          {% if block.settings.image != blank %}
            <picture>
              {% if block.settings.mobile_image != blank %}<source media="(max-width: 47.99rem)" srcset="{{ block.settings.mobile_image | image_url: width: 960 }}">{% endif %}
              {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'about-hero__image', loading: 'eager', widths: '480, 720, 960, 1200, 1600, 2000, 2400', sizes: '100vw' }}
            </picture>
          {% else %}
            <span class="about-hero__placeholder" aria-hidden="true">{{ 'lifestyle-1' | placeholder_svg_tag }}</span>
          {% endif %}
        </div>
        <div class="about-hero__scrim" aria-hidden="true"></div>
        <div class="about-hero__content" data-about-hero-content>
          {% if block.settings.eyebrow != blank %}<p class="about-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
          {% if block.settings.heading != blank %}
            {% if forloop.first %}<h1 id="{{ heading_id }}">{{ block.settings.heading | escape }}</h1>{% else %}<h2 id="{{ heading_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
          {% endif %}
          {% if block.settings.text != blank %}<div class="about-hero__text rte">{{ block.settings.text }}</div>{% endif %}
        </div>
      </article>
    {% else %}
      <article class="about-hero__slide about-hero__slide--position-center_center about-hero__slide--text-center is-active" data-about-hero-slide aria-hidden="false">
        <div class="about-hero__media"><span class="about-hero__placeholder" aria-hidden="true">{{ 'lifestyle-1' | placeholder_svg_tag }}</span></div>
        <div class="about-hero__scrim" aria-hidden="true"></div>
        <div class="about-hero__content" data-about-hero-content><p class="about-hero__eyebrow">{{ 'accessibility.about_hero' | t }}</p><h1>{{ 'accessibility.about_hero' | t }}</h1></div>
      </article>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="about-hero__controls">
      <button class="about-hero__control" type="button" data-about-hero-previous aria-label="{{ 'pagination.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
      <p class="about-hero__count" aria-live="polite"><span data-about-hero-current>1</span><span aria-hidden="true"> / </span>{{ section.blocks.size }}</p>
      <button class="about-hero__control" type="button" data-about-hero-next aria-label="{{ 'pagination.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .about-hero { background: var(--color-panel-02); block-size: var(--about-hero-desktop-height); color: var(--about-hero-text-color); isolation: isolate; overflow: clip; position: relative; }
  .about-hero__slides { block-size: 100%; position: relative; touch-action: pan-y; }
  .about-hero__slide { display: block; inset: 0; opacity: 0; pointer-events: none; position: absolute; transition: opacity 380ms ease; }
  .about-hero__slide.is-active { opacity: 1; pointer-events: auto; z-index: 1; }
  .about-hero__slide.is-drag-preview { pointer-events: none; z-index: 4; }
  .about-hero__media, .about-hero__scrim, .about-hero__content { inset: 0; position: absolute; }
  .about-hero__media { background: var(--color-panel-02); overflow: hidden; }
  .about-hero__media picture, .about-hero__image, .about-hero__placeholder, .about-hero__placeholder svg { block-size: 100%; display: block; inline-size: 100%; }
  .about-hero__image { object-fit: cover; object-position: var(--about-hero-desktop-image-position); }
  .about-hero__placeholder { color: color-mix(in srgb, var(--color-foreground) 26%, var(--color-panel-02)); }
  .about-hero__scrim { background: #000; opacity: var(--about-hero-text-protection); pointer-events: none; }
  .about-hero__content { align-content: center; block-size: 100%; box-sizing: border-box; color: var(--about-hero-text-color); display: grid; gap: clamp(.8rem, 1.5vw, 1.25rem); justify-items: center; min-block-size: 0; padding: clamp(2rem, 5vw, 5rem) max(var(--layout-gutter), calc((100vw - var(--layout-content-max)) / 2)); position: relative; text-align: center; z-index: 1; }
  .about-hero__slide--position-top_left .about-hero__content { align-content: start; justify-items: start; text-align: start; }
  .about-hero__slide--position-center_left .about-hero__content { align-content: center; justify-items: start; text-align: start; }
  .about-hero__slide--position-bottom_left .about-hero__content { align-content: end; justify-items: start; text-align: start; }
  .about-hero__slide--position-top_center .about-hero__content { align-content: start; justify-items: center; text-align: center; }
  .about-hero__slide--position-center_center .about-hero__content { align-content: center; justify-items: center; text-align: center; }
  .about-hero__slide--position-bottom_center .about-hero__content { align-content: end; justify-items: center; text-align: center; }
  .about-hero__slide--position-top_right .about-hero__content { align-content: start; justify-items: end; text-align: end; }
  .about-hero__slide--position-center_right .about-hero__content { align-content: center; justify-items: end; text-align: end; }
  .about-hero__slide--position-bottom_right .about-hero__content { align-content: end; justify-items: end; text-align: end; }
  .about-hero__eyebrow { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; text-transform: uppercase; }
  .about-hero h1, .about-hero h2 { font-family: var(--font-campaign); font-size: clamp(var(--heading-size-96), calc(var(--heading-size-96) + 4vw), var(--heading-size-192)); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: var(--heading-letter-spacing); line-height: var(--heading-line-height); margin: 0; max-inline-size: 13ch; overflow-wrap: anywhere; }
  .about-hero__text { color: color-mix(in srgb, var(--about-hero-text-color) 84%, transparent); font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: calc(var(--body-text-line-spacing) + .06); max-inline-size: 34rem; }
  .about-hero__text > :first-child { margin-block-start: 0; }
  .about-hero__text > :last-child { margin-block-end: 0; }
  .about-hero__controls { align-items: center; backdrop-filter: blur(12px); background: color-mix(in srgb, #111 38%, transparent); border: 1px solid color-mix(in srgb, currentcolor 45%, transparent); bottom: clamp(1.25rem, 2.6vw, 2.5rem); color: var(--color-background); display: flex; gap: 0; inset-inline-end: max(var(--layout-gutter), calc((100vw - var(--layout-content-max)) / 2)); isolation: isolate; padding: .25rem; position: absolute; z-index: 10; }
  .about-hero__control { align-items: center; background: transparent; border: 0; color: inherit; display: inline-flex; inline-size: 2.75rem; justify-content: center; min-block-size: 2.75rem; padding: 0; transition: background-color 180ms ease, color 180ms ease; }
  .about-hero__control:is(:hover, :focus-visible) { background: var(--color-background); color: var(--color-foreground); outline: 0; }
  .about-hero__control:focus-visible { box-shadow: inset 0 0 0 2px var(--color-foreground); }
  .about-hero__control .icon { block-size: .9rem; inline-size: .9rem; }
  .about-hero__count { font-family: var(--small-label-font); font-size: var(--small-label-size); letter-spacing: var(--small-label-letter-spacing); margin: 0; min-inline-size: 3.25rem; text-align: center; }
  @media (prefers-reduced-motion: no-preference) { .about-hero__slide.is-leaving { animation-duration: 520ms; animation-fill-mode: both; animation-timing-function: cubic-bezier(.4, 0, .2, 1); z-index: 2; } .about-hero__slide.is-leaving.is-next { animation-name: about-hero-slide-exit-next; } .about-hero__slide.is-leaving.is-previous { animation-name: about-hero-slide-exit-previous; } .about-hero__slide.is-entering { z-index: 3; } .about-hero--motion-enabled.is-revealed .about-hero__slide.is-entering .about-hero__media { animation: about-hero-media-enter 760ms cubic-bezier(.22, 1, .36, 1) both; } .about-hero--motion-enabled.is-revealed .about-hero__slide.is-entering .about-hero__content { animation: about-hero-content-enter 540ms cubic-bezier(.22, 1, .36, 1) 130ms both; } @keyframes about-hero-media-enter { from { opacity: 0; transform: translate3d(9%, 0, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } } @keyframes about-hero-content-enter { from { opacity: 0; transform: translate3d(0, 2.25rem, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } } @keyframes about-hero-slide-exit-next { from { opacity: 1; transform: translate3d(0, 0, 0); } to { opacity: 0; transform: translate3d(-4%, 0, 0); } } @keyframes about-hero-slide-exit-previous { from { opacity: 1; transform: translate3d(0, 0, 0); } to { opacity: 0; transform: translate3d(4%, 0, 0); } } }
  @media (max-width: 47.99rem) { .about-hero { block-size: var(--about-hero-mobile-height); } .about-hero h1, .about-hero h2 { font-size: clamp(var(--heading-size-86), calc(var(--heading-size-86) + 8vw), var(--heading-size-141)); } .about-hero__image { object-position: var(--about-hero-mobile-image-position); } .about-hero__controls { inset-inline-end: var(--layout-gutter); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_hero",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.about_slide",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "The studio" },
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Clothes for the rhythm of everyday." },
        { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Considered pieces for moving through the day with ease, character and intention.</p>" },
        { "type": "image_picker", "id": "image", "label": "t:labels.image" },
        { "type": "image_picker", "id": "mobile_image", "label": "t:labels.mobile_image" },
        { "type": "select", "id": "content_position", "label": "t:labels.content_position", "options": [{ "value": "top_left", "label": "t:options.content_position.top_left" }, { "value": "center_left", "label": "t:options.content_position.center_left" }, { "value": "bottom_left", "label": "t:options.content_position.bottom_left" }, { "value": "top_center", "label": "t:options.content_position.top_center" }, { "value": "center_center", "label": "t:options.content_position.center_center" }, { "value": "bottom_center", "label": "t:options.content_position.bottom_center" }, { "value": "top_right", "label": "t:options.content_position.top_right" }, { "value": "center_right", "label": "t:options.content_position.center_right" }, { "value": "bottom_right", "label": "t:options.content_position.bottom_right" }], "default": "center_center" },
        { "type": "range", "id": "text_protection", "label": "t:labels.about_text_protection", "info": "t:descriptions.about_text_protection", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 28 }
      ]
    }
  ],
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "header", "content": "t:general.layout" },
    { "type": "range", "id": "desktop_height", "label": "t:labels.hero_height_desktop", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 75 },
    { "type": "range", "id": "mobile_height", "label": "t:labels.hero_height_mobile", "min": 45, "max": 90, "step": 5, "unit": "vh", "default": 65 },
    { "type": "color", "id": "text_color", "label": "t:labels.text_color", "default": "#FFFFFF" },
    { "type": "header", "content": "t:general.motion" },
    { "type": "checkbox", "id": "enable_autoplay", "label": "t:labels.enable_autoplay", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "t:labels.autoplay_interval", "info": "t:descriptions.autoplay_interval", "min": 3, "max": 15, "step": 1, "unit": "s", "default": 7, "visible_if": "{{ section.settings.enable_autoplay }}" }
  ],
  "presets": [{
    "name": "t:general.about_hero",
    "category": "Content",
    "blocks": [
      {
        "type": "slide",
        "settings": {
          "eyebrow": "The studio",
          "heading": "A wardrobe for the rhythm of everyday.",
          "text": "<p>We begin with pieces that bring clarity to getting dressed: considered proportions, useful details and room to make them your own.</p>",
          "content_position": "center_left",
          "text_protection": 42
        }
      },
      {
        "type": "slide",
        "settings": {
          "eyebrow": "How we work",
          "heading": "Considered from line to finish.",
          "text": "<p>Texture, construction and proportion are resolved together, so every piece feels deliberate without asking for attention.</p>",
          "content_position": "center_right",
          "text_protection": 42
        }
      },
      {
        "type": "slide",
        "settings": {
          "eyebrow": "Made to return to",
          "heading": "Personal in the wearing.",
          "text": "<p>The collection is designed for repeat wear and new combinations, shaped as much by the person wearing it as by the original idea.</p>",
          "content_position": "bottom_left",
          "text_protection": 42
        }
      }
    ]
  }]
}
{% endschema %}
