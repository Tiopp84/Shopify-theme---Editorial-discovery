{% doc %}
  Renders a small, decorative interface icon. The parent control must provide its accessible name.

  @param {string} name - Supported icon name: account, cart, close, menu, or search.
  @param {string} [class] - Additional SVG class.

  @example
  {% render 'icon', name: 'cart' %}
{% enddoc %}

<svg
  class="icon icon--{{ name }} {{ class }}"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {% case name %}
    {% when 'account' %}
      <circle cx="12" cy="8" r="4" />
      <path d="M4.5 21a7.5 7.5 0 0 1 15 0" />
    {% when 'cart' %}
      <path d="M5 8h14l-1 13H6L5 8Z" />
      <path d="M9 8V6a3 3 0 0 1 6 0v2" />
    {% when 'close' %}
      <path d="m5 5 14 14M19 5 5 19" />
    {% when 'menu' %}
      <path d="M4 7h16M4 12h16M4 17h16" />
    {% when 'search' %}
      <circle cx="11" cy="11" r="6" />
      <path d="m16 16 4 4" />
  {% endcase %}
</svg>

{% stylesheet %}
  .icon {
    display: block;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }
{% endstylesheet %}
