    {% when 'tiktok' %}<path d="M14 3v10.2a3.8 3.8 0 1 1-3-3.7v2.3a1.5 1.5 0 1 0 1 1.4V3h2c.3 2.4 1.7 3.9 4 4.2v2.1c-1.6-.1-3-.7-4-1.6Z"/>
    {% when 'threads' %}<text x="12" y="17" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="700">@</text>
    {% when 'snapchat' %}<path d="M12 3c-2.8 0-4.8 1.8-4.8 4.5v3c-.4.3-1 .4-1.6.4.2.8.9 1.4 2.1 1.8-.4 1.7-1.5 3.3-3.3 3.7.8.6 2 .8 3.4.8.4 1.6 1.3 2.4 2.4 2.4h4c1.1 0 2-1 2.4-2.4 1.4 0 2.6-.2 3.4-.8-1.8-.4-2.9-2-3.3-3.7 1.2-.4 1.9-1 2.1-1.8-.6 0-1.2-.1-1.6-.4v-3C16.8 4.8 14.8 3 12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
