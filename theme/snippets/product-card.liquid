{% doc %}
  Renders a product destination card with stable media, price, and availability.

  @param {product} product - Product represented by the card.
  @param {string} [title] - Optional title override; defaults to the product title.
  @param {boolean} [show_vendor] - Show the product vendor above the title.
  @param {boolean} [show_badge] - Show sale and sold-out badges.
  @param {boolean} [show_index] - Show the card position within the current result set.
  @param {boolean} [index_above_media] - Render the existing product index above the media instead of in card metadata.
  @param {boolean} [show_price] - Show the product price.
  @param {boolean} [show_second_image] - Reveal the second product image on hover/focus when available.
  @param {boolean} [show_quick_add] - Show the variant-safe quick-add control where this context supports it.
  @param {string} [quick_add_label] - Optional merchant label for the Quick Add trigger.
  @param {boolean} [show_swatches] - Show Shopify-native swatches on collection cards.
  @param {boolean} [show_variant_options] - Show non-swatch variant options on collection cards.
  @param {string} [image_ratio] - CSS aspect ratio used by the media frame.
  @param {string} [image_fit] - CSS object-fit used by product media.
  @param {string} [sizes] - Responsive image sizes hint.
  @param {number} [card_index] - One-based position in the current result set.
  @param {number} [card_count] - Number of products in the current result set.
  @param {string} [card_context] - Presentation context; use `recommendation` for compact PDP suggestions or `homepage` to omit Quick Add.
  @param {number} [entrance_delay] - Optional initial page-load AOS delay in milliseconds.

  @example
  {% render 'product-card', product: product, show_vendor: true, image_ratio: '4 / 5' %}
{% enddoc %}

{% liquid
  assign image_ratio = image_ratio | default: '4 / 5'
  assign image_fit = image_fit | default: settings.product_card_media_fit | default: 'cover'
  assign show_vendor = show_vendor | default: settings.product_card_show_vendor, allow_false: true
  assign show_badge = show_badge | default: settings.product_card_show_badge, allow_false: true
  assign show_second_image = show_second_image | default: settings.product_card_show_second_image, allow_false: true
  assign card_context = card_context | default: 'standard'
  assign sizes = sizes | default: '(min-width: 60rem) 25vw, 50vw'
  assign card_id = 'ProductCard-' | append: product.id
  assign card_title = title | default: product.title
  if quick_add_label == blank
    assign quick_add_label = 'products.card.quick_add' | t
  endif
  assign formatted_index = card_index | prepend: '0' | slice: -2, 2
  assign formatted_count = card_count | prepend: '0' | slice: -2, 2
  assign on_sale = false
  assign available_variant_count = 0
  assign quick_add_variant = null
  assign secondary_image = product.images[1]
  if product.compare_at_price_max > product.price
    assign on_sale = true
  endif
  for variant in product.variants
    if variant.available
      assign available_variant_count = available_variant_count | plus: 1
      assign quick_add_variant = variant
    endif
  endfor
%}

<article class="product-card product-card--{{ card_context }}{% unless product.available %} product-card--unavailable{% endunless %}" data-product-id="{{ product.id }}"{% if entrance_delay != blank %} data-catalog-reveal data-aos="fade-up" data-aos-delay="{{ entrance_delay }}"{% endif %} aria-labelledby="{{ card_id }}">
  {% if index_above_media and show_index != false and card_index %}
    <p class="product-card__index product-card__index--above-media">{{ formatted_index }}{% if card_count %} / {{ formatted_count }}{% endif %}</p>
  {% endif %}
  <div class="product-card__media" style="--product-card-ratio: {{ image_ratio }}; --product-card-image-fit: {{ image_fit }};">
    {% if product.featured_image %}
      {% render 'image',
        class: 'product-card__image',
        image: product.featured_image,
        url: product.url,
        alt: product.featured_image.alt,
        width: 960,
        widths: '240, 360, 480, 640, 800, 960',
        sizes: sizes
      %}
      {% if show_second_image and secondary_image != blank %}
        {{ secondary_image | image_url: width: 960 | image_tag: class: 'product-card__secondary-image', alt: '', widths: '240, 360, 480, 640, 800, 960', sizes: sizes, loading: 'lazy' }}
      {% endif %}
    {% else %}
      <a class="product-card__placeholder" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
        {{ 'product-1' | placeholder_svg_tag }}
      </a>
    {% endif %}
    {% if show_badge != false and product.available == false %}
      <span class="product-card__status product-card__status--sold-out">{{ 'products.card.sold_out' | t }}</span>
    {% elsif show_badge != false and on_sale %}
      <span class="product-card__status product-card__status--sale">{{ 'products.card.sale' | t }}</span>
    {% endif %}
    {% if show_quick_add != false and product.available and card_context != 'recommendation' and card_context != 'homepage' %}
      <div class="product-card__quick-add-wrap">
        {% if available_variant_count == 1 %}
          <quick-add class="product-card__quick-add-shell" data-product-form data-quick-add-direct data-product-url="{{ product.url }}" data-variant-id="{{ quick_add_variant.id }}" data-error="{{ 'products.card.quick_add_error' | t }}">
            {% form 'product', product, class: 'product-card__quick-add-form' %}
              <input type="hidden" name="id" value="{{ quick_add_variant.id }}">
              <input type="hidden" name="quantity" value="{{ quick_add_variant.quantity_rule.min }}" data-quick-add-quantity>
              <p class="quick-add__error" data-quick-add-error role="alert" hidden></p>
              <button type="submit" class="product-card__quick-add">{{ quick_add_label | escape }}</button>
            {% endform %}
          </quick-add>
        {% else %}
          <quick-add class="product-card__quick-add-shell" data-product-form data-product-url="{{ product.url }}" data-unavailable="{{ 'products.form.unavailable_combination' | t }}" data-add-to-cart="{{ 'products.form.add_to_cart' | t }}" data-available="{{ 'products.form.available' | t }}" data-sold-out="{{ 'products.form.sold_out' | t }}" data-verifying="{{ 'products.card.verifying_availability' | t }}" data-error="{{ 'products.card.quick_add_error' | t }}">
            <button type="button" class="product-card__quick-add" data-quick-add-open aria-haspopup="dialog">{{ quick_add_label | escape }}</button>
            <dialog class="quick-add__dialog" aria-labelledby="QuickAddTitle-{{ product.id }}" data-quick-add-dialog data-overlay-motion="modal">
              <div class="quick-add__header">
                <div class="quick-add__header-copy">
                  <h2 id="QuickAddTitle-{{ product.id }}">{{ product.title | escape }}</h2>
                  <a class="quick-add__view-details quick-add__view-details--mobile" href="{{ product.url }}">{{ 'products.card.view_details' | t }}</a>
                </div>
                <button type="button" data-quick-add-close aria-label="{{ 'products.card.close_quick_add' | t }}">×</button>
              </div>
              <div class="quick-add__product">
                <div class="quick-add__media">
                  {% if product.media.size > 0 %}
                    <div class="quick-add__media-stage" data-quick-add-media-stage tabindex="0" aria-label="{{ 'products.gallery.media_selection' | t }}">
                      {% for media in product.media %}
                        <div class="quick-add__media-item" data-quick-add-media-id="{{ media.id }}"{% unless media.id == product.selected_or_first_available_variant.featured_media.id or forloop.first %} hidden{% endunless %}>
                          {% case media.media_type %}
                            {% when 'video' %}
                              {{ media | media_tag: image_size: '720x', loop: true, muted: true, controls: false, preload: 'metadata' }}
                            {% when 'external_video' %}
                              {{ media | external_video_tag }}
                            {% else %}
                              {{ media.preview_image | image_url: width: 720 | image_tag: alt: media.alt, widths: '320, 480, 720', sizes: '(min-width: 750px) 18rem, 40vw', loading: 'lazy' }}
                          {% endcase %}
                        </div>
                      {% endfor %}
                      {% if product.media.size > 1 %}
                        <button class="quick-add__media-nav quick-add__media-nav--previous" type="button" data-quick-add-media-previous aria-label="{{ 'products.gallery.previous' | t }}">←</button>
                        <button class="quick-add__media-nav quick-add__media-nav--next" type="button" data-quick-add-media-next aria-label="{{ 'products.gallery.next' | t }}">→</button>
                      {% endif %}
                    </div>
                    {% for media in product.media %}
                      {% if media.media_type == 'video' %}
                        <div class="quick-add__video-controls" data-quick-add-video-controls="{{ media.id }}"{% unless media.id == product.selected_or_first_available_variant.featured_media.id or forloop.first %} hidden{% endunless %}>
                          <button type="button" data-quick-add-video-toggle aria-label="Pause video">Ⅱ</button>
                          <input type="range" min="0" max="100" value="0" step="0.1" data-quick-add-video-progress aria-label="Video progress">
                          <button type="button" data-quick-add-video-mute aria-label="Unmute video"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11 5 6 9H3v6h3l5 4V5Z M16 9l5 5m0-5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/></svg></button>
                        </div>
                      {% endif %}
                    {% endfor %}
                    {% if product.media.size > 1 %}
                      <div class="quick-add__media-thumbnails" aria-label="{{ 'products.gallery.media_selection' | t }}">
                        {% for media in product.media %}
                          <button type="button" data-quick-add-media-select="{{ media.id }}"{% if media.id == product.selected_or_first_available_variant.featured_media.id or forloop.first %} aria-current="true"{% endif %} aria-label="{{ 'products.gallery.select_media' | t: index: forloop.index }}">
                            {{ media.preview_image | image_url: width: 160 | image_tag: alt: media.alt, widths: '80, 160', sizes: '3.5rem', loading: 'lazy' }}
                          </button>
                        {% endfor %}
                      </div>
                    {% endif %}
                  {% else %}
                    <div class="quick-add__media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                  {% endif %}
                </div>
                <div class="quick-add__details">
                  {% if product.vendor != blank %}<p class="quick-add__vendor">{{ product.vendor | escape }}</p>{% endif %}
                  <div class="quick-add__price" data-quick-add-price>
                    <strong data-quick-add-price-current>{{ product.selected_or_first_available_variant.price | money }}</strong>
                    <s data-quick-add-price-compare{% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %} hidden{% endunless %}>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>
                    <small data-quick-add-unit-price{% unless product.selected_or_first_available_variant.unit_price_measurement %} hidden{% endunless %}>{% if product.selected_or_first_available_variant.unit_price_measurement %}{{ product.selected_or_first_available_variant.unit_price | money }} / {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}{% endif %}</small>
                  </div>
                  <p class="quick-add__sku" data-quick-add-sku{% if product.selected_or_first_available_variant.sku == blank %} hidden{% endif %}>{{ 'products.form.sku' | t }}: <span data-quick-add-sku-value>{{ product.selected_or_first_available_variant.sku | escape }}</span></p>
                  <p class="quick-add__availability" data-quick-add-availability data-state="{% if product.selected_or_first_available_variant.available %}available{% else %}sold-out{% endif %}">{% if product.selected_or_first_available_variant.available %}{{ 'products.form.available' | t }}{% else %}{{ 'products.form.sold_out' | t }}{% endif %}</p>
              {% form 'product', product, class: 'quick-add__form', data-quick-add-form: '' %}
                {% for option in product.options_with_values %}
                  {% assign option_name_downcase = option.name | downcase %}
                  {% assign is_color_option = false %}
                  {% if option_name_downcase == 'color' or option_name_downcase == 'colour' %}{% assign is_color_option = true %}{% endif %}
                  <p class="quick-add__option">
                    <label for="QuickAddOption-{{ product.id }}-{{ forloop.index0 }}">{{ option.name | escape }}{% if is_color_option %}: <span data-quick-add-option-selected="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span>{% endif %}</label>
                    <span class="quick-add__option-buttons" role="group" aria-label="{{ option.name | escape }}">
                      {% for value in option.values %}
                        {% assign swatch_value = null %}
                        {% if value.swatch.image %}
                          {% assign swatch_image_url = value.swatch.image | image_url: width: 96 %}
                          {% assign swatch_value = 'url(' | append: swatch_image_url | append: ')' %}
                        {% elsif value.swatch.color %}
                          {% assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')' %}
                        {% endif %}
                        <button class="quick-add__option-button{% if swatch_value %} quick-add__option-button--swatch{% endif %}" type="button" data-quick-add-option-button data-quick-add-option-index="{{ forloop.parentloop.index0 }}" data-quick-add-option-value="{{ value.name | escape }}" aria-pressed="{{ value.selected }}"{% if swatch_value %} style="--quick-add-swatch-background: {{ swatch_value }};"{% endif %}>{{ value.name | escape }}</button>
                      {% endfor %}
                    </span>
                    <select class="quick-add__option-select" id="QuickAddOption-{{ product.id }}-{{ forloop.index0 }}" data-quick-add-option="{{ forloop.index0 }}">
                      {% for value in option.values %}<option value="{{ value.name | escape }}" {% if value.selected %}selected{% endif %}>{{ value.name | escape }}</option>{% endfor %}
                    </select>
                  </p>
                {% endfor %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-quick-add-variant-id>
                <p class="quick-add__quantity">
                  <label for="QuickAddQuantity-{{ product.id }}">{{ 'products.form.quantity' | t }}</label>
                  <span class="quick-add__quantity-control">
                    <button type="button" data-quick-add-quantity-decrease aria-label="{{ 'products.form.decrease_quantity' | t }}">−</button>
                    <input id="QuickAddQuantity-{{ product.id }}" type="number" name="quantity" value="{{ product.selected_or_first_available_variant.quantity_rule.min }}" min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"{% if product.selected_or_first_available_variant.quantity_rule.max %} max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"{% endif %} step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}" data-quick-add-quantity>
                    <button type="button" data-quick-add-quantity-increase aria-label="{{ 'products.form.increase_quantity' | t }}">+</button>
                  </span>
                </p>
                <p class="quick-add__quantity-note" data-quick-add-quantity-note hidden>{{ 'products.form.quantity_pricing_available' | t }}</p>
                <p class="quick-add__error" data-quick-add-error role="alert" hidden></p>
                <button type="submit" data-quick-add-submit>{{ 'products.form.add_to_cart' | t }}</button>
                <a class="quick-add__view-details quick-add__view-details--desktop" href="{{ product.url }}">{{ 'products.card.view_details' | t }}</a>
              {% endform %}
                </div>
              </div>
              <script type="application/json" data-quick-add-variants>
                [{% for variant in product.variants %}{% capture unit_price %}{% if variant.unit_price_measurement %}{{ variant.unit_price | money }} / {{ variant.unit_price_measurement.reference_unit }}{% endif %}{% endcapture %}{% assign variant_on_sale = false %}{% if variant.compare_at_price > variant.price %}{% assign variant_on_sale = true %}{% endif %}{"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | money | json }},"comparePrice":{{ variant.compare_at_price | money | json }},"onSale":{{ variant_on_sale | json }},"unitPrice":{{ unit_price | strip | json }},"sku":{{ variant.sku | json }},"featuredMediaId":{% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %},"quantityRule":{{ variant.quantity_rule | json }},"hasQuantityPriceBreaks":{{ variant.quantity_price_breaks.size | at_least: 1 | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
              </script>
            </dialog>
          </quick-add>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="product-card__content">
    {% if show_index != false and card_index or show_vendor and product.vendor != blank %}
      <div class="product-card__meta">
        {% if index_above_media != true and show_index != false and card_index %}
          <span class="product-card__index">{{ formatted_index }}{% if card_count %} / {{ formatted_count }}{% endif %}</span>
        {% endif %}
        {% if show_vendor and product.vendor != blank %}
          <span class="product-card__vendor">{{ product.vendor | escape }}</span>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-card__decision">
      <h2 id="{{ card_id }}" class="product-card__title">
        <a href="{{ product.url }}">{{ card_title | escape }}</a>
      </h2>
      {% if show_price != false %}{% render 'price', item: product, class: 'product-card__price' %}{% endif %}
    </div>

    {% if show_swatches or show_variant_options %}
      <div class="product-card__options">
        {% for option in product.options_with_values %}
          {% assign has_swatch = false %}
          {% for value in option.values %}
            {% if value.swatch.image or value.swatch.color %}
              {% assign has_swatch = true %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% assign render_swatches = false %}
          {% if show_swatches and has_swatch %}
            {% assign render_swatches = true %}
          {% endif %}
          {% assign render_variants = false %}
          {% if show_variant_options and render_swatches == false %}
            {% assign render_variants = true %}
          {% endif %}
          {% if render_swatches or render_variants %}
            <div class="product-card__option{% if render_swatches %} product-card__option--swatches{% endif %}">
              <span class="visually-hidden">{{ option.name | escape }}</span>
              <div class="product-card__option-values">
                {% for value in option.values %}
                  {% assign matching_variant = blank %}
                  {% for variant in product.variants %}
                    {% case option.position %}
                      {% when 1 %}{% assign variant_option_value = variant.option1 %}
                      {% when 2 %}{% assign variant_option_value = variant.option2 %}
                      {% when 3 %}{% assign variant_option_value = variant.option3 %}
                    {% endcase %}
                    {% if variant_option_value == value.name %}
                      {% assign matching_variant = variant %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  {% if matching_variant != blank %}
                    {% if render_swatches %}
                      {% assign swatch_background = blank %}
                      {% if value.swatch.image %}
                        {% assign swatch_image_url = value.swatch.image | image_url: width: 96 %}
                        {% assign swatch_background = 'url(' | append: swatch_image_url | append: ')' %}
                      {% elsif value.swatch.color %}
                        {% assign swatch_background = 'rgb(' | append: value.swatch.color.rgb | append: ')' %}
                      {% endif %}
                      <a class="product-card__swatch{% if value.selected %} is-selected{% endif %}" href="{{ matching_variant.url }}" aria-label="{{ option.name | escape }}: {{ value.name | escape }}"{% if swatch_background != blank %} style="--product-card-swatch: {{ swatch_background }};"{% endif %}></a>
                    {% else %}
                      <a class="product-card__variant{% if value.selected %} is-selected{% endif %}" href="{{ matching_variant.url }}">{{ value.name | escape }}</a>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</article>

{% stylesheet %}
  .product-card {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .product-card__media {
    position: relative;
    aspect-ratio: var(--product-card-ratio);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-border) 30%, var(--color-background));
  }

  .product-card__image,
  .product-card__image > img,
  .product-card__placeholder,
  .product-card__placeholder > svg {
    width: 100%;
    height: 100%;
  }

  .product-card__image > img,
  .product-card__placeholder > svg {
    object-fit: var(--product-card-image-fit);
    transition: transform 300ms ease;
  }

  .product-card__secondary-image {
    block-size: 100%;
    inset: 0;
    object-fit: var(--product-card-image-fit);
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transition: opacity 220ms ease;
    inline-size: 100%;
  }

  .product-card__status {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-start: var(--space-3);
    padding: 0.35rem 0.55rem;
    background: var(--sale-badge-background);
    color: var(--sale-badge-color);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .product-card:focus-within .product-card__image > img {
    transform: scale(1.015);
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .product-card__image > img {
      transform: scale(1.015);
    }

    .product-card:hover .product-card__secondary-image { opacity: 1; }
  }

  .product-card:focus-within .product-card__secondary-image { opacity: 1; }

  .product-card__content {
    min-width: 0;
    display: grid;
    gap: 0.35rem;
  }

  .product-card__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: color-mix(in srgb, currentcolor 56%, transparent);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-card__index { color: var(--color-foreground); font-weight: 700; }
  .product-card__index--above-media { font-family: var(--small-label-font); font-size: var(--small-label-size); letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0 0 var(--space-3); }
  .product-card__vendor { margin-inline-start: auto; }

  .product-card__decision {
    min-width: 0;
    display: grid;
    gap: var(--space-2);
  }

  .product-card__title {
    font-family: var(--product-card-font);
    min-block-size: calc(var(--product-card-title-lines) * 1.25em);
    font-size: clamp(calc(var(--product-card-title-size) * .875), calc(var(--product-card-title-size) + .2vw), calc(var(--product-card-title-size) * 1.2));
    font-weight: var(--product-card-title-weight);
    letter-spacing: var(--product-card-title-letter-spacing);
    line-height: 1.25;
  }

  .product-card__title a {
    display: -webkit-box;
    overflow: hidden;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--product-card-title-lines);
    line-clamp: var(--product-card-title-lines);
  }

  .product-card__title a:hover,
  .product-card__title a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .product-card__price {
    justify-content: flex-start;
    font-size: var(--product-price-size);
    text-align: start;
  }

  .product-card__options {
    display: grid;
    gap: var(--space-2);
  }

  .product-card__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
  }

  .product-card__swatch,
  .product-card__variant {
    min-block-size: 2rem;
    text-decoration: none;
  }

  .product-card__swatch {
    background: var(--product-card-swatch);
    border: 1px solid color-mix(in srgb, var(--color-foreground) 45%, var(--color-border));
    border-radius: 999px;
    display: block;
    inline-size: 2rem;
  }

  .product-card__swatch:is(:hover, :focus-visible),
  .product-card__swatch.is-selected {
    outline: .125rem solid var(--color-foreground);
    outline-offset: 2px;
  }

  .product-card__variant {
    align-items: center;
    border-block-end: 1px solid transparent;
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
    display: inline-flex;
    font-size: .75rem;
  }

  .product-card__variant:is(:hover, :focus-visible),
  .product-card__variant.is-selected {
    border-color: currentcolor;
    color: var(--color-foreground);
  }

  .product-card__quick-add-wrap { inset-block-end: var(--space-3); inset-inline: var(--space-3); opacity: 0; position: absolute; transform: translateY(.5rem); transition: opacity 160ms ease 180ms, transform 160ms ease 180ms; visibility: hidden; z-index: 2; }
  .product-card__quick-add-shell { display: block; min-inline-size: 0; }
  .product-card__quick-add-form { margin: 0; }
  .product-card__quick-add-form .quick-add__error { margin-block: var(--space-2); }
  .product-card__quick-add { border-radius: var(--button-radius); inline-size: 100%; margin-top: var(--space-2); min-block-size: var(--button-min-block-size); }
  .quick-add__dialog { background: var(--color-background); border: 0; border-radius: .75rem; inline-size: min(52rem, calc(100vw - 2rem)); margin: auto; max-block-size: calc(100dvh - 2rem); overflow: auto; padding: 0; }
  .quick-add__dialog[open] { visibility: visible; }
  .quick-add__dialog::backdrop { background: transparent; }
  .quick-add__dialog[open][data-overlay-visible]::backdrop { background: color-mix(in srgb, var(--overlay-color) var(--overlay-opacity), transparent); }
  html.quick-add-modal-open, body.quick-add-modal-open { overflow: hidden; overscroll-behavior: none; }
  .quick-add__header { align-items: center; border-block-end: 1px solid var(--color-border); display: flex; gap: var(--space-3); justify-content: space-between; padding: var(--space-4); }
  .quick-add__header-copy { display: grid; gap: .2rem; }
  .quick-add__header h2 { font-size: 1.15rem; margin: 0; }
  .quick-add__header button { background: transparent; border: 0; color: currentcolor; font-size: 1.5rem; min-block-size: 2.75rem; min-inline-size: 2.75rem; padding: 0; }
  .quick-add__product { display: grid; grid-template-columns: minmax(15rem, .9fr) minmax(20rem, 1.1fr); }
  .quick-add__media { align-content: start; background: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background)); display: grid; gap: var(--space-3); min-block-size: 100%; padding: var(--space-4); }
  .quick-add__media-stage { aspect-ratio: 4 / 5; background: color-mix(in srgb, var(--color-foreground) 3%, var(--color-background)); overflow: hidden; position: relative; touch-action: pan-y; }
  .quick-add__media-item, .quick-add__media-item :is(img, video, iframe), .quick-add__media-placeholder, .quick-add__media-placeholder svg { block-size: 100%; inline-size: 100%; }
  .quick-add__media-item :is(img, video, iframe) { border-radius: .5rem; display: block; object-fit: contain; }
  .quick-add__media-item video { background: color-mix(in srgb, var(--color-foreground) 3%, var(--color-background)); }
  .quick-add__video-controls { align-items: center; display: flex; gap: var(--space-2); min-block-size: 1.75rem; }
  .quick-add__video-controls[hidden] { display: none; }
  .quick-add__video-controls button { align-items: center; background: transparent; border: 1px solid var(--color-border); border-radius: 50%; color: currentcolor; display: inline-flex; font-size: .7rem; justify-content: center; min-block-size: 1.75rem; min-inline-size: 1.75rem; padding: 0; }
  .quick-add__video-controls button svg { block-size: .95rem; inline-size: .95rem; }
  .quick-add__video-controls input { accent-color: var(--color-foreground); flex: 1; margin: 0; min-inline-size: 0; }
  .quick-add__media-nav { align-items: center; background: color-mix(in srgb, var(--color-background) 88%, transparent); border: 0; border-radius: 50%; color: var(--color-foreground); display: grid; inset-block-start: 50%; min-block-size: 2.5rem; min-inline-size: 2.5rem; padding: 0; place-items: center; position: absolute; transform: translateY(-50%); z-index: 1; }
  .quick-add__media-nav--previous { inset-inline-start: var(--space-2); }
  .quick-add__media-nav--next { inset-inline-end: var(--space-2); }
  .quick-add__media-nav:is(:hover, :focus-visible) { background: var(--color-background); outline: var(--focus-ring); outline-offset: 2px; }
  .quick-add__media-placeholder { align-items: center; display: grid; padding: var(--space-6); place-items: center; }
  .quick-add__media-thumbnails { display: flex; gap: var(--space-2); overflow-x: auto; padding-block-end: .15rem; }
  .quick-add__media-thumbnails button { background: transparent; border: 1px solid var(--color-border); border-radius: .45rem; flex: 0 0 3.5rem; overflow: hidden; padding: 0; }
  .quick-add__media-thumbnails button[aria-current='true'] { outline: var(--focus-ring); outline-offset: 2px; }
  .quick-add__media-thumbnails img { aspect-ratio: 1; display: block; inline-size: 100%; object-fit: cover; }
  .quick-add__details { display: grid; align-content: start; gap: var(--space-4); padding: var(--space-5); }
  .quick-add__vendor, .quick-add__sku, .quick-add__availability { margin: 0; }
  .quick-add__vendor { color: color-mix(in srgb, var(--color-foreground) 65%, transparent); font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .quick-add__price { align-items: baseline; display: flex; flex-wrap: wrap; font-family: var(--product-price-font); font-size: var(--product-price-size); gap: var(--space-2); }
  .quick-add__price strong { font-size: var(--product-price-size-quick-add); }
  .quick-add__price s, .quick-add__price [data-quick-add-unit-price], .quick-add__sku { color: color-mix(in srgb, var(--color-foreground) 65%, transparent); }
  .quick-add__price small { flex-basis: 100%; }
  .quick-add__availability { font-size: .9rem; }
  .quick-add__availability::before { background: var(--color-status-success); border-radius: 50%; content: ''; display: inline-block; block-size: .5rem; inline-size: .5rem; margin-inline-end: .45rem; }
  .quick-add__availability[data-state='sold-out']::before { background: var(--color-status-unavailable); }
  .quick-add__form { display: grid; gap: var(--space-4); }
  .quick-add__view-details { color: color-mix(in srgb, var(--color-foreground) 72%, transparent); font-size: .8rem; text-underline-offset: .18em; width: max-content; }
  .quick-add__view-details--mobile { display: none; }
  .quick-add__view-details--desktop { justify-self: center; }
  .quick-add__option, .quick-add__quantity { display: grid; gap: var(--space-2); margin: 0; }
  .quick-add__option label, .quick-add__quantity > label { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); text-transform: uppercase; }
  .quick-add__option-select { background: var(--color-background); border: 1px solid var(--color-border); color: currentcolor; min-block-size: var(--field-theme-height); padding-inline: var(--space-3); }
  .quick-add__option-buttons { display: none; flex-wrap: wrap; gap: .55rem; }
  quick-add[data-quick-add-enhanced] .quick-add__option-buttons { display: flex; }
  quick-add[data-quick-add-enhanced] .quick-add__option-select { display: none; }
  .quick-add__option-button { background: var(--color-background); border: 1px solid var(--color-border); border-radius: .45rem; color: var(--color-foreground); min-block-size: 2.9rem; min-inline-size: 2.9rem; padding-inline: .9rem; }
  .quick-add__option-button[aria-pressed='true']:not(.quick-add__option-button--swatch) { background: var(--color-foreground); border-color: var(--color-foreground); color: var(--color-background); }
  .quick-add__option-button--swatch { background: var(--quick-add-swatch-background); background-position: center; background-size: cover; border-radius: 50%; color: transparent; inline-size: 2.35rem; min-block-size: 2.35rem; min-inline-size: 2.35rem; overflow: hidden; padding: 0; text-indent: -9999px; }
  .quick-add__option-button--swatch[aria-pressed='true'] { outline: .15rem solid var(--color-foreground); outline-offset: 2px; }
  .quick-add__option-button:disabled { background: color-mix(in srgb, var(--color-foreground) 3%, var(--color-background)); border-color: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background)); color: color-mix(in srgb, var(--color-foreground) 28%, var(--color-background)); cursor: not-allowed; opacity: .65; }
  .quick-add__option-button--swatch:disabled { background: var(--quick-add-swatch-background); opacity: .32; }
  .quick-add__quantity-control { border: 1px solid var(--color-border); border-radius: .375rem; display: grid; grid-template-columns: 2.75rem 4rem 2.75rem; inline-size: max-content; overflow: hidden; }
  .quick-add__quantity-control :is(button, input) { background: transparent; border: 0; border-radius: 0; color: currentcolor; min-block-size: 2.75rem; padding: 0; text-align: center; }
  .quick-add__quantity-control input { border-inline: 1px solid var(--color-border); }
  .quick-add__quantity-control input[type='number'] { appearance: textfield; -moz-appearance: textfield; }
  .quick-add__quantity-control input[type='number']::-webkit-inner-spin-button, .quick-add__quantity-control input[type='number']::-webkit-outer-spin-button { appearance: none; margin: 0; }
  .quick-add__error { background: color-mix(in srgb, var(--color-status-error) 8%, var(--color-background)); border-inline-start: .2rem solid var(--color-status-error); color: var(--color-status-error); margin: 0; padding: var(--space-3); }
  .quick-add__quantity-note { color: color-mix(in srgb, var(--color-foreground) 68%, transparent); font-size: .875rem; margin: 0; }

  .product-card:focus-within .product-card__quick-add-wrap { opacity: 1; transform: translateY(0); visibility: visible; }
  .product-card__quick-add-wrap:has(.quick-add__dialog[open]) { opacity: 1; transform: translateY(0); visibility: visible; }
  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .product-card__quick-add-wrap { opacity: 1; transform: translateY(0); visibility: visible; }
  }
  @media (max-width: 63.99rem) {
    .product-card { padding-block-end: calc(2.75rem + var(--space-2)); position: relative; }
    .product-card__media { position: static; }
    .product-card__quick-add-wrap { inset-block-end: 0; inset-inline: 0; opacity: 1; transform: none; visibility: visible; }
  }
  @media (max-width: 749px) {
    .quick-add__dialog { inline-size: calc(100vw - 3rem); max-block-size: 65dvh; }
    .quick-add__product { grid-template-columns: minmax(0, 1fr); }
    .quick-add__media { max-block-size: none; }
    .quick-add__media-stage { aspect-ratio: 4 / 5; background: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background)); }
    .quick-add__media-item img { aspect-ratio: auto; object-fit: contain; }
    .quick-add__details { padding: var(--space-4); }
    .quick-add__view-details--mobile { display: inline; }
    .quick-add__view-details--desktop { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .product-card__quick-add-wrap { transition: none; } }

  .product-card--unavailable .product-card__media {
    opacity: 0.72;
  }

  .product-card--recommendation { gap: var(--space-2); }
  .product-card--recommendation .product-card__meta { display: none; }
  .product-card--recommendation .product-card__decision { grid-template-columns: minmax(0, 1fr); gap: .35rem; }
  .product-card--recommendation .product-card__title { min-block-size: 0; font-size: clamp(.95rem, 1.15vw, 1.1rem); font-weight: 600; line-height: 1.25; }
  .product-card--recommendation .product-card__price { justify-content: flex-start; text-align: start; }

  @media (max-width: 35rem) {
    .product-card__decision {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }

    .product-card__price {
      justify-content: flex-start;
      text-align: start;
    }

  }

