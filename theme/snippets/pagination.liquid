{% doc %}
  Renders accessible pagination for a Liquid paginate object.

  @param {paginate} paginate - Current paginate object.
  @param {string} [anchor] - Optional fragment appended to generated URLs.

  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}

{% if paginate.pages > 1 %}
  {% liquid
    assign pagination_anchor = ''
    if anchor != blank
      assign pagination_anchor = '#' | append: anchor
    endif
  %}
  <nav class="pagination" aria-label="{{ 'pagination.label' | t }}">
    {% if paginate.previous %}
      <a class="pagination__link pagination__link--previous" href="{{ paginate.previous.url }}{{ pagination_anchor }}">
        {{ 'pagination.previous' | t }}
      </a>
    {% endif %}

    <ol class="pagination__list" role="list">
      {% for part in paginate.parts %}
        <li>
          {% if part.is_link %}
            <a class="pagination__link" href="{{ part.url }}{{ pagination_anchor }}">{{ part.title }}</a>
          {% else %}
            <span
              class="pagination__link"
              {% if part.title == paginate.current_page %}
                aria-current="page"
              {% endif %}
            >
              {{ part.title }}
            </span>
          {% endif %}
        </li>
      {% endfor %}
    </ol>

    {% if paginate.next %}
      <a class="pagination__link pagination__link--next" href="{{ paginate.next.url }}{{ pagination_anchor }}">
        {{ 'pagination.next' | t }}
      </a>
    {% endif %}
  </nav>
{% endif %}

{% stylesheet %}
  .pagination,
  .pagination__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  /* Keep pagination visually independent of whatever listing precedes it. */
  .pagination {
    box-sizing: border-box;
    inline-size: 100%;
    margin-block: var(--space-8);
  }

  .pagination__list {
    list-style: none;
    padding: 0;
  }

  .pagination__link {
    background: var(--color-background);
    border: var(--button-border-width) solid var(--button-border-color);
    border-radius: var(--button-radius);
    color: var(--button-border-color);
    display: grid;
    font-family: var(--button-font);
    font-size: var(--button-font-size);
    letter-spacing: var(--button-letter-spacing);
    line-height: 1.2;
    min-block-size: var(--button-min-block-size);
    min-inline-size: var(--button-min-block-size);
    padding-block: var(--button-padding-block);
    padding-inline: var(--button-padding-inline);
    place-items: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .pagination__link:is(:hover, :focus-visible):not([aria-current='page']) {
    background: var(--button-background-hover);
    color: var(--button-color);
  }

  .pagination__link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: .2rem;
  }

  .pagination__link--previous,
  .pagination__link--next {
    min-inline-size: 0;
  }

  .pagination__link[aria-current='page'] {
    background: var(--button-background);
    color: var(--button-color);
  }
{% endstylesheet %}
