{% # theme-check-disable ValidScopedCSSClass %}
{% assign block_product = product | default: section.settings.product %}
{% assign current_variant = block_product.selected_or_first_available_variant %}
{% if current_variant != blank %}
  <div class="main-product__price" data-product-price aria-live="polite" {{ block.shopify_attributes }}>
    {% render 'price', item: current_variant %}
  </div>
{% elsif request.visual_preview_mode %}
  <div class="main-product__price" aria-label="{{ 'products.price.regular' | t }}" {{ block.shopify_attributes }}>
    <div class="price"><span class="price__current">{{ 'products.card.placeholder_price' | t }}</span></div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.product_price",
  "class": "product-block product-block--price",
  "presets": [{ "name": "t:general.product_price" }]
}
{% endschema %}
{% # theme-check-enable ValidScopedCSSClass %}
