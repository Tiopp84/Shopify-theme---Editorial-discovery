{% doc %}
  Renders an optional product confidence panel owned exclusively by the Product section.
{% enddoc %}

{% liquid
  assign reassurance_page = block.settings.page
  assign has_reassurance = false
  if block.settings.content != blank or reassurance_page != blank
    assign has_reassurance = true
  endif
  assign reassurance_heading = block.settings.heading
  if request.visual_preview_mode and has_reassurance == false
    assign has_reassurance = true
    assign reassurance_heading = 'products.form.preview_reassurance_heading' | t
  endif
%}

{% if has_reassurance %}
  <aside class="product-reassurance" {% if reassurance_heading != blank %}aria-labelledby="ProductReassurance-{{ block.id }}"{% else %}aria-label="{{ 'products.form.reassurance' | t }}"{% endif %} {{ block.shopify_attributes }}>
    {% if reassurance_heading != blank %}<h2 id="ProductReassurance-{{ block.id }}">{{ reassurance_heading | escape }}</h2>{% endif %}
    {% if block.settings.content != blank %}<div class="product-reassurance__content">{{ block.settings.content }}</div>{% endif %}
    {% if reassurance_page != blank %}
      <a href="{{ reassurance_page.url }}">{{ block.settings.link_label | default: reassurance_page.title | escape }}</a>
    {% elsif request.visual_preview_mode %}
      <div class="product-reassurance__content"><p>{{ 'products.form.preview_reassurance_content' | t }}</p></div>
    {% endif %}
  </aside>
{% endif %}

{% stylesheet %}
  .product-reassurance { border-block: 1px solid var(--color-border); display: grid; gap: var(--space-2); padding-block: var(--space-4); }
  .product-reassurance h2 { font-family: var(--small-label-font); font-size: var(--small-label-size); font-style: normal; font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; text-transform: uppercase; }
  .product-reassurance__content { color: color-mix(in srgb, var(--color-foreground) 78%, var(--color-background)); font-size: .9rem; line-height: var(--body-text-line-spacing); }
  .product-reassurance__content > :first-child { margin-block-start: 0; }
  .product-reassurance__content > :last-child { margin-block-end: 0; }
  .product-reassurance a { color: currentcolor; font-size: .8125rem; text-underline-offset: .2em; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_reassurance",
  "class": "product-block product-block--reassurance",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.reassurance_heading" },
    { "type": "richtext", "id": "content", "label": "t:labels.reassurance_content" },
    { "type": "page", "id": "page", "label": "t:labels.reassurance_page" },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label" }
  ],
  "presets": [{ "name": "t:general.product_reassurance" }]
}
{% endschema %}
