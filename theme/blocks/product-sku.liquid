{% # theme-check-disable ValidScopedCSSClass %}
{% assign block_product = product | default: section.settings.product %}
{% assign current_variant = block_product.selected_or_first_available_variant %}
{% if current_variant.sku != blank %}
  <p class="main-product__sku" data-product-sku {{ block.shopify_attributes }}>
    <span>{{ 'products.form.sku' | t }}</span> <span data-product-sku-value>{{ current_variant.sku | escape }}</span>
  </p>
{% elsif request.visual_preview_mode %}
  <p class="main-product__sku" {{ block.shopify_attributes }}>
    <span>{{ 'products.form.sku' | t }}</span> <span>{{ 'products.form.preview_sku' | t }}</span>
  </p>
{% endif %}

{% schema %}
{
  "name": "t:general.product_sku",
  "class": "product-block product-block--sku",
  "presets": [{ "name": "t:general.product_sku" }]
}
{% endschema %}
{% # theme-check-enable ValidScopedCSSClass %}
