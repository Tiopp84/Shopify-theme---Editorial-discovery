<div class="footer-menu" {{ block.shopify_attributes }}>
  {% if block.settings.show_block and block.settings.menu != blank and block.settings.menu.links.size > 0 %}
    <nav aria-label="{{ block.settings.heading | escape }}">
      {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
      <ul role="list">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>
    </nav>
  {% endif %}
</div>

{% stylesheet %}
  .footer-menu h2 { margin-block-end: var(--space-4); font-size: 1rem; }
  .footer-menu ul { display: grid; gap: var(--space-2); list-style: none; padding: 0; }
  .footer-menu a { text-underline-offset: 0.2em; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer_menu",
  "settings": [
    { "type": "checkbox", "id": "show_block", "label": "t:labels.show_block", "default": true },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Explore"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
