<div class="footer-legal" {{ block.shopify_attributes }}>
  {% if block.settings.show_block and block.settings.menu != blank and block.settings.menu.links.size > 0 %}<nav aria-label="{% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% else %}{{ 'accessibility.footer_navigation' | t }}{% endif %}">{% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}<ul role="list">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></nav>{% endif %}
</div>
{% stylesheet %}
  .footer-legal { border-block-start: 1px solid color-mix(in srgb, var(--footer-color, var(--color-background)) 18%, transparent); padding-block-start: var(--space-5); }
  .footer-legal h2 { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0 0 var(--space-3); text-transform: uppercase; }
  .footer-legal ul { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); list-style: none; margin: 0; padding: 0; }
{% endstylesheet %}
{% schema %}
{ "name": "t:general.footer_legal", "settings": [{ "type": "checkbox", "id": "show_block", "label": "t:labels.show_block", "default": true }, { "type": "text", "id": "heading", "label": "t:labels.heading" }, { "type": "link_list", "id": "menu", "label": "t:labels.menu" }] }
{% endschema %}
