{% # theme-check-disable ValidScopedCSSClass %}
{% assign block_product = product | default: section.settings.product %}
{% if block_product.vendor != blank %}
  <p class="main-product__vendor" {{ block.shopify_attributes }}>{{ block_product.vendor | escape }}</p>
{% elsif request.visual_preview_mode %}
  <p class="main-product__vendor" {{ block.shopify_attributes }}>{{ shop.name | escape }}</p>
{% endif %}

{% schema %}
{
  "name": "t:general.product_vendor",
  "class": "product-block product-block--vendor",
  "presets": [{ "name": "t:general.product_vendor" }]
}
{% endschema %}
{% # theme-check-enable ValidScopedCSSClass %}
