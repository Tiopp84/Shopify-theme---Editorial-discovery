<section
  class="editorial-details editorial-details--{{ section.settings.media_style }}"
  {% if section.settings.heading != blank %}
    aria-labelledby="EditorialDetailsHeading-{{ section.id }}"
  {% endif %}
  style="--editorial-details-icon-color: {{ section.settings.icon_color | default: '#5C6A4B' }}; --editorial-details-icon-size: {{ section.settings.icon_size | default: 72 }}px; --editorial-details-image-ratio: {{ section.settings.image_ratio | default: '3 / 2' }};"
  {{ section.shopify_attributes }}
>
  {% if section.settings.heading != blank or section.settings.intro != blank %}
    <header class="editorial-details__header">
      {% if section.settings.heading != blank %}
        <h2 id="EditorialDetailsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <div class="editorial-details__intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </header>
  {% endif %}
  {% if section.blocks.size > 0 %}
    <div class="editorial-details__grid">
      {% for block in section.blocks %}
        {% if block.settings.heading != blank or request.visual_preview_mode %}
          <article class="editorial-details__item" {{ block.shopify_attributes }}>
            {% if section.settings.media_style == 'image' %}
              {% if block.settings.image != blank or request.visual_preview_mode %}
                <div class="editorial-details__media">
                  {% if block.settings.image != blank %}
                    {% render 'image',
                      image: block.settings.image,
                      alt: block.settings.image.alt,
                      width: 900,
                      widths: '240, 360, 540, 720, 900',
                      sizes: '(min-width: 64rem) 28vw, (min-width: 48rem) 42vw, 88vw'
                    %}
                  {% else %}
                    <span class="editorial-details__placeholder" aria-hidden="true">
                      {{- 'lifestyle-1' | placeholder_svg_tag -}}
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            {% else %}
              {% assign icon_name = block.settings.icon | default: 'thread' %}
              {% assign icon_asset = 'phosphor-' | append: icon_name | append: '.svg' %}
              <span
                class="editorial-details__icon"
                aria-hidden="true"
                style="--editorial-details-icon-mask: url('{{ icon_asset | asset_url }}');"
              ></span>
            {% endif %}
            <div class="editorial-details__content">
              {% if block.settings.heading != blank %}
                <h3>{{ block.settings.heading | escape }}</h3>
              {% elsif request.visual_preview_mode %}
                <h3>{{ 'editorial.detail' | t }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="editorial-details__text rte">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.link_label != blank and block.settings.link != blank -%}
                <a class="editorial-details__link" href="{{ block.settings.link }}">
                  {{- block.settings.link_label | escape -}}
                </a>
              {%- endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .editorial-details {
    background: var(--color-background);
    margin-block-end: var(--space-chapter);
    padding: clamp(4rem, 8vw, 7rem) max(var(--layout-gutter), calc((100vw - var(--layout-content-max)) / 2));
  }
  .editorial-details__header {
    display: grid;
    gap: var(--space-3);
    margin: 0 auto clamp(2.25rem, 5vw, 4rem);
    max-inline-size: 42rem;
    text-align: center;
  }
  .editorial-details h2 {
    font-family: var(--font-campaign);
    font-size: clamp(2.25rem, 4.3vw, 4.5rem);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0;
  }
  .editorial-details__intro {
    color: color-mix(in srgb, var(--color-foreground) 76%, var(--color-background));
    line-height: calc(var(--body-text-line-spacing) + 0.1);
    margin-inline: auto;
    max-inline-size: 34rem;
  }
  .editorial-details__intro > :first-child,
  .editorial-details__text > :first-child {
    margin-block-start: 0;
  }
  .editorial-details__intro > :last-child,
  .editorial-details__text > :last-child {
    margin-block-end: 0;
  }
  .editorial-details__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
  .editorial-details__item {
    align-content: start;
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    min-inline-size: 0;
    text-align: center;
  }
  .editorial-details__media {
    aspect-ratio: var(--editorial-details-image-ratio);
    background: var(--color-panel-02);
    inline-size: 100%;
    margin-inline: auto;
    overflow: hidden;
  }
  .editorial-details__media .image,
  .editorial-details__media .image > img,
  .editorial-details__placeholder,
  .editorial-details__placeholder svg {
    block-size: 100%;
    display: block;
    inline-size: 100%;
    object-fit: cover;
  }
  .editorial-details__placeholder {
    color: color-mix(in srgb, var(--color-foreground) 25%, var(--color-panel-02));
  }
  .editorial-details__icon {
    background: var(--editorial-details-icon-color, var(--color-interactive));
    block-size: var(--editorial-details-icon-size);
    display: block;
    inline-size: var(--editorial-details-icon-size);
    -webkit-mask: var(--editorial-details-icon-mask) center / contain no-repeat;
    mask: var(--editorial-details-icon-mask) center / contain no-repeat;
  }
  .editorial-details__content {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    max-inline-size: 24rem;
  }
  .editorial-details h3 {
    font-family: var(--font-commerce);
    font-size: clamp(1.4rem, 2vw, 2rem);
    font-style: normal;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0;
  }
  .editorial-details__text {
    color: color-mix(in srgb, var(--color-foreground) 76%, var(--color-background));
    line-height: calc(var(--body-text-line-spacing) + 0.08);
  }
  .editorial-details__link {
    align-items: center;
    border-block-end: 1px solid currentcolor;
    color: currentcolor;
    display: inline-flex;
    font-family: var(--small-label-font);
    font-size: var(--small-label-size);
    font-weight: 600;
    gap: var(--space-2);
    letter-spacing: var(--small-label-letter-spacing);
    line-height: var(--small-label-line-height);
    padding-block-end: var(--space-1);
    text-decoration: none;
    text-transform: uppercase;
    width: fit-content;
  }
  .editorial-details__link::after {
    content: '↗';
    font-family: var(--font-commerce);
    font-size: 1.1em;
    transition: transform 180ms ease;
  }
  .editorial-details__link:is(:hover, :focus-visible) { color: var(--color-interactive); }
  .editorial-details__link:is(:hover, :focus-visible)::after { transform: translate(.14rem, -.14rem); }
  @media (min-width: 48rem) {
    .editorial-details__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 47.99rem) {
    .editorial-details {
      margin-block-end: var(--space-chapter-mobile);
    }
  }
{% endstylesheet %}

