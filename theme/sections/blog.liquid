{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<section class="blog-template blog-template--{{ section.settings.card_density }}{% if section.settings.show_media %} blog-template--with-media{% endif %}" aria-labelledby="BlogHeading-{{ section.id }}">
  <header class="blog-template__header">
    <h1 id="BlogHeading-{{ section.id }}">{{ blog.title | escape }}</h1>
  </header>

  {% paginate blog.articles by 5 %}
    {% if blog.articles_count > 0 %}
      <div class="blog-template__grid">
        {% for article in blog.articles %}
          {% assign article_word_count = article.content | strip_html | strip_newlines | split: ' ' | size %}
          {% assign article_read_minutes = article_word_count | divided_by: 220.0 | ceil | at_least: 1 %}
          <article class="blog-card">
            {% if section.settings.show_media %}
              <a class="blog-card__media" href="{{ article.url }}" aria-label="{{ article.title | escape }}" style="--blog-card-media-ratio: {{ section.settings.media_ratio }};">
                {% if article.image %}
                  {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 64rem) 33vw, (min-width: 48rem) 50vw, 100vw' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'blog-card__placeholder' }}
                {% endif %}
              </a>
            {% endif %}
            <div class="blog-card__content">
              <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
              {% if section.settings.show_author or section.settings.show_date or section.settings.show_read_time %}
                <p class="blog-card__metadata">
                  {% if section.settings.show_author and article.author != blank %}<span>{{ article.author | escape }}</span>{% endif %}
                  {% if section.settings.show_date %}<span>{{ article.published_at | time_tag: format: 'date' }}</span>{% endif %}
                  {% if section.settings.show_read_time %}<span>{{ 'blog.read_time' | t: count: article_read_minutes }}</span>{% endif %}
                </p>
              {% endif %}
              {% assign article_excerpt = article.excerpt_or_content | strip_html | strip_newlines | strip %}
              {% if article_excerpt != blank %}<p class="blog-card__excerpt">{{ article_excerpt | truncatewords: 28 }}</p>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="blog-template__empty">
        <h2>{{ 'blog.empty_title' | t }}</h2>
        <p>{{ 'blog.empty_text' | t }}</p>
      </div>
    {% endif %}

    {%- if paginate.pages > 1 -%}
      {{- paginate | default_pagination -}}
    {%- endif -%}
  {% endpaginate %}
</section>

{% stylesheet %}
  .blog-template { margin: var(--space-8) auto; max-inline-size: var(--page-width); padding-inline: var(--page-margin); }
  .blog-template__header { margin-block-end: var(--space-8); }
  .blog-template__header h1 { font-size: clamp(var(--heading-size-80), calc(var(--heading-size-80) + 6vw), var(--heading-size-160)); margin: 0; }
  .blog-template__grid { display: grid; gap: var(--space-6); }
  .blog-template__empty { display: grid; gap: var(--space-3); max-inline-size: 34rem; padding-block: var(--space-6); }
  .blog-template__empty h2, .blog-template__empty p { margin: 0; }
  .blog-template__empty p { color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background)); line-height: calc(var(--body-text-line-spacing) + .1); }
  .blog-card { display: grid; gap: var(--space-4); }
  .blog-card__media { aspect-ratio: var(--blog-card-media-ratio); background: color-mix(in srgb, var(--color-foreground) 6%, var(--color-background)); display: block; overflow: hidden; }
  .blog-card__media img, .blog-card__placeholder { block-size: 100%; display: block; inline-size: 100%; object-fit: cover; transition: transform .35s ease; }
  .blog-card__content { max-inline-size: 44rem; }
  .blog-card h2 { font-size: clamp(var(--heading-size-44), calc(var(--heading-size-44) + 2.25vw), var(--heading-size-64)); margin: 0; }
  .blog-card h2 a { color: inherit; text-decoration: none; }
  .blog-card h2 a:focus-visible, .blog-card__media:focus-visible { outline: .125rem solid var(--color-interactive); outline-offset: .25rem; }
  .blog-card__metadata { align-items: center; color: color-mix(in srgb, var(--color-foreground) 68%, var(--color-background)); display: flex; flex-wrap: wrap; font-family: var(--small-label-font); font-size: var(--small-label-size); gap: var(--space-2); letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: var(--space-3) 0 0; }
  .blog-card__metadata span + span::before { content: '·'; margin-inline-end: var(--space-2); }
  .blog-card__excerpt { line-height: calc(var(--body-text-line-spacing) + .1); margin: var(--space-3) 0 0; }
  .blog-template--with-media.blog-template--editorial .blog-card { align-items: start; grid-template-columns: minmax(6rem, 30vw) minmax(0, 1fr); }
  .blog-template--editorial .blog-card__media { max-inline-size: 14rem; }
  @media (hover: hover) and (pointer: fine) { .blog-card__media:hover img { transform: scale(1.025); } }
  @media (min-width: 48rem) { .blog-template--compact .blog-template__grid { display: flex; flex-wrap: wrap; gap: var(--space-6); justify-content: center; } .blog-template--compact .blog-card { flex: 0 0 calc((100% - var(--space-6)) / 2); gap: var(--space-3); } .blog-template--compact .blog-card h2 { font-size: clamp(var(--heading-size-40), calc(var(--heading-size-40) + 2.25vw), var(--heading-size-56)); } }
  @media (min-width: 64rem) { .blog-template--compact .blog-card { flex-basis: calc((100% - var(--space-6) - var(--space-6)) / 3); } .blog-template--with-media.blog-template--editorial .blog-card { grid-template-columns: minmax(10rem, 14rem) minmax(0, 44rem); gap: var(--space-6); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    { "type": "select", "id": "card_density", "label": "t:labels.blog_card_density", "options": [{ "value": "editorial", "label": "t:options.blog_card_density.editorial" }, { "value": "compact", "label": "t:options.blog_card_density.compact" }], "default": "editorial" },
    { "type": "checkbox", "id": "show_media", "label": "t:labels.show_media", "default": true },
    { "type": "select", "id": "media_ratio", "label": "t:labels.image_ratio", "options": [{ "value": "1 / 1", "label": "t:options.image_ratio.square" }, { "value": "4 / 5", "label": "t:options.image_ratio.portrait" }, { "value": "16 / 10", "label": "t:options.image_ratio.landscape" }], "default": "4 / 5", "visible_if": "{{ section.settings.show_media }}" },
    { "type": "checkbox", "id": "show_author", "label": "t:labels.show_author", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "t:labels.show_date", "default": true },
    { "type": "checkbox", "id": "show_read_time", "label": "t:labels.show_read_time", "default": true }
  ],
  "enabled_on": { "templates": ["blog"] }
}
{% endschema %}
