<section class="about-story full-width about-story--media-{{ section.settings.media_position }}" data-about-reveal{% if section.settings.heading != blank %} aria-labelledby="AboutStoryHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="about-story__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'about-story__image', loading: 'lazy', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 64rem) 50vw, 100vw' }}
    {% else %}
      <span class="about-story__placeholder" aria-hidden="true">{{ 'lifestyle-2' | placeholder_svg_tag }}</span>
    {% endif %}
  </div>
  <div class="about-story__content">
    {% if section.settings.eyebrow != blank %}<p class="about-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 id="AboutStoryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="about-story__text rte">{{ section.settings.text }}</div>{% endif %}
  </div>
</section>

{% stylesheet %}
  .about-story { align-items: center; display: grid; gap: clamp(2.5rem, 8vw, 10rem); margin-block: var(--space-chapter); padding-inline: max(var(--layout-gutter), calc((100vw - var(--layout-content-max)) / 2)); }
  .about-story__media { background: var(--color-panel-02); min-block-size: clamp(22rem, 46vw, 42rem); overflow: hidden; }
  .about-story__image, .about-story__placeholder, .about-story__placeholder svg { block-size: 100%; display: block; inline-size: 100%; }
  .about-story__image { object-fit: cover; }
  .about-story__placeholder { color: color-mix(in srgb, var(--color-foreground) 30%, var(--color-panel-02)); }
  .about-story__content { display: grid; gap: var(--space-4); max-inline-size: 34rem; }
  .about-story__eyebrow { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; text-transform: uppercase; }
  .about-story h2 { font-family: var(--font-campaign); font-size: clamp(2.5rem, 4.7vw, 5rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.04em; line-height: .95; margin: 0; }
  .about-story__text { color: color-mix(in srgb, var(--color-foreground) 76%, var(--color-background)); line-height: calc(var(--body-text-line-spacing) + .08); }
  .about-story__text > :first-child { margin-block-start: 0; }
  .about-story__text > :last-child { margin-block-end: 0; }
  @media (min-width: 64rem) { .about-story { grid-template-columns: minmax(0, 1fr) minmax(18rem, .78fr); } .about-story--media-right { grid-template-columns: minmax(18rem, .78fr) minmax(0, 1fr); } .about-story--media-right .about-story__media { grid-column: 2; } .about-story--media-right .about-story__content { grid-column: 1; grid-row: 1; } }
  @media (prefers-reduced-motion: no-preference) { .about-story--motion-enabled.is-revealed .about-story__media { animation: about-story-media-in 780ms cubic-bezier(.22, 1, .36, 1) both; } .about-story--motion-enabled.is-revealed .about-story__content { animation: about-story-content-in 600ms cubic-bezier(.22, 1, .36, 1) 130ms both; } .about-story--media-right.about-story--motion-enabled.is-revealed .about-story__media { animation-name: about-story-media-in-right; } @keyframes about-story-media-in { from { opacity: 0; transform: translate3d(-9%, 0, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } } @keyframes about-story-media-in-right { from { opacity: 0; transform: translate3d(9%, 0, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } } @keyframes about-story-content-in { from { opacity: 0; transform: translate3d(0, 2.5rem, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } } }
  @media (max-width: 63.99rem) { .about-story { gap: var(--space-5); margin-block: var(--space-chapter-mobile); padding-inline: var(--layout-gutter); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_story",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "header", "content": "t:general.content" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Our point of view" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "A smaller wardrobe, with more ways to live in it." },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>We begin with proportion, texture and the habits that make a piece worth returning to. The result is an everyday wardrobe that feels personal rather than prescribed.</p>" },
    { "type": "header", "content": "t:general.layout" },
    { "type": "select", "id": "media_position", "label": "t:labels.media_position", "options": [{ "value": "left", "label": "t:options.position.left" }, { "value": "right", "label": "t:options.position.right" }], "default": "left" }
  ],
  "presets": [{ "name": "t:general.about_story", "category": "Content" }]
}
{% endschema %}
