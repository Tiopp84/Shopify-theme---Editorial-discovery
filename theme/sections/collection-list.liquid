{% liquid
  assign desktop_columns = section.settings.desktop_columns | default: '4'
%}

<section class="collection-list full-width collection-list--heading-{{ section.settings.heading_size }} collection-list--heading-{{ section.settings.heading_alignment }} collection-list--columns-{{ desktop_columns }}" data-aos-section style="--collection-list-background: var(--color-background); --collection-list-ratio: {{ section.settings.image_ratio }}; {% render 'section-color-scheme', scheme: section.settings.color_scheme %}" {% if section.settings.heading != blank %}aria-labelledby="CollectionListHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <header class="collection-list__header" data-aos="fade-down">
    {% if section.settings.heading != blank %}<h2 id="CollectionListHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
  </header>

  <ul class="collection-list__grid" data-aos-sequence="row" data-aos-trigger="early" role="list">
    {% content_for 'block', type: 'collection-card', id: 'collection-card-1' %}
    {% content_for 'block', type: 'collection-card', id: 'collection-card-2' %}
    {% content_for 'block', type: 'collection-card', id: 'collection-card-3' %}
    {% content_for 'block', type: 'collection-card', id: 'collection-card-4' %}
    {% content_for 'blocks' %}
  </ul>
</section>

{% stylesheet %}
  .collection-list { --collection-list-gutter: clamp(1.25rem, 3.3vw, 3.75rem); background: var(--collection-list-background, transparent); margin: 0 0 var(--space-chapter); max-width: none; padding: clamp(1.5rem, 4vw, 3rem) var(--collection-list-gutter); }
  .collection-list__header { margin-block-end: clamp(1.5rem, 5vw, 3rem); }
  .collection-list h2 { font-family: var(--font-campaign); font-size: clamp(2.35rem, 4.2vw, 4rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.04em; line-height: .93; margin: 0; }
  .collection-list--heading-small h2 { font-size: clamp(1.85rem, 3vw, 2.75rem); }
  .collection-list--heading-medium h2 { font-size: clamp(2.35rem, 4.2vw, 4rem); }
  .collection-list--heading-large h2 { font-size: clamp(2.75rem, 5.5vw, 5.5rem); }
  .collection-list--heading-left .collection-list__header { text-align: start; }
  .collection-list--heading-center .collection-list__header { text-align: center; }
  .collection-list--heading-right .collection-list__header { text-align: end; }
  .collection-list__grid { --collection-list-grid-gap: clamp(var(--space-3), 2vw, var(--space-5)); display: grid; gap: var(--collection-list-grid-gap); grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .collection-list__grid > li { min-width: 0; }
  .collection-list__card { color: currentcolor; display: grid; gap: var(--space-3); min-width: 0; text-decoration: none; }
  .collection-list__media { aspect-ratio: var(--collection-list-ratio); background: color-mix(in srgb, var(--collection-list-background, var(--color-background)) 82%, white); display: block; overflow: hidden; position: relative; }
  .collection-list__media > :is(.collection-list__image, .collection-list__placeholder), .collection-list__media > .collection-list__image > img, .collection-list__media > .collection-list__placeholder > svg { block-size: 100%; inset: 0; inline-size: 100%; object-fit: cover; object-position: var(--collection-list-focal-point, center); position: absolute; }
  .collection-list__image > img { transition: transform 220ms ease; }
  .collection-list__card:is(:hover, :focus-visible) .collection-list__image > img { transform: scale(1.015); }
  .collection-list__content { align-items: start; display: grid; gap: var(--space-2); }
  .collection-list__title { font-family: var(--font-campaign); font-size: clamp(1.05rem, 1.5vw, 1.35rem); font-style: var(--font-heading--style); line-height: 1.05; }
  .collection-list__action { font-size: .625rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .collection-list__card:is(:hover, :focus-visible) .collection-list__action { color: var(--color-accent); }
  .collection-list__preview-card { display: grid; gap: var(--space-2); min-width: 0; }
  .collection-list__preview-media { aspect-ratio: var(--collection-list-preview-ratio); background: color-mix(in srgb, var(--color-foreground) 8%, var(--collection-list-background, var(--color-background))); border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent); display: block; overflow: hidden; }
  .collection-list__preview-media > svg { block-size: 100%; inline-size: 100%; }
  .collection-list__preview-title { font-family: var(--font-campaign); font-size: .875rem; line-height: 1.1; }
  @media (min-width: 64rem) {
    .collection-list { padding-inline: clamp(7.5rem, 10vw, 12rem); }
    .collection-list--columns-3 .collection-list__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .collection-list--columns-4 .collection-list__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 47.99rem) {
    .collection-list { margin-block-end: var(--space-chapter-mobile); padding-block: var(--space-5); }
    .collection-list__header { margin-block-end: var(--space-5); }
    .collection-list h2 { font-size: 2.25rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "settings": [
    { "type": "header", "content": "t:general.content" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Collections" },
    { "type": "select", "id": "heading_size", "label": "t:labels.heading_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "medium" },
    { "type": "select", "id": "heading_alignment", "label": "t:labels.heading_alignment", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left" },
    { "type": "header", "content": "t:general.layout" },
    { "type": "select", "id": "desktop_columns", "label": "t:labels.desktop_collection_columns", "options": [{ "value": "3", "label": "t:options.columns.three" }, { "value": "4", "label": "t:options.columns.four" }], "default": "4" },
    { "type": "select", "id": "image_ratio", "label": "t:labels.image_size", "options": [{ "value": "1 / 1", "label": "t:options.image_ratio.square" }, { "value": "4 / 5", "label": "t:options.image_ratio.portrait" }, { "value": "3 / 4", "label": "t:options.image_ratio.tall" }], "default": "4 / 5" },
    { "type": "header", "content": "t:general.style" },
    { "type": "select", "id": "color_scheme", "label": "t:labels.color_scheme", "options": [{ "value": "base", "label": "t:options.color_scheme.base" }, { "value": "soft", "label": "t:options.color_scheme.soft" }, { "value": "dark", "label": "t:options.color_scheme.dark" }], "default": "base" }
  ],
  "blocks": [{ "type": "collection-card" }],
  "max_blocks": 8,
  "enabled_on": { "templates": ["index"] },
  "presets": [
    {
      "name": "t:general.collection_list",
      "category": "Products & collections",
      "blocks": [
        { "type": "collection-card", "static": true, "id": "collection-card-1" },
        { "type": "collection-card", "static": true, "id": "collection-card-2" },
        { "type": "collection-card", "static": true, "id": "collection-card-3" },
        { "type": "collection-card", "static": true, "id": "collection-card-4" }
      ]
    }
  ]
}
{% endschema %}
