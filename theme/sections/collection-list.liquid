{% liquid
  assign desktop_columns = section.settings.desktop_columns | default: '4'
%}

<section class="collection-list full-width collection-list--heading-{{ section.settings.heading_size }} collection-list--content-{{ section.settings.content_position }} collection-list--text-{{ section.settings.heading_alignment }} collection-list--columns-{{ desktop_columns }}{% if section.settings.image_ratio == '2 / 1' %} collection-list--wide-media{% endif %} collection-list--item-{{ section.settings.item_style }} collection-list--item-text-{{ section.settings.item_text_position }}" data-aos-section style="--collection-list-background: var(--color-background); --collection-list-card-title-size: {{ section.settings.card_title_font_size }}px; --collection-list-grid-gap: {{ section.settings.grid_spacing }}px; --collection-list-ratio: {{ section.settings.image_ratio }};" {% if section.settings.heading != blank %}aria-labelledby="CollectionListHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <header class="collection-list__header" data-aos="fade-down">
    <div class="collection-list__header-content">
      {% if section.settings.heading != blank %}<h2 id="CollectionListHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.intro != blank %}<div class="collection-list__intro rte">{{ section.settings.intro }}</div>{% endif %}
    </div>
  </header>

  <ul class="collection-list__grid" data-aos-sequence="row" data-aos-trigger="early" role="list">
    {% content_for 'block', type: 'collection-card', id: 'collection-card-1' %}
    {% content_for 'block', type: 'collection-card', id: 'collection-card-2' %}
    {% content_for 'block', type: 'collection-card', id: 'collection-card-3' %}
    {% content_for 'block', type: 'collection-card', id: 'collection-card-4' %}
    {% content_for 'blocks' %}
  </ul>
</section>

{% stylesheet %}
  .collection-list { --collection-list-gutter: clamp(1.25rem, 3.3vw, 3.75rem); background: var(--collection-list-background, transparent); margin: 0 0 var(--space-chapter); max-width: none; padding: clamp(1.5rem, 4vw, 3rem) var(--collection-list-gutter); }
  .collection-list__header { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-block-end: clamp(1.5rem, 5vw, 3rem); }
  .collection-list__header-content { display: grid; gap: var(--space-4); min-inline-size: 0; }
  .collection-list h2 { font-family: var(--font-campaign); font-size: clamp(2.35rem, 4.2vw, 4rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.04em; line-height: .93; margin: 0; }
  .collection-list--heading-small h2 { font-size: clamp(1.85rem, 3vw, 2.75rem); }
  .collection-list--heading-medium h2 { font-size: clamp(2.35rem, 4.2vw, 4rem); }
  .collection-list--heading-large h2 { font-size: clamp(2.75rem, 5.5vw, 5.5rem); }
  .collection-list__intro { color: color-mix(in srgb, var(--color-foreground) 74%, var(--color-background)); line-height: 1.6; }
  .collection-list__intro > :first-child { margin-block-start: 0; }
  .collection-list__intro > :last-child { margin-block-end: 0; }
  .collection-list--content-left .collection-list__header-content { grid-column: 1; }
  .collection-list--content-center .collection-list__header-content { grid-column: 2; }
  .collection-list--content-right .collection-list__header-content { grid-column: 3; }
  .collection-list--text-left .collection-list__header-content { text-align: start; }
  .collection-list--text-center .collection-list__header-content { text-align: center; }
  .collection-list--text-right .collection-list__header-content { text-align: end; }
  .collection-list__grid { display: grid; gap: var(--collection-list-grid-gap); grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .collection-list__grid > li { min-width: 0; }
  .collection-list__card { color: currentcolor; display: grid; gap: var(--space-3); min-width: 0; text-decoration: none; }
  .collection-list__media { aspect-ratio: var(--collection-list-ratio); background: color-mix(in srgb, var(--collection-list-background, var(--color-background)) 82%, white); display: block; overflow: hidden; position: relative; }
  .collection-list__media > :is(.collection-list__image, .collection-list__placeholder), .collection-list__media > .collection-list__image > img, .collection-list__media > .collection-list__placeholder > svg { block-size: 100%; inset: 0; inline-size: 100%; object-fit: cover; object-position: var(--collection-list-focal-point, center); position: absolute; }
  .collection-list__image > img { transition: transform 220ms ease; }
  .collection-list__card:is(:hover, :focus-visible) .collection-list__image > img { transform: scale(1.015); }
  .collection-list__content { align-items: start; display: grid; gap: var(--space-2); }
  .collection-list__title { font-family: var(--font-campaign); font-size: var(--collection-list-card-title-size); font-style: var(--font-heading--style); line-height: 1.05; }
  .collection-list--item-overlay .collection-list__card, .collection-list--item-overlay_box .collection-list__card { display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); }
  .collection-list--item-overlay .collection-list__media, .collection-list--item-overlay_box .collection-list__media { grid-area: 1 / 1; }
  .collection-list--item-overlay .collection-list__content, .collection-list--item-overlay_box .collection-list__content { grid-area: 1 / 1; min-width: 0; padding: var(--space-4); position: relative; z-index: 1; }
  .collection-list--item-overlay .collection-list__content { color: var(--color-background); text-shadow: 0 .08em .45em color-mix(in srgb, var(--color-foreground) 62%, transparent); }
  .collection-list--item-overlay_box .collection-list__content { background: color-mix(in srgb, var(--color-background) 88%, transparent); color: var(--color-foreground); inline-size: fit-content; margin: var(--space-3); max-inline-size: min(78%, 17rem); padding: var(--space-3); }
  .collection-list--item-text-top_left .collection-list__content { align-self: start; justify-self: start; text-align: start; }
  .collection-list--item-text-center_left .collection-list__content { align-self: center; justify-self: start; text-align: start; }
  .collection-list--item-text-bottom_left .collection-list__content { align-self: end; justify-self: start; text-align: start; }
  .collection-list--item-text-top_center .collection-list__content { align-self: start; justify-self: center; text-align: center; }
  .collection-list--item-text-center_center .collection-list__content { align-self: center; justify-self: center; text-align: center; }
  .collection-list--item-text-bottom_center .collection-list__content { align-self: end; justify-self: center; text-align: center; }
  .collection-list--item-text-top_right .collection-list__content { align-self: start; justify-self: end; text-align: end; }
  .collection-list--item-text-center_right .collection-list__content { align-self: center; justify-self: end; text-align: end; }
  .collection-list--item-text-bottom_right .collection-list__content { align-self: end; justify-self: end; text-align: end; }
  .collection-list__preview-card { display: grid; gap: var(--space-2); min-width: 0; }
  .collection-list__preview-media { aspect-ratio: var(--collection-list-preview-ratio); background: color-mix(in srgb, var(--color-foreground) 8%, var(--collection-list-background, var(--color-background))); border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent); display: block; overflow: hidden; }
  .collection-list__preview-media > svg { block-size: 100%; inline-size: 100%; }
  .collection-list__preview-title { font-family: var(--font-campaign); font-size: .875rem; line-height: 1.1; }
  @media (min-width: 64rem) {
    .collection-list { padding-inline: clamp(7.5rem, 10vw, 12rem); }
    .collection-list--columns-2 .collection-list__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .collection-list--columns-3 .collection-list__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .collection-list--columns-4 .collection-list__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .collection-list--wide-media.collection-list--columns-4 .collection-list__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 47.99rem) {
    .collection-list { margin-block-end: var(--space-chapter-mobile); padding-block: var(--space-5); }
    .collection-list__header { margin-block-end: var(--space-5); }
    .collection-list__header-content { grid-column: 1 / -1; }
    .collection-list h2 { font-size: 2.25rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "settings": [
    { "type": "header", "content": "t:general.content" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Collections" },
    { "type": "richtext", "id": "intro", "label": "t:labels.text" },
    { "type": "select", "id": "heading_size", "label": "t:labels.heading_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "medium" },
    { "type": "select", "id": "content_position", "label": "t:labels.content_position", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left" },
    { "type": "select", "id": "heading_alignment", "label": "t:labels.text_alignment", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left" },
    { "type": "header", "content": "t:general.layout" },
    { "type": "select", "id": "desktop_columns", "label": "t:labels.items_per_row", "options": [{ "value": "2", "label": "t:options.columns.two" }, { "value": "3", "label": "t:options.columns.three" }, { "value": "4", "label": "t:options.columns.four" }], "default": "4" },
    { "type": "range", "id": "grid_spacing", "min": 8, "max": 48, "step": 4, "unit": "px", "label": "t:labels.grid_gap", "default": 32 },
    { "type": "select", "id": "image_source", "label": "t:labels.collections_grid_image_source", "options": [{ "value": "collection", "label": "t:options.collections_grid_image_source.collection" }, { "value": "first_product", "label": "t:options.collections_grid_image_source.first_product" }], "default": "collection" },
    { "type": "select", "id": "image_ratio", "label": "t:labels.image_size", "options": [{ "value": "1 / 1", "label": "t:options.image_ratio.square" }, { "value": "2 / 1", "label": "t:options.image_ratio.wide" }, { "value": "4 / 5", "label": "t:options.image_ratio.portrait" }, { "value": "3 / 4", "label": "t:options.image_ratio.tall" }], "default": "4 / 5" },
    { "type": "range", "id": "card_title_font_size", "min": 12, "max": 32, "step": 1, "unit": "px", "label": "t:labels.card_title_size", "default": 20 },
    { "type": "select", "id": "item_style", "label": "t:labels.collections_grid_item_style", "options": [{ "value": "text_below", "label": "t:options.collections_grid_item_style.text_below" }, { "value": "overlay", "label": "t:options.collections_grid_item_style.overlay" }, { "value": "overlay_box", "label": "t:options.collections_grid_item_style.overlay_box" }], "default": "text_below" },
    { "type": "select", "id": "item_text_position", "label": "t:labels.text_position", "visible_if": "{{ section.settings.item_style != 'text_below' }}", "options": [{ "value": "top_left", "label": "t:options.content_position.top_left" }, { "value": "center_left", "label": "t:options.content_position.center_left" }, { "value": "bottom_left", "label": "t:options.content_position.bottom_left" }, { "value": "top_center", "label": "t:options.content_position.top_center" }, { "value": "center_center", "label": "t:options.content_position.center_center" }, { "value": "bottom_center", "label": "t:options.content_position.bottom_center" }, { "value": "top_right", "label": "t:options.content_position.top_right" }, { "value": "center_right", "label": "t:options.content_position.center_right" }, { "value": "bottom_right", "label": "t:options.content_position.bottom_right" }], "default": "bottom_left" }
  ],
  "blocks": [{ "type": "collection-card" }],
  "max_blocks": 8,
  "enabled_on": { "templates": ["index", "404"] },
  "presets": [
    {
      "name": "t:general.collection_list",
      "category": "Products & collections",
      "blocks": [
        { "type": "collection-card", "static": true, "id": "collection-card-1" },
        { "type": "collection-card", "static": true, "id": "collection-card-2" },
        { "type": "collection-card", "static": true, "id": "collection-card-3" },
        { "type": "collection-card", "static": true, "id": "collection-card-4" }
      ]
    }
  ]
}
{% endschema %}
