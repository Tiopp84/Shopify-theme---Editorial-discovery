{% liquid
  assign image_width = section.settings.image_width | default: 58
  assign text_width = 100 | minus: image_width
%}

<section class="material-craft full-width material-craft--media-{{ section.settings.media_position }} material-craft--heading-{{ section.settings.heading_size }} material-craft--text-align-{{ section.settings.text_alignment }} material-craft--text-{{ section.settings.text_position }} material-craft--text-size-{{ section.settings.text_size }}" data-aos-section style="--material-craft-background: {{ section.settings.background_color | default: '#F5F3EE' }}; --material-craft-color: {{ section.settings.text_color | default: '#1A1A1A' }}; --material-craft-image-height: {{ section.settings.image_height | default: 600 }}px; --material-craft-image-width: {{ image_width }}fr; --material-craft-text-width: {{ text_width }}fr;" {% if section.settings.heading != blank %}aria-labelledby="MaterialCraftHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="material-craft__images">
    {% for index in (1..2) %}
      {% assign image_key = 'image_' | append: index %}
      {% assign image = section.settings[image_key] %}
      <div class="material-craft__image material-craft__image--{{ index }}"{% unless request.visual_preview_mode %} data-aos="{% if index == 1 %}fade-right{% else %}fade-left{% endif %}"{% if index == 2 %} data-aos-delay="150"{% endif %}{% endunless %}>
        {% if image != blank %}
          {% render 'image', image: image, alt: image.alt, width: 1400, widths: '360, 540, 720, 960, 1200, 1400', sizes: '(min-width: 64rem) 32vw, 75vw' %}
        {% else %}
          <span class="material-craft__placeholder" aria-hidden="true">{{ 'lifestyle-' | append: index | placeholder_svg_tag }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  <div class="material-craft__content"{% unless request.visual_preview_mode %} data-aos="fade-left" data-aos-delay="250"{% endunless %}>
    {% if section.settings.eyebrow != blank %}<p class="material-craft__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 id="MaterialCraftHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="material-craft__text">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.link_label != blank and section.settings.link != blank %}<a class="material-craft__link button" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <span class="material-craft__link-arrow" aria-hidden="true">↗</span></a>{% endif %}
  </div>
</section>

{% stylesheet %}
  .material-craft { align-items: center; background: var(--material-craft-background, var(--color-background)); color: var(--material-craft-color, var(--color-foreground)); display: grid; gap: clamp(var(--space-6), 3vw, var(--space-12)); margin: 0 0 var(--space-chapter); padding-inline: max(var(--layout-gutter), calc((100vw - var(--layout-content-max)) / 2)); }
  .material-craft__images { align-items: end; block-size: var(--material-craft-image-height, 600px); display: grid; gap: var(--space-5); grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); }
  .material-craft__image { background: var(--color-panel-02); block-size: 100%; overflow: hidden; }
  .material-craft__image--2 { block-size: 68%; margin-block-end: 10%; }
  .material-craft__image .image, .material-craft__image .image > img, .material-craft__placeholder, .material-craft__placeholder svg { block-size: 100%; display: block; height: 100%; inline-size: 100%; object-fit: cover; width: 100%; }
  .material-craft__placeholder { background: var(--color-panel-02); color: color-mix(in srgb, var(--material-craft-color, var(--color-foreground)) 30%, var(--color-panel-02)); }
  .material-craft__content { display: grid; gap: var(--space-5); max-width: 22rem; }
  .material-craft__eyebrow { display: grid; font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 600; gap: var(--space-3); letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; text-transform: uppercase; }
  .material-craft__eyebrow::after { background: var(--color-border); content: ''; display: block; block-size: 1px; inline-size: var(--space-16); }
  .material-craft h2 { font-family: var(--font-campaign); font-size: clamp(var(--heading-size-102), 4vw, var(--heading-size-160)); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.04em; line-height: .96; margin: 0; max-inline-size: 11ch; }
  .material-craft--heading-small h2 { font-size: clamp(var(--heading-size-72), 3vw, var(--heading-size-112)); }
  .material-craft--heading-medium h2 { font-size: clamp(var(--heading-size-102), 4vw, var(--heading-size-160)); }
  .material-craft--heading-large h2 { font-size: clamp(var(--heading-size-128), 5.2vw, var(--heading-size-192)); }
  .material-craft--text-align-left .material-craft__content { text-align: start; }
  .material-craft--text-align-center .material-craft__content { text-align: center; }
  .material-craft--text-align-right .material-craft__content { text-align: end; }
  .material-craft--text-align-center .material-craft__eyebrow { justify-items: center; }
  .material-craft--text-align-right .material-craft__eyebrow { justify-items: end; }
  .material-craft__text { color: color-mix(in srgb, var(--material-craft-color, var(--color-foreground)) 78%, var(--material-craft-background, var(--color-background))); font-size: var(--body-text-base-size); line-height: calc(var(--body-text-line-spacing) + .1); max-inline-size: 20rem; }
  .material-craft--text-size-small .material-craft__text { font-size: calc(var(--body-text-base-size) * .9); }
  .material-craft--text-size-medium .material-craft__text { font-size: var(--body-text-base-size); }
  .material-craft--text-size-large .material-craft__text { font-size: calc(var(--body-text-base-size) * 1.08); }
  .material-craft__text > :first-child { margin-block-start: 0; }
  .material-craft__text > :last-child { margin-block-end: 0; }
  .material-craft__link { align-items: center; display: inline-flex; gap: var(--space-3); justify-self: start; text-decoration: none; }
  .material-craft__link-arrow { font-family: var(--font-commerce); font-size: 1.1em; line-height: 1; transition: transform 180ms ease; }
  .material-craft__link:is(:hover, :focus-visible) .material-craft__link-arrow { transform: translate(.2rem, -.2rem); }
  .material-craft--text-align-center .material-craft__link { justify-self: center; }
  .material-craft--text-align-right .material-craft__link { justify-self: end; }
  .material-craft--text-top .material-craft__content { align-self: start; }
  .material-craft--text-center .material-craft__content { align-self: center; }
  .material-craft--text-bottom .material-craft__content { align-self: end; }
  @media (min-width: 64rem) { .material-craft { grid-template-columns: minmax(0, var(--material-craft-image-width)) minmax(18rem, var(--material-craft-text-width)); } .material-craft--media-right { grid-template-columns: minmax(18rem, var(--material-craft-text-width)) minmax(0, var(--material-craft-image-width)); } .material-craft--media-right .material-craft__images { grid-column: 2; } .material-craft--media-right .material-craft__content { grid-column: 1; grid-row: 1; } }
  @media (min-width: 48rem) and (max-width: 63.99rem) { .material-craft { grid-template-columns: minmax(0, var(--material-craft-image-width)) minmax(17rem, var(--material-craft-text-width)); } .material-craft--media-right { grid-template-columns: minmax(17rem, var(--material-craft-text-width)) minmax(0, var(--material-craft-image-width)); } .material-craft--media-right .material-craft__images { grid-column: 2; } .material-craft--media-right .material-craft__content { grid-column: 1; grid-row: 1; } }
  @media (min-width: 48rem) {
    .material-craft--media-right .material-craft__images { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
    .material-craft--media-right .material-craft__image--1 { grid-column: 2; }
    .material-craft--media-right .material-craft__image--2 { grid-column: 1; grid-row: 1; }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) { .material-craft { gap: var(--space-8); } .material-craft__image--2 { margin-block-end: 8%; } }
  @media (max-width: 47.99rem) {
    .material-craft { gap: var(--space-8); margin-block-end: var(--space-chapter-mobile); padding-block: 0; }
    .material-craft__images { block-size: auto; gap: var(--space-4); grid-template-columns: minmax(0, 1fr); }
    .material-craft__image--1 { block-size: min(var(--material-craft-image-height, 600px), 120vw); }
    .material-craft__image--2 { block-size: min(var(--material-craft-image-height, 600px), 76vw); inline-size: 100%; margin: 0; }
    .material-craft__content { gap: var(--space-4); max-inline-size: 32rem; }
    .material-craft h2 { max-inline-size: 12ch; }
    html.aos-enabled .material-craft [data-aos='fade-right'], html.aos-enabled .material-craft [data-aos='fade-left'] { transform: translate3d(0, var(--space-8), 0); }
    html.aos-enabled .material-craft [data-aos^='fade'].aos-animate { transform: translate3d(0, 0, 0); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.material_craft",
  "settings": [
    { "type": "header", "content": "t:general.content" },
    { "type": "image_picker", "id": "image_1", "label": "t:labels.image_one" },
    { "type": "image_picker", "id": "image_2", "label": "t:labels.image_two" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Material note" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "The details make the difference" },
    { "type": "select", "id": "heading_size", "label": "t:labels.heading_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "medium" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Fabric, finish and proportion are considered together, so everyday pieces feel distinct without asking for attention.</p>" },
    { "type": "select", "id": "text_size", "label": "t:labels.text_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "medium" },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label" },
    { "type": "url", "id": "link", "label": "t:labels.link" },
    { "type": "header", "content": "t:general.layout" },
    { "type": "select", "id": "text_alignment", "label": "t:labels.text_alignment", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left" },
    { "type": "select", "id": "text_position", "label": "t:labels.vertical_content_position", "options": [{ "value": "top", "label": "t:options.vertical_alignment.top" }, { "value": "center", "label": "t:options.vertical_alignment.center" }, { "value": "bottom", "label": "t:options.vertical_alignment.bottom" }], "default": "center" },
    { "type": "range", "id": "image_width", "label": "t:labels.image_width", "min": 40, "max": 65, "step": 1, "unit": "%", "default": 58 },
    { "type": "range", "id": "image_height", "label": "t:labels.image_height", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 600 },
    { "type": "select", "id": "media_position", "label": "t:labels.media_position", "options": [{ "value": "left", "label": "t:options.position.left" }, { "value": "right", "label": "t:options.position.right" }], "default": "left" },
    { "type": "header", "content": "t:general.style" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "default": "#F5F3EE" },
    { "type": "color", "id": "text_color", "label": "t:labels.text_color", "default": "#1A1A1A" }
  ],
  "enabled_on": { "templates": ["index"] },
  "presets": [{ "name": "t:general.material_craft", "category": "Campaign & editorial" }]
}
{% endschema %}
