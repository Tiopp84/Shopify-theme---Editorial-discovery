{% liquid
  assign text_width = section.settings.text_width | default: 36
  assign products_width = 100 | minus: text_width
%}

<section class="shoppable-story full-width shoppable-story--intro-{{ section.settings.intro_position }} shoppable-story--heading-{{ section.settings.heading_size }} shoppable-story--text-align-{{ section.settings.text_alignment }} shoppable-story--text-size-{{ section.settings.text_size }}" data-aos-section style="--shoppable-story-background: {{ section.settings.background_color | default: '#EBE7DD' }}; --shoppable-story-color: {{ section.settings.text_color | default: '#1A1A1A' }}; --shoppable-story-image-ratio: {{ section.settings.image_ratio }}; --shoppable-story-text-width: {{ text_width }}fr; --shoppable-story-products-width: {{ products_width }}fr;" {% if section.settings.heading != blank %}aria-labelledby="ShoppableStoryHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="shoppable-story__intro"{% unless request.visual_preview_mode %} data-aos="fade-up-right"{% endunless %}>
    {% if section.settings.eyebrow != blank %}
      <p class="shoppable-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 id="ShoppableStoryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="shoppable-story__body rte">{{ section.settings.body }}</div>
    {% endif %}
  </div>

  <div class="shoppable-story__items" data-aos-trigger="early" role="list">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  .shoppable-story { background: var(--shoppable-story-background, var(--color-panel-01)); color: var(--shoppable-story-color, var(--color-foreground)); display: grid; gap: clamp(var(--space-12), 6vw, 6rem); margin: 0 0 var(--space-chapter); padding: clamp(var(--space-16), 8vw, 7rem) max(var(--layout-gutter), calc((100vw - var(--layout-content-max)) / 2)); }
  .shoppable-story__intro { align-content: center; display: grid; gap: var(--space-5); max-width: 26rem; }
  .shoppable-story__eyebrow, .shoppable-story__availability { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 600; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; text-transform: uppercase; }
  .shoppable-story__intro h2 { font-family: var(--font-campaign); font-size: clamp(var(--heading-size-102), 3.3vw, var(--heading-size-160)); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.03em; line-height: .98; margin: 0; overflow-wrap: anywhere; }
  .shoppable-story--heading-small .shoppable-story__intro h2 { font-size: clamp(var(--heading-size-72), 2.6vw, var(--heading-size-112)); }
  .shoppable-story--heading-medium .shoppable-story__intro h2 { font-size: clamp(var(--heading-size-102), 3.3vw, var(--heading-size-160)); }
  .shoppable-story--heading-large .shoppable-story__intro h2 { font-size: clamp(var(--heading-size-128), 4.2vw, var(--heading-size-192)); }
  .shoppable-story--text-align-left .shoppable-story__intro { text-align: start; }
  .shoppable-story--text-align-center .shoppable-story__intro { text-align: center; }
  .shoppable-story--text-align-right .shoppable-story__intro { text-align: end; }
  .shoppable-story__body { color: color-mix(in srgb, var(--shoppable-story-color, var(--color-foreground)) 78%, var(--shoppable-story-background, var(--color-background))); font-size: var(--body-text-base-size); line-height: calc(var(--body-text-line-spacing) + .05); max-width: 30rem; }
  .shoppable-story--text-size-small .shoppable-story__body { font-size: calc(var(--body-text-base-size) * .9); }
  .shoppable-story--text-size-medium .shoppable-story__body { font-size: var(--body-text-base-size); }
  .shoppable-story--text-size-large .shoppable-story__body { font-size: calc(var(--body-text-base-size) * 1.08); }
  .shoppable-story__body > :first-child { margin-block-start: 0; }
  .shoppable-story__body > :last-child { margin-block-end: 0; }
  .shoppable-story__items { counter-reset: shoppable-story; display: grid; gap: var(--space-8); margin: 0; padding-inline-start: 0; }
  .shoppable-story__item { counter-increment: shoppable-story; list-style: none; min-width: 0; }
  .shoppable-story__product { display: grid; gap: var(--space-5); min-width: 0; }
  .shoppable-story__media { aspect-ratio: var(--shoppable-story-image-ratio, 4 / 5); background: var(--color-panel-02); display: block; overflow: hidden; }
  .shoppable-story__image, .shoppable-story__image > img, .shoppable-story__placeholder, .shoppable-story__placeholder > svg { block-size: 100%; display: block; height: 100%; inline-size: 100%; object-fit: cover; width: 100%; }
  .shoppable-story__image > img { transition: transform 300ms ease; }
  .shoppable-story__product-content { display: grid; gap: var(--space-3); }
  .shoppable-story__caption { align-items: baseline; border-block-end: 1px solid color-mix(in srgb, var(--shoppable-story-color, var(--color-foreground)) 36%, transparent); display: flex; font-family: var(--small-label-font); font-size: var(--small-label-size); font-style: normal; font-weight: 600; gap: var(--space-2); letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; padding-block-end: var(--space-2); width: fit-content; }
  .shoppable-story__index::before { content: counter(shoppable-story, decimal-leading-zero); }
  .shoppable-story__decision { display: block; }
  .shoppable-story__decision h3 { font-family: var(--font-campaign); font-size: clamp(var(--heading-size-56), 2.2vw, var(--heading-size-86)); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); line-height: 1.08; margin: 0; min-width: 0; }
  .shoppable-story__preview-title { font-family: var(--font-campaign); font-size: clamp(var(--heading-size-56), 2.2vw, var(--heading-size-86)); font-style: var(--font-heading--style); line-height: 1.08; margin: 0; }
  .shoppable-story__preview-price { justify-self: end; white-space: nowrap; }
  .shoppable-story__decision h3 a { color: currentcolor; text-decoration: none; }
  .shoppable-story__decision h3 a::after { content: '↗'; display: inline-block; font-family: var(--font-commerce); font-size: .72em; margin-inline-start: var(--space-2); transition: transform 180ms ease; vertical-align: .1em; }
  .shoppable-story__decision h3 a:is(:hover, :focus-visible) { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .16em; }
  .shoppable-story__decision h3 a:is(:hover, :focus-visible)::after { transform: translate(.14rem, -.14rem); }
  .shoppable-story__price { justify-content: start; padding: 0; text-align: start; white-space: nowrap; }
  .shoppable-story__color-options, .shoppable-story__size-options { align-items: baseline; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .shoppable-story__color-label, .shoppable-story__size-label { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 600; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); text-transform: uppercase; }
  .shoppable-story__color-names { font-size: calc(var(--body-text-base-size) * .88); line-height: 1.35; }
  .shoppable-story__size-names { font-size: calc(var(--body-text-base-size) * .88); line-height: 1.35; }
  .shoppable-story__swatches { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: 0; }
  .shoppable-story__swatch { background: var(--shoppable-story-swatch); background-position: center; background-size: cover; border: 1px solid color-mix(in srgb, var(--shoppable-story-color, var(--color-foreground)) 32%, transparent); border-radius: 50%; block-size: 1.375rem; display: block; inline-size: 1.375rem; }
  .shoppable-story__availability { color: var(--shoppable-story-color, var(--color-foreground)); }
  @media (min-width: 64rem) {
    .shoppable-story { align-items: start; grid-template-columns: minmax(15rem, var(--shoppable-story-text-width)) minmax(0, var(--shoppable-story-products-width)); }
    .shoppable-story__intro { align-self: start; block-size: fit-content; padding-block-start: var(--space-8); position: sticky; top: calc(var(--announcement-bar-height, 0px) + 6rem); }
    .shoppable-story__items { gap: var(--space-8); }
    .shoppable-story__item { border-block-end: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent); padding-block-end: var(--space-8); }
    .shoppable-story__product { align-items: start; gap: clamp(var(--space-5), 3vw, var(--space-12)); grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr); }
    .shoppable-story__media { grid-row: 1; }
    .shoppable-story__product-content { gap: var(--space-3); padding-block-start: var(--space-2); }
    .shoppable-story__decision { gap: var(--space-4); }
    .shoppable-story--intro-right { grid-template-columns: minmax(0, var(--shoppable-story-products-width)) minmax(15rem, var(--shoppable-story-text-width)); }
    .shoppable-story--intro-right .shoppable-story__intro { grid-column: 2; }
    .shoppable-story--intro-right .shoppable-story__items { grid-column: 1; grid-row: 1; }
    @supports selector(.shoppable-story:has(.shoppable-story__item)) {
      .shoppable-story:not(:has(.shoppable-story__item)) { grid-template-columns: minmax(0, 1fr); }
    }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .shoppable-story { align-items: stretch; grid-template-columns: minmax(13rem, var(--shoppable-story-text-width)) minmax(0, var(--shoppable-story-products-width)); }
    .shoppable-story__intro { align-self: center; max-inline-size: 18rem; }
    .shoppable-story__items { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
    .shoppable-story--intro-right { grid-template-columns: minmax(0, var(--shoppable-story-products-width)) minmax(13rem, var(--shoppable-story-text-width)); }
    .shoppable-story--intro-right .shoppable-story__intro { grid-column: 2; }
    .shoppable-story--intro-right .shoppable-story__items { grid-column: 1; grid-row: 1; }
  }
  @media (max-width: 47.99rem) {
    .shoppable-story { gap: var(--space-8); margin-block-end: var(--space-chapter-mobile); padding: var(--space-chapter-mobile) var(--layout-gutter); }
    .shoppable-story__intro { border-block-end: 1px solid var(--color-border); gap: var(--space-4); max-width: none; padding-block-end: var(--space-8); }
    .shoppable-story__items { gap: var(--space-6); }
    .shoppable-story__item { border-block-end: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent); padding-block-end: var(--space-6); }
    .shoppable-story__product { gap: var(--space-4); }
    .shoppable-story__media { grid-row: auto; }
    .shoppable-story__product-content { gap: var(--space-3); }
    .shoppable-story__decision { gap: var(--space-2); }
    .shoppable-story__decision h3 { font-size: clamp(var(--heading-size-56), 7vw, var(--heading-size-72)); }
    .shoppable-story__price { font-size: calc(var(--body-text-base-size) * .94); }
    .shoppable-story__color-options, .shoppable-story__size-options { gap: var(--space-2); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.shoppable_story",
  "settings": [
    { "type": "header", "content": "t:general.content" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "The story" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Pieces composed for a day in motion" },
    { "type": "select", "id": "heading_size", "label": "t:labels.heading_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "medium" },
    { "type": "richtext", "id": "body", "label": "t:labels.text", "default": "<p>Each piece is available independently. Follow the product link to choose the right option.</p>" },
    { "type": "select", "id": "text_size", "label": "t:labels.text_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "medium" },
    { "type": "header", "content": "t:general.layout" },
    { "type": "select", "id": "text_alignment", "label": "t:labels.text_alignment", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left" },
    { "type": "select", "id": "intro_position", "label": "t:labels.text_position", "options": [{ "value": "left", "label": "t:options.position.left" }, { "value": "right", "label": "t:options.position.right" }], "default": "left" },
    { "type": "range", "id": "text_width", "label": "t:labels.text_width", "min": 25, "max": 45, "step": 1, "unit": "%", "default": 36 },
    { "type": "select", "id": "image_ratio", "label": "t:labels.image_size", "options": [{ "value": "1 / 1", "label": "t:options.image_ratio.square" }, { "value": "4 / 5", "label": "t:options.image_ratio.portrait" }, { "value": "3 / 4", "label": "t:options.image_ratio.tall" }], "default": "4 / 5" },
    { "type": "checkbox", "id": "show_variants", "label": "t:labels.show_variants", "default": true },
    { "type": "header", "content": "t:general.style" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "default": "#EBE7DD" },
    { "type": "color", "id": "text_color", "label": "t:labels.text_color", "default": "#1A1A1A" }
  ],
  "blocks": [{ "type": "story-product" }],
  "max_blocks": 8,
  "enabled_on": { "templates": ["index"] },
  "presets": [{ "name": "t:general.shoppable_story", "category": "Shop the story", "blocks": [{ "type": "story-product" }, { "type": "story-product" }, { "type": "story-product" }] }]
}
{% endschema %}
