{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<section class="recovery-page recovery-page--not-found" aria-labelledby="NotFoundTitle-{{ section.id }}">
  <div class="recovery-page__inner">
    <p class="recovery-page__eyebrow">{{ '404.title' | t }}</p>
    <h1 id="NotFoundTitle-{{ section.id }}">{{ '404.not_found' | t }}</h1>
    <p class="recovery-page__message">{{ '404.message' | t }}</p>
    <a class="button recovery-page__action" href="{{ routes.all_products_collection_url }}">
      {{ '404.back_to_shopping' | t }}
    </a>
  </div>
</section>

{% stylesheet %}
  .recovery-page { display: grid; min-block-size: min(34rem, calc(100dvh - 10rem)); padding: clamp(3rem, 8vw, 7rem) var(--page-gutter); place-items: center; }
  .recovery-page__inner { max-inline-size: 38rem; text-align: center; }
  .recovery-page__eyebrow { color: var(--color-foreground); font-size: .75rem; font-weight: 700; letter-spacing: .12em; margin: 0 0 var(--space-3); text-transform: uppercase; }
  .recovery-page h1 { font-family: var(--font-commerce); font-size: clamp(2.4rem, 7vw, 5.5rem); font-style: normal; font-weight: 500; letter-spacing: -.055em; line-height: .95; margin: 0; }
  .recovery-page__message { color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background)); line-height: 1.6; margin: var(--space-4) auto 0; max-inline-size: 31rem; }
  .recovery-page__action { display: inline-flex; margin-block-start: var(--space-5); text-decoration: none; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": [],
  "enabled_on": { "templates": ["404"] }
}
{% endschema %}
