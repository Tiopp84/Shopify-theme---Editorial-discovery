{% liquid
  assign brand_name = settings.brand_name | default: shop.name
  assign show_localization = false
  if section.settings.show_country_selector and localization.available_countries.size > 1
    assign show_localization = true
  elsif section.settings.show_language_selector and localization.available_languages.size > 1
    assign show_localization = true
  endif
%}

<footer
  class="footer full-width footer--spacing-{{ section.settings.footer_spacing }}"
  style="--footer-background: {{ settings.footer_background_color }}; --footer-color: {{ settings.footer_text_color }}; --footer-base-background: color-mix(in srgb, {{ settings.footer_background_color }} 86%, #000);"
  {% if section.settings.enable_panel_transition != false %}data-footer-panel{% endif %}
  {{ section.shopify_attributes }}
>
  <div class="footer__content">
    <div class="footer__main">
      <div class="footer__brand-block">
        {% content_for 'block', type: '_footer-brand', id: 'footer-brand' %}
      </div>

      <div class="footer__menu-row">
        {% content_for 'block', type: '_footer-menu', id: 'footer-menu-1' %}
        {% content_for 'block', type: '_footer-menu', id: 'footer-menu-2' %}
        {% content_for 'block', type: '_footer-menu', id: 'footer-menu-3' %}
      </div>

      <div class="footer__newsletter-block">
        {% content_for 'block', type: '_newsletter', id: 'footer-newsletter' %}
      </div>

      <div class="footer__follow-block">
        {% content_for 'block', type: '_footer-follow-on-shop', id: 'footer-follow-on-shop' %}
      </div>

      <div class="footer__legal-block">
        {% content_for 'block', type: '_footer-legal', id: 'footer-legal' %}
      </div>
    </div>
  </div>

  {% if show_localization or section.settings.show_copyright or section.settings.show_payment_icons and shop.enabled_payment_types != empty %}
  <div class="footer__base">
    <div class="footer__base-content">
      {% if show_localization %}
        <div class="footer__localization">
          {% if section.settings.show_country_selector and localization.available_countries.size > 1 %}
            {% form 'localization', class: 'footer__localization-form' %}
              <label for="FooterCountry-{{ section.id }}">{{ 'localization.country' | t }}</label>
              <select id="FooterCountry-{{ section.id }}" name="country_code" onchange="this.form.submit()">
                {% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>{% endfor %}
              </select>
            {% endform %}
          {% endif %}
          {% if section.settings.show_language_selector and localization.available_languages.size > 1 %}
            {% form 'localization', class: 'footer__localization-form' %}
              <label for="FooterLanguage-{{ section.id }}">{{ 'localization.language' | t }}</label>
              <select id="FooterLanguage-{{ section.id }}" name="locale_code" onchange="this.form.submit()">
                {% for language in localization.available_languages %}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>{% endfor %}
              </select>
            {% endform %}
          {% endif %}
        </div>
      {% else %}<span></span>{% endif %}
      {% if section.settings.show_copyright %}<p>&copy; {{ 'now' | date: '%Y' }} {{ brand_name | link_to: routes.root_url }}</p>{% endif %}
      {% if section.settings.show_payment_icons and shop.enabled_payment_types != empty %}
        <ul class="footer__payment" role="list" aria-label="{{ 'accessibility.payment_methods' | t }}">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>
      {% else %}<span></span>{% endif %}
    </div>
  </div>
  {% endif %}
</footer>

{% stylesheet %}
  .footer { background: var(--footer-background, var(--color-foreground)); color: var(--footer-color, var(--color-background)); margin-block-start: var(--space-8); }
  @media (max-width: 63.99rem) { .footer { padding-block-end: calc(5.75rem + env(safe-area-inset-bottom)); } }
  .footer-panel-spacer { display: none; }
  html.footer-panel-ready .footer-panel-spacer { display: block; block-size: var(--footer-panel-height, 0px); }
  html.footer-panel-ready .site-panel { border-end-end-radius: calc(var(--footer-panel-edge-progress, 0) * 2rem); border-end-start-radius: calc(var(--footer-panel-edge-progress, 0) * 2rem); box-sizing: border-box; min-block-size: 100vh; padding-block-end: clamp(3.5rem, 7vw, 6.5rem); }
  html.footer-panel-ready .footer[data-footer-panel] { filter: blur(var(--footer-panel-footer-blur, 0px)) brightness(var(--footer-panel-footer-brightness, 1)); inset: auto 0 0; margin-block-start: 0; position: fixed; transform: translate3d(0, var(--footer-panel-footer-offset, 0px), 0); z-index: 0; }
  @media (min-width: 64rem) { html.footer-panel-ready .site-panel[data-footer-panel-active] { overflow: clip; will-change: border-radius; } }
  .footer__content { margin-inline: auto; padding: clamp(1.75rem, 3vw, 2.5rem) max(var(--layout-gutter), 2rem) 1.125rem; width: min(100%, var(--layout-content-max)); }
  .footer--spacing-compact .footer__content { padding-block: 1.25rem .875rem; }
  .footer--spacing-spacious .footer__content { padding-block: clamp(2.5rem, 4vw, 3.25rem) 1.5rem; }
  .footer__main { display: grid; gap: 1.125rem clamp(1.25rem, 2.5vw, 2.25rem); grid-template-columns: minmax(12rem, 1.5fr) repeat(3, minmax(7rem, .65fr)); }
  .footer__brand-block { grid-column: 1; grid-row: 1; }
  .footer__menu-row { display: grid; gap: inherit; grid-column: 2 / -1; grid-row: 1; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .footer .footer-menu h2, .footer .newsletter h2 { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin-block: 0 var(--space-4); text-transform: uppercase; }
  .footer .footer-menu ul { gap: .65rem; }
  .footer .footer-menu a, .footer .footer-legal a { color: color-mix(in srgb, var(--footer-color, var(--color-background)) 76%, transparent); font-size: .75rem; overflow-wrap: anywhere; text-decoration: none; transition: color 160ms ease; }
  .footer .footer-menu a:is(:hover, :focus-visible), .footer .footer-legal a:is(:hover, :focus-visible) { color: var(--color-interactive); }
  .footer__newsletter-block { grid-column: 1 / span 2; grid-row: 2; max-inline-size: 34rem; }
  .footer__follow-block { align-self: end; grid-column: 3 / -1; grid-row: 2; justify-self: end; }
  .footer__legal-block { grid-column: 1 / -1; grid-row: 3; }
  .footer__localization { align-items: start; display: flex; flex-wrap: wrap; gap: var(--space-4); transform: translateY(-.25rem); }
  .footer__localization-form { display: grid; font-family: var(--small-label-font); font-size: var(--small-label-size); gap: var(--space-2); letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); }
  .footer__localization select { background: transparent; border-color: color-mix(in srgb, var(--footer-color, var(--color-background)) 28%, transparent); color: inherit; font-size: .75rem; }
  .footer__localization select option { background-color: var(--footer-background, var(--color-foreground)); color: var(--footer-color, var(--color-background)); }
  .footer__base { background: var(--footer-base-background, color-mix(in srgb, var(--footer-background, var(--color-foreground)) 78%, #000)); }
  .footer__base-content { align-items: center; color: color-mix(in srgb, var(--footer-color, var(--color-background)) 58%, transparent); display: grid; gap: var(--space-3); grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); margin-inline: auto; padding: .75rem max(var(--layout-gutter), 2rem); width: min(100%, var(--layout-content-max)); }
  .footer__base p { font-size: .6875rem; margin: 0; }
  .footer__base p a { color: inherit; text-decoration: none; }
  .footer__payment { display: flex; flex-wrap: wrap; gap: var(--space-2); justify-self: end; list-style: none; margin: 0; padding: 0; }
  .footer__payment svg { block-size: 1.25rem; inline-size: auto; }
  @media (max-width: 47.99rem) {
    .footer__main { column-gap: .75rem; grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.25rem; }
    .footer__brand-block { grid-column: 1 / -1; grid-row: 1; }
    .footer__menu-row { grid-column: 1 / -1; grid-row: 2; }
    .footer .footer-menu h2 { font-size: .6rem; letter-spacing: .09em; margin-block-end: .625rem; }
    .footer .footer-menu ul { gap: .45rem; }
    .footer .footer-menu a { font-size: .625rem; line-height: 1.35; }
    .footer__newsletter-block, .footer__follow-block, .footer__legal-block { grid-column: 1 / -1; grid-row: auto; justify-self: stretch; }
  }
  @media (max-width: 30rem) { .footer__content { padding-inline: var(--layout-gutter); } .footer__main { grid-template-columns: repeat(3, minmax(0, 1fr)); } .footer__base-content { grid-template-columns: 1fr; justify-items: start; padding-inline: var(--layout-gutter); } .footer__base-content p, .footer__payment { justify-self: start; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "blocks": [
    { "type": "_footer-brand" },
    { "type": "_footer-menu" },
    { "type": "_newsletter" },
    { "type": "_footer-legal" },
    { "type": "_footer-follow-on-shop" }
  ],
  "settings": [
    { "type": "header", "content": "t:labels.footer_style" },
    { "type": "select", "id": "footer_spacing", "label": "t:labels.footer_spacing", "options": [{ "value": "compact", "label": "t:options.spacing.compact" }, { "value": "standard", "label": "t:options.spacing.standard" }, { "value": "spacious", "label": "t:options.spacing.spacious" }], "default": "standard" },
    { "type": "header", "content": "t:labels.footer_utilities" },
    { "type": "checkbox", "id": "show_copyright", "label": "t:labels.show_copyright", "default": true },
    { "type": "checkbox", "id": "show_country_selector", "label": "t:labels.show_country_selector", "default": true },
    { "type": "checkbox", "id": "show_language_selector", "label": "t:labels.show_language_selector", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": true },
    { "type": "checkbox", "id": "enable_panel_transition", "label": "t:labels.enable_footer_panel_transition", "default": true }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
