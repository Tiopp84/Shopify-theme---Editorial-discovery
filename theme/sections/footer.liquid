<footer class="footer full-width">
  <div class="footer__content">
    <div class="footer__blocks">
      {% content_for 'blocks' %}
    </div>

    {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
      <div class="footer__localization">
        {% if localization.available_countries.size > 1 %}
          {% form 'localization', class: 'footer__localization-form' %}
            <label for="FooterCountry-{{ section.id }}">{{ 'localization.country' | t }}</label>
            <select id="FooterCountry-{{ section.id }}" name="country_code" onchange="this.form.submit()">
              {% for country in localization.available_countries %}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {% endfor %}
            </select>
          {% endform %}
        {% endif %}

        {% if localization.available_languages.size > 1 %}
          {% form 'localization', class: 'footer__localization-form' %}
            <label for="FooterLanguage-{{ section.id }}">{{ 'localization.language' | t }}</label>
            <select id="FooterLanguage-{{ section.id }}" name="locale_code" onchange="this.form.submit()">
              {% for language in localization.available_languages %}
                <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                  {{ language.endonym_name }}
                </option>
              {% endfor %}
            </select>
          {% endform %}
        {% endif %}
      </div>
    {% endif %}

    <div class="footer__base">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</p>

      {% if section.settings.show_payment_icons and shop.enabled_payment_types != empty %}
        <ul class="footer__payment" role="list" aria-label="{{ 'accessibility.payment_methods' | t }}">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    margin-block-start: var(--space-8);
    border-block-start: 1px solid var(--color-border);
  }

  .footer__content {
    width: min(calc(100% - var(--page-margin) * 2), var(--page-width));
    margin-inline: auto;
    padding-block: clamp(var(--space-8), 8vw, 6rem) var(--space-6);
  }

  .footer__blocks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: clamp(var(--space-6), 5vw, 4rem);
  }

  .footer__localization {
    margin-block-start: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer__localization-form {
    display: grid;
    gap: var(--space-2);
  }

  .footer__base {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .footer__payment {
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  @media (max-width: 40rem) {
    .footer__base {
      align-items: flex-start;
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "blocks": [
    { "type": "@theme" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
