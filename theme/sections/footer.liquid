{% liquid
  assign brand_name = settings.brand_name | default: shop.name
  assign footer_logo_width = section.settings.logo_width | times: 2
  assign has_footer_menu = false
  for block in section.blocks
    if block.type == 'footer-menu' and block.settings.menu != blank
      assign has_footer_menu = true
      break
    endif
  endfor
%}

<footer
  class="footer full-width footer--spacing-{{ section.settings.footer_spacing }}{% unless has_footer_menu %} footer--without-menu{% endunless %}{% unless section.settings.show_newsletter_copy %} footer--newsletter-copy-hidden{% endunless %}"
  style="--footer-background: {{ settings.footer_background_color }}; --footer-color: {{ settings.footer_text_color }}; --footer-base-background: color-mix(in srgb, {{ settings.footer_background_color }} 86%, #000);"
  {% if section.settings.enable_panel_transition != false %}data-footer-panel{% endif %}
  {{ section.shopify_attributes }}
>
  <div class="footer__content">
    <div class="footer__layout">
      <div class="footer__brand">
        <a class="footer__brand-mark" href="{{ routes.root_url }}">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo | image_url: width: footer_logo_width | image_tag: widths: '120, 180, 240, 320', width: section.settings.logo_width, alt: brand_name }}
          {% else %}
            <span>{{ brand_name | escape }}</span>
          {% endif %}
        </a>
        {% if section.settings.brand_description != blank %}
          <div class="footer__brand-description">{{ section.settings.brand_description }}</div>
        {% endif %}
      </div>

      <div class="footer__blocks">
        {% content_for 'blocks' %}
      </div>

      {% if section.settings.show_social %}
        <div class="footer__aside">
          {% assign social_platforms = 'instagram,threads,facebook,x,pinterest,youtube,tiktok,snapchat,tumblr,linkedin,vimeo' | split: ',' %}
          {% assign social_link_count = 0 %}
          {% capture social_links %}
            {% for platform in social_platforms %}
              {% assign setting_id = 'social_' | append: platform %}
              {% assign social_url = settings[setting_id] %}
              {% if social_url != blank %}
                {% assign social_link_count = social_link_count | plus: 1 %}
                {% assign social_translation_key = 'social.' | append: platform %}
                <li><a href="{{ social_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ social_translation_key | t }}">{% render 'social-icon', name: platform %}</a></li>
              {% endif %}
            {% endfor %}
          {% endcapture %}
          {% if social_link_count > 0 %}
            <nav class="footer__social" aria-label="{{ section.settings.social_heading | escape }}">
              {% if section.settings.social_heading != blank %}<h2>{{ section.settings.social_heading | escape }}</h2>{% endif %}
              <ul role="list">{{ social_links }}</ul>
            </nav>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
      <div class="footer__localization">
        {% if localization.available_countries.size > 1 %}
          {% form 'localization', class: 'footer__localization-form' %}
            <label for="FooterCountry-{{ section.id }}">{{ 'localization.country' | t }}</label>
            <select id="FooterCountry-{{ section.id }}" name="country_code" onchange="this.form.submit()">
              {% for country in localization.available_countries %}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
              {% endfor %}
            </select>
          {% endform %}
        {% endif %}
        {% if localization.available_languages.size > 1 %}
          {% form 'localization', class: 'footer__localization-form' %}
            <label for="FooterLanguage-{{ section.id }}">{{ 'localization.language' | t }}</label>
            <select id="FooterLanguage-{{ section.id }}" name="locale_code" onchange="this.form.submit()">
              {% for language in localization.available_languages %}
                <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>
              {% endfor %}
            </select>
          {% endform %}
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="footer__base">
    <div class="footer__base-content">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ brand_name | link_to: routes.root_url }}</p>
      {% if section.settings.legal_menu != blank %}
        <nav class="footer__legal" aria-label="{{ 'accessibility.footer_navigation' | t }}">
          <ul role="list">{% for link in section.settings.legal_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>
        </nav>
      {% endif %}
      {% if section.settings.show_payment_icons and shop.enabled_payment_types != empty %}
        <ul class="footer__payment" role="list" aria-label="{{ 'accessibility.payment_methods' | t }}">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer { background: var(--footer-background, var(--color-foreground)); color: var(--footer-color, var(--color-background)); margin-block-start: var(--space-8); }
  @media (max-width: 63.99rem) { .footer { padding-block-end: calc(5.75rem + env(safe-area-inset-bottom)); } }
  .footer-panel-spacer { display: none; }
  html.footer-panel-ready .footer-panel-spacer { display: block; block-size: var(--footer-panel-height, 0px); }
  html.footer-panel-ready .site-panel { border-end-end-radius: calc(var(--footer-panel-edge-progress, 0) * 2rem); border-end-start-radius: calc(var(--footer-panel-edge-progress, 0) * 2rem); box-sizing: border-box; min-block-size: 100vh; padding-block-end: clamp(3.5rem, 7vw, 6.5rem); }
  html.footer-panel-ready .footer[data-footer-panel] { filter: blur(var(--footer-panel-footer-blur, 0px)) brightness(var(--footer-panel-footer-brightness, 1)); inset: auto 0 0; margin-block-start: 0; position: fixed; transform: translate3d(0, var(--footer-panel-footer-offset, 0px), 0); z-index: 0; }
  @media (min-width: 64rem) { html.footer-panel-ready .site-panel[data-footer-panel-active] { overflow: clip; will-change: border-radius; } }
  .footer__content { margin-inline: auto; padding: clamp(3rem, 4vw, 4rem) max(var(--layout-gutter), 2rem) 2rem; width: min(100%, var(--layout-content-max)); }
  .footer--spacing-compact .footer__content { padding-block: 2.5rem 1.5rem; }
  .footer--spacing-spacious .footer__content { padding-block: clamp(4rem, 6vw, 5.5rem) 3rem; }
  .footer__layout { display: grid; gap: clamp(2rem, 3.5vw, 3.75rem); grid-template-columns: minmax(0, .9fr) minmax(0, 1.55fr) minmax(11rem, .8fr); }
  .footer--without-menu .footer__layout { grid-template-columns: minmax(10rem, .8fr) minmax(17rem, 1.15fr) minmax(10rem, .8fr); }
  .footer__brand { display: grid; align-content: start; gap: var(--space-5); }
  .footer__brand-mark { color: inherit; font-size: 1rem; font-weight: 700; letter-spacing: -.03em; line-height: 1; text-decoration: none; }
  .footer__brand-mark img { block-size: auto; display: block; max-inline-size: 100%; }
  .footer__brand-description { color: color-mix(in srgb, var(--footer-color, var(--color-background)) 62%, transparent); font-size: .8125rem; line-height: calc(var(--body-text-line-spacing) + .15); max-inline-size: 17rem; }
  .footer__brand-description > :first-child { margin-block-start: 0; }
  .footer__brand-description > :last-child { margin-block-end: 0; }
  .footer__blocks { display: grid; gap: clamp(2rem, 4vw, 4rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); }
  .footer .footer-menu h2, .footer .newsletter h2, .footer__aside h2 { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin-block: 0 var(--space-4); text-transform: uppercase; }
  .footer .footer-menu ul { gap: .65rem; }
  .footer .footer-menu a, .footer__legal a { color: color-mix(in srgb, var(--footer-color, var(--color-background)) 76%, transparent); font-size: .75rem; text-decoration: none; transition: color 160ms ease; }
  .footer .footer-menu a:is(:hover, :focus-visible), .footer__legal a:is(:hover, :focus-visible) { color: var(--color-interactive); }
  .footer .newsletter { max-inline-size: 18rem; }
  .footer .newsletter__text { color: color-mix(in srgb, var(--footer-color, var(--color-background)) 62%, transparent); font-size: .75rem; line-height: calc(var(--body-text-line-spacing) + .05); }
  .footer--newsletter-copy-hidden .newsletter__text { display: none; }
  .footer .newsletter__form input { background: color-mix(in srgb, var(--footer-color, var(--color-background)) 9%, transparent); border-color: color-mix(in srgb, var(--footer-color, var(--color-background)) 20%, transparent); color: var(--footer-color, var(--color-background)); font-size: .75rem; min-block-size: var(--field-theme-height); }
  .footer .newsletter__form input::placeholder { color: color-mix(in srgb, var(--footer-color, var(--color-background)) 48%, transparent); }
  .footer .newsletter__form button { min-block-size: var(--button-theme-height); padding-inline: clamp(.75rem, 6cqi, var(--button-theme-padding-inline)); }
  .footer__aside { align-content: start; display: grid; gap: var(--space-7); }
  .footer__social ul { display: flex; flex-wrap: wrap; gap: .45rem; list-style: none; margin: 0; padding: 0; }
  .footer__social a { align-items: center; border: 1px solid color-mix(in srgb, var(--footer-color, var(--color-background)) 26%, transparent); color: inherit; display: inline-flex; font-size: .625rem; font-weight: 700; height: 1.9rem; justify-content: center; text-decoration: none; transition: background 160ms ease, color 160ms ease, border-color 160ms ease; width: 1.9rem; }
  .footer__social .social-icon { block-size: 1rem; fill: currentcolor; inline-size: 1rem; }
  .footer__social a:is(:hover, :focus-visible) { background: var(--color-interactive); border-color: var(--color-interactive); color: var(--footer-background, var(--color-foreground)); }
  .footer__localization { border-block-start: 1px solid color-mix(in srgb, var(--footer-color, var(--color-background)) 18%, transparent); display: flex; flex-wrap: wrap; gap: var(--space-4); margin-block-start: 2.25rem; padding-block-start: 1.25rem; }
  .footer__localization-form { display: grid; font-family: var(--small-label-font); font-size: var(--small-label-size); gap: var(--space-2); letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); }
  .footer__localization select { background: transparent; border-color: color-mix(in srgb, var(--footer-color, var(--color-background)) 28%, transparent); color: inherit; font-size: .75rem; }
  .footer__localization select option { background-color: var(--footer-background, var(--color-foreground)); color: var(--footer-color, var(--color-background)); }
  .footer__base { background: var(--footer-base-background, color-mix(in srgb, var(--footer-background, var(--color-foreground)) 78%, #000)); }
  .footer__base-content { align-items: center; color: color-mix(in srgb, var(--footer-color, var(--color-background)) 58%, transparent); display: flex; flex-wrap: wrap; gap: var(--space-4); justify-content: space-between; margin-inline: auto; padding: 1.15rem max(var(--layout-gutter), 2rem); width: min(100%, var(--layout-content-max)); }
  .footer__base p { font-size: .6875rem; margin: 0; }
  .footer__base p a { color: inherit; text-decoration: none; }
  .footer__legal ul, .footer__payment { display: flex; flex-wrap: wrap; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
  .footer__payment { gap: var(--space-2); }
  .footer__payment svg { block-size: 1.25rem; inline-size: auto; }
  @media (max-width: 56rem) { .footer__layout, .footer--without-menu .footer__layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); } .footer__aside { grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .footer__content { padding-inline: var(--layout-gutter); } .footer__layout, .footer--without-menu .footer__layout, .footer__aside, .footer__blocks { grid-template-columns: minmax(0, 1fr); } .footer__base-content { align-items: flex-start; flex-direction: column; padding-inline: var(--layout-gutter); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "blocks": [{ "type": "newsletter" }, { "type": "footer-menu" }],
  "settings": [
    { "type": "header", "content": "t:labels.footer_brand" },
    { "type": "image_picker", "id": "logo", "label": "t:labels.logo" },
    { "type": "range", "id": "logo_width", "label": "t:labels.logo_width", "min": 60, "max": 240, "step": 10, "unit": "px", "default": 120 },
    { "type": "richtext", "id": "brand_description", "label": "t:labels.brand_description" },
    { "type": "header", "content": "t:labels.footer_content" },
    { "type": "checkbox", "id": "show_newsletter_copy", "label": "t:labels.show_newsletter_copy", "default": false },
    { "type": "checkbox", "id": "show_social", "label": "t:labels.show_social", "default": true },
    { "type": "text", "id": "social_heading", "label": "t:labels.social_heading", "default": "Follow us" },
    { "type": "link_list", "id": "legal_menu", "label": "t:labels.legal_menu" },
    { "type": "header", "content": "t:labels.footer_style" },
    { "type": "select", "id": "footer_spacing", "label": "t:labels.footer_spacing", "options": [{ "value": "compact", "label": "t:options.spacing.compact" }, { "value": "standard", "label": "t:options.spacing.standard" }, { "value": "spacious", "label": "t:options.spacing.spacious" }], "default": "standard" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": true },
    { "type": "checkbox", "id": "enable_panel_transition", "label": "t:labels.enable_footer_panel_transition", "default": true }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
