<section class="faq faq--layout-{{ section.settings.layout_style }} faq--style-{{ section.settings.item_style }}{% unless section.settings.show_heading %} faq--heading-hidden{% endunless %}{% unless section.settings.show_numbers %} faq--without-numbers{% endunless %}"{% if section.settings.show_heading %} aria-labelledby="FaqTitle-{{ section.id }}"{% else %} aria-label="{{ 'faq.title' | t }}"{% endif %}>
  {% if section.settings.show_heading or section.settings.intro != blank %}
    <header class="faq__header">
      {% if section.settings.show_heading %}
        <h2 id="FaqTitle-{{ section.id }}">
          {% if section.settings.heading != blank %}
            {{ section.settings.heading | escape }}
          {% else %}
            {{ 'faq.title' | t }}
          {% endif %}
        </h2>
      {% endif %}
    {% if section.settings.intro != blank %}<div class="faq__intro rte">{{ section.settings.intro }}</div>{% endif %}
    </header>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="faq__items">
      {% for block in section.blocks %}
        {% if block.settings.question != blank and block.settings.answer != blank %}
          <details class="faq__item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}</summary>
            <div class="faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .faq { margin: clamp(3.5rem, 7vw, 7rem) auto; max-inline-size: min(100% - (var(--page-margin) * 2), 72rem); }
  .faq__header { margin-block-end: var(--space-7); max-inline-size: 32rem; }
  .faq__header h2 { font-size: clamp(var(--heading-size-48), calc(var(--heading-size-48) + 2.5vw), var(--heading-size-72)); margin: 0; }
  .faq__intro { color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background)); line-height: calc(var(--body-text-line-spacing) + .1); margin-block-start: var(--space-4); }
  .faq__intro > :first-child, .faq__answer > :first-child { margin-block-start: 0; }
  .faq__intro > :last-child, .faq__answer > :last-child { margin-block-end: 0; }
  .faq__items { border-block-start: 1px solid var(--color-border); counter-reset: faq-item; }
  .faq__item { border-block-end: 1px solid var(--color-border); }
  .faq__item summary { align-items: center; cursor: pointer; display: grid; font-size: clamp(var(--heading-size-35), calc(var(--heading-size-35) + 2vw), var(--heading-size-46)); gap: var(--space-4); grid-template-columns: 2.5rem minmax(0, 1fr) auto; list-style: none; padding-block: clamp(1.25rem, 2vw, 1.75rem); }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::before { color: var(--color-foreground); content: counter(faq-item, decimal-leading-zero); counter-increment: faq-item; font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); }
  .faq__item summary::after { content: '+'; font-family: var(--font-commerce); font-size: 1.5rem; font-weight: 400; line-height: 1; }
  .faq__item[open] summary::after { content: '−'; }
  .faq__item summary:focus-visible { outline: .125rem solid var(--color-interactive); outline-offset: -.125rem; }
  .faq__answer { color: color-mix(in srgb, var(--color-foreground) 78%, var(--color-background)); grid-column: 2 / 3; line-height: calc(var(--body-text-line-spacing) + .2); max-inline-size: 38rem; padding-block: 0 clamp(1.5rem, 3vw, 2.5rem); }
  .faq--style-framed .faq__items { border: 0; display: grid; gap: var(--space-3); }
  .faq--style-framed .faq__item { border: 1px solid var(--color-border); padding-inline: var(--space-4); }
  .faq--style-framed .faq__answer { padding-inline: 0; }
  .faq--without-numbers .faq__item summary { grid-template-columns: minmax(0, 1fr) auto; }
  .faq--without-numbers .faq__item summary::before { display: none; }
  .faq--without-numbers .faq__answer { grid-column: 1 / 2; }
  @media (min-width: 64rem) { .faq { display: grid; gap: clamp(3rem, 8vw, 9rem); grid-template-columns: minmax(13rem, .65fr) minmax(0, 1.35fr); } .faq__header { margin: 0; } .faq__items { grid-column: 2; } .faq--heading-hidden .faq__items { grid-column: 1 / -1; margin-inline: auto; max-inline-size: 52rem; width: 100%; } .faq--layout-centered { display: block; max-inline-size: min(100% - (var(--page-margin) * 2), 62rem); } .faq--layout-centered .faq__header { margin: 0 auto var(--space-8); text-align: center; } .faq--layout-centered .faq__items { margin-inline: auto; max-inline-size: 52rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq",
  "blocks": [
    {
      "type": "faq_item",
      "name": "t:general.faq_item",
      "settings": [
        { "type": "text", "id": "question", "label": "t:labels.question" },
        { "type": "richtext", "id": "answer", "label": "t:labels.answer" }
      ]
    }
  ],
  "settings": [
    { "type": "select", "id": "layout_style", "label": "t:labels.faq_layout", "options": [{ "value": "editorial", "label": "t:options.faq_layout.editorial" }, { "value": "centered", "label": "t:options.faq_layout.centered" }], "default": "editorial" },
    { "type": "checkbox", "id": "show_heading", "label": "t:labels.show_faq_heading", "default": false },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "visible_if": "{{ section.settings.show_heading }}" },
    { "type": "richtext", "id": "intro", "label": "t:labels.intro" },
    { "type": "select", "id": "item_style", "label": "t:labels.faq_item_style", "options": [{ "value": "divided", "label": "t:options.faq_item_style.divided" }, { "value": "framed", "label": "t:options.faq_item_style.framed" }], "default": "divided" },
    { "type": "checkbox", "id": "show_numbers", "label": "t:labels.show_faq_numbers", "default": true }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
