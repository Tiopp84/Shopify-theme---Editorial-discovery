{% comment %}
  Collection index with an editorial introduction and Shopify collection links.
{% endcomment %}

{%- capture excluded_collection_handles -%}
  {%- for excluded_collection in section.settings.excluded_collections -%}
    |{{ excluded_collection.handle }}|
  {%- endfor -%}
{%- endcapture -%}

{% assign visible_collection_count = 0 %}
{% for collection in collections %}
  {%- capture collection_handle_token -%}|{{ collection.handle }}|{%- endcapture -%}
  {% unless excluded_collection_handles contains collection_handle_token %}
    {% assign visible_collection_count = visible_collection_count | plus: 1 %}
  {% endunless %}
{% endfor %}

<section class="collection-index full-width collection-index--content-{{ section.settings.content_position }} collection-index--text-{{ section.settings.text_alignment }} collection-index--item-{{ settings.collection_tile_style }} collection-index--item-text-{{ settings.collection_tile_text_position }}" aria-labelledby="CollectionIndexHeading-{{ section.id }}" style="--collection-index-columns: {{ section.settings.items_per_row }}; --collection-index-gap: {{ section.settings.grid_spacing }}px; --collection-index-ratio: {{ settings.collection_tile_image_ratio }};">
  <header class="collection-index__intro">
    <h1 id="CollectionIndexHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    {% if section.settings.intro != blank %}
      <div class="collection-index__description rte">{{ section.settings.intro }}</div>
    {% endif %}
  </header>

  {% if visible_collection_count > 0 %}
    <div class="collection-index__grid">
      {% for collection in collections %}
        {%- capture collection_handle_token -%}|{{ collection.handle }}|{%- endcapture -%}
        {% unless excluded_collection_handles contains collection_handle_token %}
        {% liquid
          assign collection_image = collection.featured_image
          assign first_product = collection.products.first
          if settings.collection_tile_image_source == 'first_product' and first_product.featured_image != blank
            assign collection_image = first_product.featured_image
          endif
        %}
        <a class="collection-card" href="{{ collection.url }}" data-catalog-reveal data-aos="fade-up">
          <span class="collection-card__media">
            {% if collection_image %}
              {% render 'image',
                class: 'collection-card__image',
                image: collection_image,
                width: 1200,
                widths: '480, 640, 800, 960, 1200',
                sizes: '(min-width: 36rem) 44vw, 100vw'
              %}
            {% else %}
              <span class="collection-card__placeholder" aria-hidden="true">{{ 'collection-1' | placeholder_svg_tag }}</span>
            {% endif %}
          </span>

          <span class="collection-card__content">
            <span class="collection-card__title">{{ collection.title | escape }}</span>
          </span>
        </a>
        {% endunless %}
      {% endfor %}
    </div>
  {% else %}
    <div class="collection-index__empty">
      <h2>{{ 'collections.empty_index_title' | t }}</h2>
      <p>{{ 'collections.empty_index_text' | t }}</p>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .collection-index { inline-size: 100%; margin: 0; max-inline-size: none; padding: clamp(5rem, 8vw, 8rem) clamp(var(--layout-gutter), 2vw, 2rem) var(--space-64px); }
  .collection-index__intro { display: grid; gap: var(--space-16px); inline-size: min(100%, 38rem); margin-block-end: clamp(2.5rem, 6vw, 5rem); }
  .collection-index__intro h1 { font-size: clamp(var(--heading-size-88), calc(var(--heading-size-88) + 5vw), var(--heading-size-144)); margin: 0; }
  .collection-index__description { color: color-mix(in srgb, var(--color-foreground) 74%, var(--color-background)); font-size: var(--body-text-base-size); inline-size: 100%; line-height: calc(var(--body-text-line-spacing) + .05); }
  .collection-index__description > :first-child { margin-block-start: 0; }
  .collection-index__description > :last-child { margin-block-end: 0; }
  .collection-index--content-left .collection-index__intro { margin-inline-end: auto; }
  .collection-index--content-center .collection-index__intro { margin-inline: auto; }
  .collection-index--content-right .collection-index__intro { margin-inline-start: auto; }
  .collection-index--text-left .collection-index__intro { text-align: start; }
  .collection-index--text-center .collection-index__intro { text-align: center; }
  .collection-index--text-right .collection-index__intro { text-align: end; }
  .collection-index__grid { display: grid; gap: var(--collection-index-gap); grid-template-columns: repeat(2, minmax(0, 1fr)); inline-size: 100%; }
  .collection-index__empty { display: grid; gap: var(--space-3); max-inline-size: 34rem; padding-block: var(--space-6); }
  .collection-index__empty h2, .collection-index__empty p { margin: 0; }
  .collection-index__empty p { color: color-mix(in srgb, var(--color-foreground) 74%, var(--color-background)); line-height: calc(var(--body-text-line-spacing) + .05); }
  .collection-card { color: currentcolor; display: grid; gap: var(--space-3); min-width: 0; position: relative; text-decoration: none; }
  .collection-card__media { aspect-ratio: var(--collection-index-ratio); background: var(--color-panel-01); display: block; overflow: hidden; position: relative; }
  .collection-card__media > .collection-card__image, .collection-card__media > .collection-card__placeholder { inset: 0; position: absolute; }
  .collection-card__media > .collection-card__image, .collection-card__media > .collection-card__image > img, .collection-card__media > .collection-card__placeholder, .collection-card__media > .collection-card__placeholder > svg { block-size: 100%; display: block; height: 100%; inline-size: 100%; object-fit: cover; object-position: center; width: 100%; }
  .collection-card__image > img { transition: transform 240ms ease; }
  .collection-card:is(:hover, :focus-visible) .collection-card__image > img { transform: scale(1.015); }
  .collection-card__content { display: grid; gap: var(--space-2); }
  .collection-card__title { font-family: var(--collection-title-font); font-size: var(--collection-title-size); font-style: var(--font-heading--style); line-height: 1; }
  .collection-index--item-overlay .collection-card,
  .collection-index--item-overlay_box .collection-card { display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); }
  .collection-index--item-overlay .collection-card__media,
  .collection-index--item-overlay_box .collection-card__media { grid-area: 1 / 1; }
  .collection-index--item-overlay .collection-card__content,
  .collection-index--item-overlay_box .collection-card__content { grid-area: 1 / 1; min-width: 0; padding: var(--space-4); position: relative; z-index: 1; }
  .collection-index--item-overlay .collection-card__content { color: var(--color-background); text-shadow: 0 .08em .45em color-mix(in srgb, var(--color-foreground) 62%, transparent); }
  .collection-index--item-overlay_box .collection-card__content { background: color-mix(in srgb, var(--color-background) 88%, transparent); color: var(--color-foreground); inline-size: fit-content; margin: var(--space-3); max-inline-size: min(78%, 17rem); padding: var(--space-3); }
  .collection-index--item-text-top_left .collection-card__content { align-self: start; justify-self: start; text-align: start; }
  .collection-index--item-text-center_left .collection-card__content { align-self: center; justify-self: start; text-align: start; }
  .collection-index--item-text-bottom_left .collection-card__content { align-self: end; justify-self: start; text-align: start; }
  .collection-index--item-text-top_center .collection-card__content { align-self: start; justify-self: center; text-align: center; }
  .collection-index--item-text-center_center .collection-card__content { align-self: center; justify-self: center; text-align: center; }
  .collection-index--item-text-bottom_center .collection-card__content { align-self: end; justify-self: center; text-align: center; }
  .collection-index--item-text-top_right .collection-card__content { align-self: start; justify-self: end; text-align: end; }
  .collection-index--item-text-center_right .collection-card__content { align-self: center; justify-self: end; text-align: end; }
  .collection-index--item-text-bottom_right .collection-card__content { align-self: end; justify-self: end; text-align: end; }
  @media (max-width: 35.99rem) {
    .collection-index { padding-block: var(--space-40px); }
    .collection-index__intro { margin-block-end: var(--space-40px); }
    .collection-index__grid { grid-template-columns: 1fr; }
    .collection-card__title { font-size: var(--collection-title-size); }
  }
  @media (min-width: 64rem) {
    .collection-index__grid { grid-template-columns: repeat(var(--collection-index-columns), minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Collections"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.text",
      "default": "<p>A curated editorial selection of seasonal narratives, tactile luxury and timeless form.</p>"
    },
    {
      "type": "collection_list",
      "id": "excluded_collections",
      "label": "t:labels.excluded_collections",
      "info": "t:descriptions.excluded_collections",
      "limit": 50
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:labels.content_position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:labels.text_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "items_per_row",
      "label": "t:labels.items_per_row",
      "options": [
        { "value": "2", "label": "t:options.columns.two" },
        { "value": "3", "label": "t:options.columns.three" },
        { "value": "4", "label": "t:options.columns.four" }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "grid_spacing",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:labels.grid_gap",
      "default": 32
    },
  ],
  "enabled_on": { "templates": ["list-collections"] }
}
{% endschema %}
