<section class="email-signup" {% if section.settings.heading != blank %}aria-labelledby="EmailSignupTitle-{{ section.id }}"{% endif %}>
  <div class="email-signup__inner">
    {% if section.settings.heading != blank %}
      <h2 id="EmailSignupTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="email-signup__text rte">{{ section.settings.text }}</div>
    {% endif %}

    {% capture email_signup_form_id %}EmailSignup-{{ section.id }}{% endcapture %}
    {% form 'customer', id: email_signup_form_id, class: 'email-signup__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="EmailSignupInput-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
      <input
        id="EmailSignupInput-{{ section.id }}"
        type="email"
        name="contact[email]"
        value="{{ form.email | escape }}"
        placeholder="{{ 'newsletter.email' | t }}"
        autocapitalize="off"
        autocomplete="email"
        required
      >
      <button type="submit">{{ 'newsletter.submit' | t }}</button>

      {% if form.posted_successfully? %}
        <p class="email-signup__message" role="status">{{ 'newsletter.success' | t }}</p>
      {% elsif form.errors %}
        <div class="email-signup__message email-signup__message--error" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .email-signup { margin-block: clamp(var(--space-chapter), 8vw, calc(var(--space-chapter) * 1.5)); padding-inline: max(var(--layout-gutter), calc((100vw - var(--layout-content-max)) / 2)); }
  .email-signup__inner { background: var(--color-panel-01); border-radius: clamp(1rem, 2vw, 1.5rem); margin-inline: auto; max-inline-size: 66rem; padding: clamp(var(--space-12), 7vw, 6rem); position: relative; text-align: center; }
  .email-signup h2 { font-family: var(--font-campaign); font-size: clamp(var(--heading-size-102), 4.5vw, var(--heading-size-176)); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.05em; line-height: .94; margin: 0; }
  .email-signup h2::after { background: currentcolor; content: ''; display: block; block-size: 1px; inline-size: 2.5rem; margin: clamp(var(--space-4), 2vw, var(--space-6)) auto 0; opacity: .72; }
  .email-signup__text { color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background)); font-size: var(--body-text-base-size); line-height: calc(var(--body-text-line-spacing) + .1); margin: clamp(var(--space-5), 2.5vw, var(--space-8)) auto 0; max-inline-size: 31rem; }
  .email-signup__text > :first-child { margin-block-start: 0; }
  .email-signup__text > :last-child { margin-block-end: 0; }
  .email-signup__form { display: grid; grid-template-columns: minmax(0, 1fr) auto; margin: clamp(var(--space-8), 4vw, var(--space-12)) auto 0; max-inline-size: 31rem; text-align: start; }
  .email-signup__form input { background: var(--color-background); border: var(--field-theme-border-width) solid var(--color-border); border-end-end-radius: 0; border-start-end-radius: 0; color: inherit; font: inherit; inline-size: 100%; min-block-size: var(--field-theme-height); min-inline-size: 0; padding-inline: var(--space-3); }
  .email-signup__form input:focus-visible { border-color: var(--color-interactive); outline: .125rem solid var(--color-interactive); outline-offset: .18rem; }
  .email-signup__form button { background: var(--button-theme-background); border: var(--button-theme-border-width) solid var(--button-theme-background); border-end-start-radius: 0; border-start-start-radius: 0; color: var(--button-theme-color); font-family: var(--button-theme-font); font-size: var(--button-theme-font-size); font-weight: 700; letter-spacing: var(--button-theme-letter-spacing); min-block-size: var(--button-theme-height); min-inline-size: 9.5rem; padding-inline: var(--button-theme-padding-inline); text-transform: uppercase; }
  .email-signup__form button:focus-visible { outline: .125rem solid var(--color-interactive); outline-offset: .25rem; }
  .email-signup__message { grid-column: 1 / -1; margin: var(--space-3) 0 0; text-align: center; }
  .email-signup__message--error { background: color-mix(in srgb, var(--color-status-error) 10%, var(--color-background)); border-inline-start: .2rem solid var(--color-status-error); padding: var(--space-3); }
  @media (hover: hover) and (pointer: fine) { .email-signup__form button:hover { background: var(--button-theme-hover-background); border-color: var(--button-theme-hover-background); } }
  @media (max-width: 47.99rem) {
    .email-signup { margin-block: var(--space-chapter-mobile); padding-inline: var(--layout-gutter); }
    .email-signup__inner { border-radius: 1rem; padding: clamp(var(--space-8), 9vw, var(--space-12)) var(--space-5); }
    .email-signup h2::after { inline-size: 2rem; margin-block-start: var(--space-4); }
    .email-signup h2 { font-size: clamp(var(--heading-size-72), 9vw, var(--heading-size-102)); line-height: .96; }
    .email-signup__text { font-size: var(--small-label-size); margin-block-start: var(--space-5); max-inline-size: 18rem; }
    .email-signup__form { gap: var(--space-2); grid-template-columns: minmax(0, 1fr); margin-block-start: var(--space-6); max-inline-size: none; }
    .email-signup__form input { border-radius: var(--field-theme-radius); min-block-size: var(--field-theme-height); }
    .email-signup__form button { border-radius: var(--button-theme-radius); inline-size: 100%; min-inline-size: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.email_signup",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Stay in the loop" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>New studies, material stories, and useful dispatches.</p>" }
  ],
  "enabled_on": { "templates": ["*"] },
  "presets": [{ "name": "t:general.email_signup", "category": "Forms & utility" }]
}
{% endschema %}
