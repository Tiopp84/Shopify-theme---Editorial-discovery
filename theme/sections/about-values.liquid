<section class="about-values full-width about-values--text-{{ section.settings.text_alignment }}" data-about-reveal{% if section.settings.heading != blank %} aria-labelledby="AboutValuesHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <header class="about-values__header">
    {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 id="AboutValuesHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
  </header>
  <div class="about-values__grid">
    {% for block in section.blocks %}
      <article class="about-values__item" style="--about-values-reveal-delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
        <span class="about-values__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
        {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .about-values { background: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background)); display: grid; gap: clamp(3rem, 7vw, 7rem); margin-block: var(--space-chapter); padding: clamp(4rem, 8vw, 8rem) max(var(--layout-gutter), calc((100vw - var(--layout-content-max)) / 2)); }
  .about-values__header { display: grid; gap: var(--space-4); max-inline-size: 41rem; }
  .about-values__header > p { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; text-transform: uppercase; }
  .about-values h2 { font-family: var(--font-campaign); font-size: clamp(2.5rem, 4.7vw, 5rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.04em; line-height: .95; margin: 0; }
  .about-values__header .rte, .about-values__item .rte { color: color-mix(in srgb, var(--color-foreground) 74%, var(--color-background)); line-height: calc(var(--body-text-line-spacing) + .06); }
  .about-values__header .rte > :first-child, .about-values__item .rte > :first-child { margin-block-start: 0; }
  .about-values__header .rte > :last-child, .about-values__item .rte > :last-child { margin-block-end: 0; }
  .about-values__grid { border-block-start: 1px solid var(--color-border); display: grid; }
  .about-values__item { display: grid; gap: var(--space-3); padding: var(--space-6) 0; }
  .about-values__item + .about-values__item { border-block-start: 1px solid var(--color-border); }
  .about-values--text-center .about-values__header { justify-items: center; margin-inline: auto; text-align: center; }
  .about-values--text-center .about-values__item { text-align: center; }
  .about-values--text-right .about-values__header { justify-items: end; margin-inline-start: auto; text-align: end; }
  .about-values--text-right .about-values__item { text-align: end; }
  .about-values__index { color: color-mix(in srgb, var(--color-foreground) 55%, var(--color-background)); font-family: var(--small-label-font); font-size: var(--small-label-size); letter-spacing: var(--small-label-letter-spacing); }
  .about-values h3 { font-family: var(--font-campaign); font-size: clamp(1.25rem, 2vw, 1.7rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.025em; line-height: 1.05; margin: 0; }
  @media (prefers-reduced-motion: no-preference) { .about-values--motion-enabled.is-revealed .about-values__header { animation: about-values-header-in 700ms cubic-bezier(.22, 1, .36, 1) both; } .about-values--motion-enabled.is-revealed .about-values__item { animation: about-values-item-in 680ms cubic-bezier(.22, 1, .36, 1) var(--about-values-reveal-delay) both; } @keyframes about-values-header-in { from { opacity: 0; transform: translate3d(0, 2rem, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } } @keyframes about-values-item-in { from { opacity: 0; transform: translate3d(0, 1.5rem, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } } }
  @media (min-width: 64rem) { .about-values__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .about-values__item { padding: var(--space-6); } .about-values__item:first-child { padding-inline-start: 0; } .about-values__item + .about-values__item { border-block-start: 0; border-inline-start: 1px solid var(--color-border); } }
  @media (max-width: 63.99rem) { .about-values { margin-block: var(--space-chapter-mobile); padding-inline: var(--layout-gutter); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_values",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "value",
      "name": "t:general.about_value",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Considered by design" },
        { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Every detail earns its place, from silhouette and fabric to the way a piece is worn over time.</p>" }
      ]
    }
  ],
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "header", "content": "t:general.content" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "What guides us" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Built for repeat wear, not a single moment." },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Our decisions begin with what makes getting dressed feel easier and more like yourself.</p>" },
    { "type": "select", "id": "text_alignment", "label": "t:labels.text_alignment", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left" }
  ],
  "presets": [{ "name": "t:general.about_values", "category": "Content", "blocks": [{ "type": "value" }, { "type": "value", "settings": { "heading": "Easy to return to", "text": "<p>Relaxed proportions and useful details make each piece part of the everyday, not just the occasion.</p>" } }, { "type": "value", "settings": { "heading": "Personal by nature", "text": "<p>We leave room for individual expression, so the collection can become entirely your own.</p>" } }] }]
}
{% endschema %}
