{% liquid
  assign has_content = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.body != blank or section.settings.link_label != blank and section.settings.link != blank
    assign has_content = true
  endif
%}

<section
  class="editorial-hero full-width editorial-hero--desktop-{{ section.settings.desktop_height }} editorial-hero--mobile-{{ section.settings.mobile_height }} editorial-hero--content-{{ section.settings.content_alignment }} editorial-hero--overlay-{{ section.settings.overlay_strength }}{% if section.settings.image == blank %} editorial-hero--text-only{% endif %}"
  data-home-reveal="editorial-hero"
  data-aos-section
  {% if section.settings.heading != blank %}aria-labelledby="EditorialHeroHeading-{{ section.id }}"{% endif %}
  style="--editorial-hero-fallback: {{ section.settings.fallback_background }};"
  {{ section.shopify_attributes }}
>
  <div class="editorial-hero__grid">
    <div class="editorial-hero__content" data-aos="fade-right">
      {% if section.settings.eyebrow != blank %}
        <p class="editorial-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 id="EditorialHeroHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="editorial-hero__body rte">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a class="editorial-hero__action" href="{{ section.settings.link }}">
          {{- section.settings.link_label | escape -}}
        </a>
      {% endif %}
    </div>

    {% if section.settings.image != blank %}
      <div class="editorial-hero__media">
        {% render 'image',
          class: 'editorial-hero__image',
          image: section.settings.image,
          alt: section.settings.image.alt,
          width: 2400,
          widths: '480, 720, 960, 1200, 1600, 2000, 2400',
          sizes: '(min-width: 60rem) 56vw, 100vw',
          loading: 'eager'
        %}
      </div>
    {% elsif has_content == false %}
      <div class="editorial-hero__fallback" aria-hidden="true"></div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .editorial-hero { border-block-end: 1px solid var(--color-border); margin-block-end: var(--space-chapter); }
  .editorial-hero__grid { display: grid; min-height: clamp(38rem, 80vh, 52rem); min-width: 0; position: relative; }
  .editorial-hero__content { align-content: center; display: grid; gap: var(--space-5); min-width: 0; padding: clamp(4rem, 8vw, 8rem) max(var(--page-margin), calc((100vw - var(--page-width)) / 2)); position: relative; z-index: 1; }
  .editorial-hero__eyebrow { font-size: .6875rem; font-weight: 600; letter-spacing: .1em; margin: 0; text-transform: uppercase; }
  .editorial-hero h1 { font-family: var(--font-campaign); font-size: clamp(3rem, 5.3vw, 5.5rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.035em; line-height: .98; margin: 0; max-inline-size: 11ch; overflow-wrap: anywhere; }
  .editorial-hero__body { color: color-mix(in srgb, var(--color-foreground) 74%, var(--color-background)); font-size: 1rem; line-height: 1.55; max-inline-size: 32rem; }
  .editorial-hero__body > :first-child { margin-block-start: 0; }
  .editorial-hero__body > :last-child { margin-block-end: 0; }
  .editorial-hero__action { align-items: center; background: var(--color-foreground); color: var(--color-background); display: inline-flex; font-size: .6875rem; font-weight: 600; justify-self: start; letter-spacing: .1em; min-block-size: 2.75rem; padding-inline: var(--space-6); text-decoration: none; text-transform: uppercase; }
  .editorial-hero__action:is(:hover, :focus-visible) { background: var(--color-accent); color: var(--color-background); }
  .editorial-hero__media, .editorial-hero__fallback { background: var(--editorial-hero-fallback, var(--color-panel-02)); inset: 0; position: absolute; z-index: 0; }
  .editorial-hero__media::after { background: linear-gradient(90deg, color-mix(in srgb, var(--color-background) 92%, transparent) 0%, color-mix(in srgb, var(--color-background) 55%, transparent) 34%, transparent 66%); content: ''; inset: 0; pointer-events: none; position: absolute; }
  @media (prefers-reduced-motion: no-preference) {
    html.aos-enabled .editorial-hero__media .editorial-hero__image { transform: scale(1.025); transition: transform 900ms cubic-bezier(.22, 1, .36, 1); }
    html.aos-enabled .editorial-hero--media-settled .editorial-hero__image { transform: scale(1); }
  }
  .editorial-hero--content-center .editorial-hero__content { justify-items: center; text-align: center; }
  .editorial-hero--content-center .editorial-hero__action { justify-self: center; }
  .editorial-hero--overlay-light .editorial-hero__media::after { opacity: .7; }
  .editorial-hero--overlay-strong .editorial-hero__media::after { opacity: 1.2; }
  .editorial-hero__media .editorial-hero__image, .editorial-hero__media .editorial-hero__image > img { block-size: 100%; height: 100%; object-fit: cover; width: 100%; }
  .editorial-hero--desktop-compact .editorial-hero__grid { min-height: 38rem; }
  .editorial-hero--desktop-standard .editorial-hero__grid { min-height: clamp(42rem, 80vh, 52rem); }
  .editorial-hero--desktop-tall .editorial-hero__grid { min-height: min(58rem, 90vh); }
  @media (min-width: 60rem) {
    .editorial-hero--text-only .editorial-hero__grid { min-height: 32rem; }
    .editorial-hero--text-only .editorial-hero__content { max-inline-size: var(--page-width); padding-inline: var(--page-margin); width: 100%; }
  }
  @media (max-width: 59.99rem) {
    .editorial-hero { margin-block-end: var(--space-chapter-mobile); }
    .editorial-hero__grid { min-height: 41.5rem; }
    .editorial-hero__content { align-content: end; color: var(--color-background); padding: 2rem var(--page-margin); }
    .editorial-hero h1 { font-size: clamp(2.4rem, 11vw, 3.25rem); max-inline-size: 12ch; }
    .editorial-hero__body, .editorial-hero__eyebrow { display: none; }
    .editorial-hero__media::after { background: linear-gradient(0deg, rgb(0 0 0 / 72%) 0%, rgb(0 0 0 / 28%) 42%, transparent 75%); }
    .editorial-hero__action { background: var(--color-background); color: var(--color-foreground); }
    .editorial-hero--mobile-compact .editorial-hero__grid { min-height: 31rem; }
    .editorial-hero--mobile-standard .editorial-hero__grid { min-height: 41.5rem; }
    .editorial-hero--mobile-tall .editorial-hero__grid { min-height: 48rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.editorial_hero",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "The new study" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "A considered collection for changing seasons" },
    { "type": "richtext", "id": "body", "label": "t:labels.text", "default": "<p>Editorial perspective and everyday decisions meet in a concise wardrobe.</p>" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "color", "id": "fallback_background", "label": "t:labels.fallback_background", "default": "#E1DBCC" },
    { "type": "select", "id": "content_alignment", "label": "t:labels.content_alignment", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }], "default": "left" },
    { "type": "select", "id": "overlay_strength", "label": "t:labels.image_overlay", "options": [{ "value": "light", "label": "t:options.overlay.light" }, { "value": "standard", "label": "t:options.overlay.standard" }, { "value": "strong", "label": "t:options.overlay.strong" }], "default": "standard" },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "t:labels.hero_height_desktop",
      "options": [
        { "value": "compact", "label": "t:options.hero_height.compact" },
        { "value": "standard", "label": "t:options.hero_height.standard" },
        { "value": "tall", "label": "t:options.hero_height.tall" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "t:labels.hero_height_mobile",
      "options": [
        { "value": "compact", "label": "t:options.hero_height.compact" },
        { "value": "standard", "label": "t:options.hero_height.standard" },
        { "value": "tall", "label": "t:options.hero_height.tall" }
      ],
      "default": "standard"
    },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label", "default": "Explore the edit" },
    { "type": "url", "id": "link", "label": "t:labels.link" }
  ],
  "presets": [{ "name": "t:general.editorial_hero" }]
}
{% endschema %}
