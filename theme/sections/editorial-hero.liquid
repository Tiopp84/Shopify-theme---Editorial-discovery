{% liquid
  assign content_position_parts = section.settings.text_position | default: 'bottom_left' | split: '_'
  assign content_block_position = content_position_parts.first | replace: 'top', 'start' | replace: 'bottom', 'end'
  assign content_inline_position = content_position_parts.last | replace: 'left', 'start' | replace: 'right', 'end'
  assign content_text_alignment = section.settings.text_alignment | default: content_inline_position
  assign overlay_direction = 'to right'
  assign hero_image_alt = section.settings.image.alt | default: section.settings.heading | default: shop.name

  if content_inline_position == 'center'
    assign overlay_direction = 'to bottom'
  elsif content_inline_position == 'end'
    assign overlay_direction = 'to left'
  endif
%}

<section
  class="editorial-hero full-width editorial-hero--heading-{{ section.settings.heading_size }} editorial-hero--content-width-{{ section.settings.content_width | default: 'narrow' }}"
  data-aos-section
  {% if section.settings.heading != blank %}aria-labelledby="EditorialHeroHeading-{{ section.id }}"{% endif %}
  style="--editorial-hero-desktop-min-height: {{ section.settings.desktop_height_vh }}vh; --editorial-hero-mobile-min-height: {{ section.settings.mobile_height_vh }}vh; --editorial-hero-protection: {{ section.settings.text_protection }}%; --editorial-hero-text-color: {{ section.settings.text_color }}; --editorial-hero-content-block-position: {{ content_block_position }}; --editorial-hero-content-inline-position: {{ content_inline_position }}; --editorial-hero-content-text-alignment: {{ content_text_alignment }}; --editorial-hero-overlay-direction: {{ overlay_direction }};"
  {{ section.shopify_attributes }}
>
  <div class="editorial-hero__content">
    <div class="editorial-hero__content-frame" data-aos="fade-right">
      {% if section.settings.eyebrow != blank %}
        <p class="editorial-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 id="EditorialHeroHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="editorial-hero__body rte">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a class="editorial-hero__action" href="{{ section.settings.link }}">
          {{- section.settings.link_label | escape -}}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="editorial-hero__media">
    {% if section.settings.image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}<source media="(max-width: 47.99rem)" srcset="{{ section.settings.mobile_image | image_url: width: 960 }}">{% endif %}
        {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'editorial-hero__image', alt: hero_image_alt, loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1600, 2000, 2400', sizes: '100vw' }}
      </picture>
    {% else %}
      <span class="editorial-hero__placeholder" aria-hidden="true">{{ 'lifestyle-1' | placeholder_svg_tag }}</span>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .editorial-hero { --editorial-hero-content-max: 22rem; --editorial-hero-heading-measure: 8ch; border-block-end: 1px solid var(--color-border); display: grid; grid-template-areas: 'hero'; grid-template-rows: minmax(var(--editorial-hero-desktop-min-height), auto); margin-block-end: var(--space-chapter); min-width: 0; position: relative; }
  .editorial-hero--content-width-medium { --editorial-hero-content-max: 34rem; --editorial-hero-heading-measure: 12ch; }
  .editorial-hero--content-width-wide { --editorial-hero-content-max: 48rem; --editorial-hero-heading-measure: 100%; }
  .editorial-hero__content { align-content: var(--editorial-hero-content-block-position); align-self: stretch; box-sizing: border-box; color: var(--editorial-hero-text-color); display: grid; grid-area: hero; justify-items: var(--editorial-hero-content-inline-position); justify-self: stretch; min-width: 0; padding: clamp(var(--space-16), 8vw, 8rem) max(var(--layout-gutter), calc((100vw - var(--layout-content-max)) / 2)); position: relative; z-index: 1; }
  .editorial-hero__content-frame { display: grid; gap: var(--space-5); inline-size: min(100%, var(--editorial-hero-content-max)); text-align: var(--editorial-hero-content-text-alignment); }
  .editorial-hero__eyebrow { font-family: var(--font-commerce); font-size: var(--small-label-size); font-weight: 600; inline-size: 100%; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; text-transform: uppercase; }
  .editorial-hero h1 { font-family: var(--font-campaign); font-size: clamp(var(--heading-size-128), 5.3vw, var(--heading-size-192)); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); inline-size: min(100%, var(--editorial-hero-heading-measure)); justify-self: var(--editorial-hero-content-text-alignment); letter-spacing: -.035em; line-height: .98; margin: 0; overflow-wrap: anywhere; }
  .editorial-hero--heading-small h1 { font-size: clamp(var(--heading-size-72), 3.8vw, var(--heading-size-128)); }
  .editorial-hero--heading-medium h1 { font-size: clamp(var(--heading-size-102), 4.5vw, var(--heading-size-160)); }
  .editorial-hero__body { color: color-mix(in srgb, var(--editorial-hero-text-color) 82%, transparent); font-size: var(--body-text-base-size); inline-size: 100%; line-height: calc(var(--body-text-line-spacing) + .05); }
  .editorial-hero__body > :first-child { margin-block-start: 0; }
  .editorial-hero__body > :last-child { margin-block-end: 0; }
  .editorial-hero__action { align-items: center; border-block-end: 1px solid currentcolor; color: currentcolor; display: inline-flex; font-family: var(--font-commerce); font-size: var(--body-text-base-size); font-weight: 600; gap: var(--space-2); justify-self: var(--editorial-hero-content-text-alignment); line-height: 1.35; padding-block-end: var(--space-1); text-decoration: none; }
  .editorial-hero__action::after { content: '→'; transition: transform 180ms ease; }
  .editorial-hero__action:is(:hover, :focus-visible) { color: var(--editorial-hero-text-color); }
  .editorial-hero__action:focus-visible { box-shadow: var(--focus-ring); outline: 0; }
  @media (prefers-reduced-motion: no-preference) { .editorial-hero__action:hover::after, .editorial-hero__action:focus-visible::after { transform: translateX(var(--space-1)); } }
  .editorial-hero__media { grid-area: hero; min-height: 0; overflow: hidden; position: relative; z-index: 0; }
  .editorial-hero__media::after { background: linear-gradient(var(--editorial-hero-overlay-direction), rgb(0 0 0 / var(--editorial-hero-protection)) 0%, rgb(0 0 0 / 42%) 40%, transparent 76%); content: ''; inset: 0; pointer-events: none; position: absolute; }
  @media (prefers-reduced-motion: no-preference) {
    html.aos-enabled .editorial-hero__media .editorial-hero__image { transform: scale(1.025); transition: transform 900ms cubic-bezier(.22, 1, .36, 1); }
    html.aos-enabled .hero--media-settled .editorial-hero__image { transform: scale(1); }
  }
  .editorial-hero__media picture, .editorial-hero__media .editorial-hero__image, .editorial-hero__placeholder, .editorial-hero__placeholder svg { block-size: 100%; display: block; height: 100%; inline-size: 100%; width: 100%; }
  .editorial-hero__media .editorial-hero__image { object-fit: cover; }
  .editorial-hero__placeholder { background: var(--color-panel-02); color: color-mix(in srgb, var(--color-foreground) 30%, var(--color-panel-02)); }
  @media (max-width: 63.99rem) {
    .editorial-hero { margin-block-end: var(--space-chapter-mobile); }
    .editorial-hero__content { padding: var(--space-8) var(--layout-gutter); }
    .editorial-hero__media::after { background: linear-gradient(0deg, rgb(0 0 0 / var(--editorial-hero-protection)) 0%, rgb(0 0 0 / 32%) 48%, transparent 78%); }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .editorial-hero { grid-template-rows: minmax(min(var(--editorial-hero-desktop-min-height), 44rem), auto); }
    .editorial-hero__content { gap: var(--space-4); padding: clamp(2.5rem, 6vw, 4.5rem) var(--layout-gutter); }
    .editorial-hero h1 { font-size: clamp(var(--heading-size-112), 6vw, var(--heading-size-160)); }
    .editorial-hero__body { display: block; max-inline-size: 30rem; }
  }
  @media (max-width: 47.99rem) {
    .editorial-hero { grid-template-rows: minmax(var(--editorial-hero-mobile-min-height), auto); }
    .editorial-hero__content { align-content: end; padding-block: var(--space-12); }
    .editorial-hero__content-frame { gap: var(--space-4); }
    .editorial-hero h1 { font-size: clamp(var(--heading-size-86), 10vw, var(--heading-size-128)); }
    .editorial-hero__body { font-size: max(.9375rem, calc(var(--body-text-base-size) * .94)); max-inline-size: 24rem; }
    .editorial-hero__action { font-size: max(.9375rem, calc(var(--body-text-base-size) * .94)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.editorial_hero",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "header", "content": "t:general.image" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "image_picker", "id": "mobile_image", "label": "t:labels.mobile_image" },
    { "type": "range", "id": "text_protection", "label": "t:labels.text_protection", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 75 },
    { "type": "header", "content": "t:general.content" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "The new study" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "A considered collection for changing seasons" },
    { "type": "select", "id": "heading_size", "label": "t:labels.heading_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "large" },
    { "type": "richtext", "id": "body", "label": "t:labels.text", "default": "<p>Editorial perspective and everyday decisions meet in a concise wardrobe.</p>" },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label", "default": "Explore the edit" },
    { "type": "url", "id": "link", "label": "t:labels.link" },
    { "type": "select", "id": "content_width", "label": "t:labels.content_width", "options": [{ "value": "narrow", "label": "t:options.content_width.narrow" }, { "value": "medium", "label": "t:options.content_width.medium" }, { "value": "wide", "label": "t:options.content_width.wide" }], "default": "narrow" },
    { "type": "header", "content": "t:general.layout" },
    { "type": "select", "id": "text_position", "label": "t:labels.content_position", "options": [{ "value": "top_left", "label": "t:options.content_position.top_left" }, { "value": "center_left", "label": "t:options.content_position.center_left" }, { "value": "bottom_left", "label": "t:options.content_position.bottom_left" }, { "value": "top_center", "label": "t:options.content_position.top_center" }, { "value": "center_center", "label": "t:options.content_position.center_center" }, { "value": "bottom_center", "label": "t:options.content_position.bottom_center" }, { "value": "top_right", "label": "t:options.content_position.top_right" }, { "value": "center_right", "label": "t:options.content_position.center_right" }, { "value": "bottom_right", "label": "t:options.content_position.bottom_right" }], "default": "bottom_left" },
    { "type": "text_alignment", "id": "text_alignment", "label": "t:labels.text_alignment", "default": "left" },
    { "type": "range", "id": "desktop_height_vh", "label": "t:labels.hero_height_desktop", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 80 },
    { "type": "range", "id": "mobile_height_vh", "label": "t:labels.hero_height_mobile", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 70 },
    { "type": "header", "content": "t:general.style" },
    { "type": "color", "id": "text_color", "label": "t:labels.text_color", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "t:general.editorial_hero", "category": "Campaign & editorial" }]
}
{% endschema %}
