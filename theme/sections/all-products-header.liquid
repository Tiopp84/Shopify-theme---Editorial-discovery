<section class="all-products-header all-products-header--align-{{ section.settings.text_alignment }}" aria-labelledby="AllProductsHeading-{{ section.id }}">
  <div class="all-products-header__content">
    {% if section.settings.eyebrow != blank %}
      <p class="all-products-header__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    <h1 id="AllProductsHeading-{{ section.id }}">
      {% if section.settings.heading != blank %}
        {{ section.settings.heading | escape }}
      {% else %}
        {{ 'navigation.products' | t }}
      {% endif %}
    </h1>

    {% if section.settings.intro != blank %}
      <div class="all-products-header__intro rte">{{ section.settings.intro }}</div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .all-products-header { background: var(--color-background); border-block: 1px solid var(--color-border); color: var(--color-foreground); }
  .all-products-header__content { display: grid; gap: var(--space-3); margin-inline: auto; max-inline-size: min(100%, 52rem); padding: clamp(var(--space-8), 7vw, var(--space-16)) var(--page-gutter); }
  .all-products-header__eyebrow { color: var(--color-interactive); font-size: .75rem; font-weight: 700; letter-spacing: .1em; margin: 0; text-transform: uppercase; }
  .all-products-header h1 { font-size: clamp(var(--heading-size-80), calc(var(--heading-size-80) + 6vw), var(--heading-size-176)); margin: 0; }
  .all-products-header__intro { color: color-mix(in srgb, var(--color-foreground) 78%, var(--color-background)); font-size: var(--body-text-base-size); line-height: calc(var(--body-text-line-spacing) + .1); max-inline-size: 42rem; }
  .all-products-header__intro > :first-child { margin-block-start: 0; }
  .all-products-header__intro > :last-child { margin-block-end: 0; }
  .all-products-header--align-center .all-products-header__content { justify-items: center; text-align: center; }
  .all-products-header--align-center .all-products-header__intro { margin-inline: auto; }
  .all-products-header--align-right .all-products-header__content { justify-items: end; text-align: end; }
  .all-products-header--align-right .all-products-header__intro { margin-inline-start: auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.all_products_header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "richtext", "id": "intro", "label": "t:labels.intro" },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:labels.text_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "center"
    }
  ],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
