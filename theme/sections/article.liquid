{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers (not shown in this example).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{% liquid
  assign has_author_profile = false
  if section.settings.sidebar_author_image != blank or section.settings.sidebar_author_name != blank or section.settings.sidebar_author_role != blank or section.settings.sidebar_author_bio != blank
    assign has_author_profile = true
  endif

  assign rendered_layout = 'reading'
  if has_author_profile
    assign rendered_layout = 'sidebar'
  endif
%}

<article class="article-template article-template--layout-{{ rendered_layout }} article-template--media-{{ section.settings.media_presentation }}">
  <div class="article-template__layout">
    <div class="article-template__main">
      <header class="article-template__header">
        <h1>{{ article.title | escape }}</h1>
        {% assign article_word_count = article.content | strip_html | strip_newlines | split: ' ' | size %}
        {% assign article_read_minutes = article_word_count | divided_by: 220.0 | ceil | at_least: 1 %}
        <div class="article-template__context">
          <p class="article-reading-context">
            {% if section.settings.show_author and article.author != blank %}<span>{{ article.author | escape }}</span>{% endif %}
            {% if section.settings.show_date %}<span>{{ article.published_at | time_tag: format: 'date' }}</span>{% endif %}
            {% if section.settings.show_read_time %}<span>{{ 'blog.read_time' | t: count: article_read_minutes }}</span>{% endif %}
          </p>
        </div>
      </header>

      {% if section.settings.show_media and article.image %}
        <div class="article-template__media">
          {{ article.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '360, 480, 600, 900', sizes: '(min-width: 64rem) 22rem, (min-width: 48rem) 40vw, 90vw' }}
        </div>
      {% endif %}

      <div class="article-template__content">{{ article.content }}</div>

      {% if blog.comments_enabled? %}
        {% assign comment_form_id = 'ArticleCommentForm-' | append: section.id %}
        <section class="article-comments" id="comments" aria-labelledby="ArticleCommentsHeading-{{ section.id }}">
          <header class="article-comments__header">
            <div>
              <h2 id="ArticleCommentsHeading-{{ section.id }}">{{ 'blog.article_comments' | t }}</h2>
              <p class="article-comments__count">{{ 'blog.comments_count' | t: count: article.comments_count }}</p>
            </div>
          </header>

          {% paginate article.comments by 10 %}
            {% if article.comments_count > 0 %}
              <ol class="article-comments__list" role="list">
                {% for comment in article.comments %}
                  <li>
                    <article class="article-comment">
                      <header class="article-comment__header">
                        <h3>{{ comment.author | escape }}</h3>
                        <p>{{ comment.created_at | time_tag: format: 'date' }}</p>
                      </header>
                      <div class="article-comment__content rte">{{ comment.content }}</div>
                    </article>
                  </li>
                {% endfor %}
              </ol>
            {% else %}
              <p class="article-comments__empty">{{ 'blog.comments_empty' | t }}</p>
            {% endif %}

            {% render 'pagination', paginate: paginate, anchor: 'comments' %}
          {% endpaginate %}

          {% form 'new_comment', article, id: comment_form_id, class: 'article-comments__form' %}
            <div class="article-comments__form-header">
              <h3>{{ 'blog.comment_form_title' | t }}</h3>
              <p>{{ 'blog.comment_form_intro' | t }}</p>
            </div>

            {% if form.posted_successfully? %}
              <p class="article-comments__success" role="status">{{ 'blog.comment_form_success' | t }}</p>
            {% endif %}

            {% if form.errors %}
              <div class="article-comments__errors" role="alert">{{ form.errors | default_errors }}</div>
            {% endif %}

            <div class="article-comments__fields">
              <div class="article-comments__field">
                <label for="CommentAuthor-{{ section.id }}">{{ 'blog.comment_form_name' | t }}</label>
                <input id="CommentAuthor-{{ section.id }}" autocomplete="name" name="comment[author]" required type="text" value="{{ form.author | escape }}">
              </div>
              <div class="article-comments__field">
                <label for="CommentEmail-{{ section.id }}">{{ 'blog.comment_form_email' | t }}</label>
                <input id="CommentEmail-{{ section.id }}" autocomplete="email" name="comment[email]" required type="email" value="{{ form.email | escape }}">
              </div>
              <div class="article-comments__field article-comments__field--body">
                <label for="CommentBody-{{ section.id }}">{{ 'blog.comment_form_body' | t }}</label>
                <textarea id="CommentBody-{{ section.id }}" name="comment[body]" required rows="6">{{ form.body }}</textarea>
              </div>
            </div>

            <button class="article-comments__submit button" type="submit">{{ 'blog.comment_form_submit' | t }}</button>
          {% endform %}
        </section>
      {% endif %}
    </div>

    {% if has_author_profile %}
      <aside class="article-template__sidebar" aria-label="{{ 'blog.article_sidebar' | t }}">
        <section class="article-sidebar-profile" aria-label="{{ 'blog.author_profile' | t }}">
          {% if section.settings.sidebar_author_image != blank %}
            {{ section.settings.sidebar_author_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '7.5rem' }}
          {% endif %}
          {% if section.settings.sidebar_author_name != blank %}<h2>{{ section.settings.sidebar_author_name | escape }}</h2>{% endif %}
          {% if section.settings.sidebar_author_role != blank %}<p class="article-sidebar-profile__role">{{ section.settings.sidebar_author_role | escape }}</p>{% endif %}
          {% if section.settings.sidebar_author_bio != blank %}<div class="article-sidebar-profile__bio rte">{{ section.settings.sidebar_author_bio }}</div>{% endif %}
        </section>
      </aside>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .article-template { background: var(--color-background); color: var(--color-foreground); margin: var(--space-8) auto; max-inline-size: min(78rem, var(--layout-content-max)); padding-inline: var(--layout-gutter); }
  .article-template__layout, .article-template__main { min-inline-size: 0; }
  .article-template__media { margin: var(--space-6) auto var(--space-8); max-inline-size: 68rem; }
  .article-template__media img { block-size: auto; display: block; inline-size: 100%; max-inline-size: none; }
  .article-template--media-portrait .article-template__media img { aspect-ratio: 4 / 5; object-fit: cover; }
  .article-template--media-landscape .article-template__media img { aspect-ratio: 16 / 9; object-fit: cover; }
  .article-template__header, .article-template__content { margin-inline: auto; max-inline-size: 42rem; }
  .article-template__header h1 { font-size: clamp(var(--heading-size-72), calc(var(--heading-size-72) + 4.25vw), var(--heading-size-112)); margin: 0; max-inline-size: 22ch; }
  .article-template__context { margin-block-start: var(--space-4); }
  .article-reading-context { align-items: center; color: color-mix(in srgb, var(--color-foreground) 68%, var(--color-background)); display: flex; flex-wrap: wrap; font-family: var(--small-label-font); font-size: var(--small-label-size); gap: var(--space-2); letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; }
  .article-reading-context span + span::before { content: '·'; margin-inline-end: var(--space-2); }
  .article-template__content { color: color-mix(in srgb, var(--color-foreground) 88%, var(--color-background)); font-size: var(--body-text-base-size); line-height: calc(var(--body-text-line-spacing) + .25); margin-block-start: var(--space-5); }
  .article-template__content > :first-child { margin-block-start: 0; }
  .article-template__content > :last-child { margin-block-end: 0; }
  .article-template__content :is(h2, h3, h4) { color: var(--color-foreground); font-family: var(--font-campaign); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: var(--heading-letter-spacing); line-height: 1.02; margin-block: var(--space-12) var(--space-4); max-inline-size: 20ch; }
  .article-template__content h2 { font-size: clamp(2.25rem, 4vw, 4.5rem); letter-spacing: -.035em; }
  .article-template__content h3 { font-size: clamp(1.75rem, 3vw, 3rem); letter-spacing: -.025em; }
  .article-template__content h4 { font-family: var(--font-commerce); font-size: var(--body-text-base-size); font-style: normal; font-weight: 650; letter-spacing: 0; line-height: 1.25; }
  .article-template__content :is(p, ul, ol, blockquote) { margin-block: 0 var(--space-5); }
  .article-template__content :is(ul, ol) { padding-inline-start: var(--space-6); }
  .article-template__content li + li { margin-block-start: var(--space-2); }
  .article-template__content blockquote { border-inline-start: 1px solid var(--color-foreground); color: var(--color-foreground); font-family: var(--font-campaign); font-size: clamp(var(--heading-size-56), 2.5vw, var(--heading-size-86)); font-style: var(--font-heading--style); line-height: 1.08; padding-inline-start: var(--space-5); }
  .article-template__content :is(img, video, iframe) { block-size: auto; display: block; inline-size: auto; margin-block: var(--space-6); max-inline-size: 100%; }
  .article-template__content p > img:only-child { inline-size: 100%; }
  .article-template__content :is(figure, table) { margin: var(--space-6) 0; max-inline-size: 100%; }
  .article-template__content figure img { inline-size: 100%; margin: 0; }
  .article-template__content figcaption { color: color-mix(in srgb, var(--color-foreground) 64%, var(--color-background)); font-family: var(--small-label-font); font-size: var(--small-label-size); letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin-block-start: var(--space-2); }
  .article-template__content a { color: var(--color-foreground); text-decoration-color: var(--color-interactive); text-decoration-thickness: 1px; text-underline-offset: .18em; }
  .article-template__content a:is(:hover, :focus-visible) { text-decoration-thickness: 2px; }
  .article-template__content table { border-collapse: collapse; inline-size: 100%; }
  .article-template__content :is(th, td) { border-block: 1px solid var(--color-border); padding: var(--space-3); text-align: start; }
  .article-comments { border-block-start: 1px solid var(--color-border); margin: var(--space-12) auto 0; max-inline-size: 44rem; padding-block-start: var(--space-8); }
  .article-comments__header { margin-block-end: var(--space-6); }
  .article-comments__header h2, .article-comments__form h3 { font-family: var(--font-campaign); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.035em; line-height: 1; margin: 0; }
  .article-comments__header h2 { font-size: clamp(2.25rem, 4vw, 4rem); }
  .article-comments__count { color: color-mix(in srgb, var(--color-foreground) 68%, var(--color-background)); font-family: var(--small-label-font); font-size: var(--small-label-size); letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: var(--space-3) 0 0; text-transform: uppercase; }
  .article-comments__list { list-style: none; margin: 0; padding: 0; }
  .article-comment { border-block-start: 1px solid color-mix(in srgb, var(--color-border) 74%, transparent); padding-block: var(--space-5); }
  .article-comment__header { align-items: baseline; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  .article-comment__header h3 { font-family: var(--font-commerce); font-size: 1rem; font-style: normal; font-weight: 700; letter-spacing: 0; line-height: 1.3; margin: 0; }
  .article-comment__header p { color: color-mix(in srgb, var(--color-foreground) 62%, var(--color-background)); font-family: var(--small-label-font); font-size: var(--small-label-size); letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); margin: 0; }
  .article-comment__content { color: color-mix(in srgb, var(--color-foreground) 86%, var(--color-background)); line-height: calc(var(--body-text-line-spacing) + .08); margin-block-start: var(--space-3); }
  .article-comment__content > :first-child { margin-block-start: 0; }
  .article-comment__content > :last-child { margin-block-end: 0; }
  .article-comments__empty { color: color-mix(in srgb, var(--color-foreground) 68%, var(--color-background)); margin: 0; }
  .article-comments__form { background: color-mix(in srgb, var(--color-foreground) 3%, var(--color-background)); border: 1px solid var(--color-border); margin-block-start: var(--space-8); padding: clamp(1.25rem, 3vw, 2rem); }
  .article-comments__form-header { margin-block-end: var(--space-6); }
  .article-comments__form h3 { font-size: clamp(2rem, 3vw, 3rem); }
  .article-comments__form-header p { color: color-mix(in srgb, var(--color-foreground) 68%, var(--color-background)); margin: var(--space-3) 0 0; }
  .article-comments__fields { display: grid; gap: var(--space-5); }
  .article-comments__field { display: grid; gap: var(--space-2); }
  .article-comments__field label { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 700; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); text-transform: uppercase; }
  .article-comments__field :is(input, textarea) { background: var(--color-background); border: var(--field-theme-border-width) solid var(--color-border); border-radius: var(--field-theme-radius); color: inherit; font: inherit; inline-size: 100%; min-block-size: var(--field-theme-height); padding: var(--space-3); }
  .article-comments__field textarea { min-block-size: 10rem; resize: vertical; }
  .article-comments__field :is(input, textarea):hover { border-color: color-mix(in srgb, var(--color-foreground) 48%, var(--color-background)); }
  .article-comments__field :is(input, textarea):focus-visible { border-color: var(--color-interactive); box-shadow: none; outline: .125rem solid var(--color-interactive); outline-offset: .18rem; }
  .article-comments__submit { margin-block-start: var(--space-6); }
  .article-comments__errors, .article-comments__success { margin: 0 0 var(--space-5); padding: var(--space-3); }
  .article-comments__errors { background: color-mix(in srgb, var(--color-status-error) 10%, var(--color-background)); border-inline-start: .2rem solid var(--color-status-error); }
  .article-comments__errors ul { margin: 0; padding-inline-start: var(--space-5); }
  .article-comments__success { background: color-mix(in srgb, var(--color-status-success) 12%, var(--color-background)); border-inline-start: .2rem solid var(--color-status-success); }
  .article-template__sidebar { border-block-start: 1px solid var(--color-border); display: grid; gap: var(--space-6); margin-block-start: var(--space-8); padding-block-start: var(--space-6); }
  .article-sidebar-profile { border-block-start: 0; padding-block-start: 0; text-align: center; }
  .article-sidebar-profile img { aspect-ratio: 1; border-radius: 50%; display: block; margin: 0 auto var(--space-3); object-fit: cover; width: 7.5rem; }
  .article-sidebar-profile h2 { font-size: 1.0625rem; line-height: 1.2; margin: 0; }
  .article-sidebar-profile__role { color: color-mix(in srgb, var(--color-foreground) 66%, var(--color-background)); margin: var(--space-2) 0 0; }
  .article-sidebar-profile__bio { font-size: .9rem; line-height: calc(var(--body-text-line-spacing) + .1); margin-block-start: var(--space-4); text-align: start; }
  .article-sidebar-profile__bio > :first-child { margin-block-start: 0; }
  .article-sidebar-profile__bio > :last-child { margin-block-end: 0; }
  @media (min-width: 64rem) {
    .article-template--layout-reading .article-template__main { margin-inline: auto; max-inline-size: 68rem; }
    .article-template--layout-reading .article-template__header { max-inline-size: 44rem; }
    .article-template--layout-reading .article-template__content { max-inline-size: 44rem; }
    .article-template--layout-sidebar .article-template__layout { align-items: start; display: grid; gap: clamp(2.5rem, 6vw, 6rem); grid-template-columns: minmax(0, 42rem) minmax(15rem, 19rem); justify-content: space-between; }
    .article-template--layout-sidebar .article-template__header, .article-template--layout-sidebar .article-template__content, .article-template--layout-sidebar .article-template__media { margin-inline: 0; }
    .article-template--layout-sidebar .article-template__sidebar { border-block-start: 0; border-inline-start: 1px solid var(--color-border); margin-block-start: 0; padding-block-start: 0; padding-inline-start: clamp(1.5rem, 3vw, 3rem); }
  }
  @media (max-width: 47.99rem) {
    .article-template { margin-block: var(--space-6); }
    .article-template__content { margin-block-start: var(--space-6); }
    .article-template__content :is(h2, h3, h4) { margin-block-start: var(--space-8); }
  }
  @media (min-width: 48rem) {
    .article-comments__fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .article-comments__field--body { grid-column: 1 / -1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    { "type": "checkbox", "id": "show_media", "label": "t:labels.show_article_media", "default": true },
    { "type": "select", "id": "media_presentation", "label": "t:labels.article_media_presentation", "options": [{ "value": "original", "label": "t:options.article_media_presentation.original" }, { "value": "portrait", "label": "t:options.article_media_presentation.portrait" }, { "value": "landscape", "label": "t:options.article_media_presentation.landscape" }], "default": "original", "visible_if": "{{ section.settings.show_media }}" },
    { "type": "checkbox", "id": "show_author", "label": "t:labels.show_author", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "t:labels.show_date", "default": true },
    { "type": "checkbox", "id": "show_read_time", "label": "t:labels.show_read_time", "default": true },
    { "type": "header", "content": "t:general.article_sidebar" },
    { "type": "image_picker", "id": "sidebar_author_image", "label": "t:labels.sidebar_author_image" },
    { "type": "text", "id": "sidebar_author_name", "label": "t:labels.sidebar_author_name" },
    { "type": "text", "id": "sidebar_author_role", "label": "t:labels.sidebar_author_role" },
    { "type": "richtext", "id": "sidebar_author_bio", "label": "t:labels.sidebar_author_bio" }
  ],
  "enabled_on": { "templates": ["article"] }
}
{% endschema %}
