<section class="contact-form" aria-labelledby="ContactFormTitle-{{ section.id }}">
  <header class="contact-form__header">
    <h2 id="ContactFormTitle-{{ section.id }}">{{ section.settings.heading | default: 'contact.title' | t }}</h2>
    {% if section.settings.intro != blank %}<div class="contact-form__intro rte">{{ section.settings.intro }}</div>{% endif %}
  </header>

  {% capture contact_form_id %}ContactForm-{{ section.id }}{% endcapture %}
  {% form 'contact', id: contact_form_id %}
    {% if form.posted_successfully? %}
      <p class="contact-form__message" role="status">{{ 'contact.success' | t }}</p>
    {% elsif form.errors %}
      <div class="contact-form__message contact-form__message--error" role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}

    <div class="contact-form__fields">
      <div class="contact-form__field">
        <label for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
        <input id="ContactName-{{ section.id }}" autocomplete="name" name="contact[name]" type="text" value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}">
      </div>
      <div class="contact-form__field">
        <label for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }}</label>
        <input id="ContactEmail-{{ section.id }}" autocomplete="email" name="contact[email]" required type="email" value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}">
      </div>
      <div class="contact-form__field">
        <label for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
        <input id="ContactPhone-{{ section.id }}" autocomplete="tel" name="contact[phone]" type="tel" value="{{ form.phone | escape }}">
      </div>
      <div class="contact-form__field contact-form__field--message">
        <label for="ContactMessage-{{ section.id }}">{{ 'contact.message' | t }}</label>
        <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" required rows="7">{{ form.body }}</textarea>
      </div>
    </div>

    <button class="contact-form__submit" type="submit">{{ 'contact.submit' | t }}</button>
  {% endform %}
</section>

{% stylesheet %}
  .contact-form { border-block-start: 1px solid var(--color-border); margin: var(--space-8) auto; max-inline-size: min(100% - (var(--page-margin) * 2), 42rem); padding-block-start: var(--space-7); }
  .contact-form__header { margin-block-end: var(--space-6); }
  .contact-form__header h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -.02em; line-height: 1.05; margin: 0; }
  .contact-form__intro { line-height: 1.6; margin-block-start: var(--space-3); max-inline-size: 36rem; }
  .contact-form__intro > :first-child { margin-block-start: 0; }
  .contact-form__intro > :last-child { margin-block-end: 0; }
  .contact-form__fields { display: grid; gap: var(--space-4); }
  .contact-form__field { display: grid; gap: var(--space-2); }
  .contact-form__field label { font-size: .8125rem; font-weight: 600; }
  .contact-form__field input, .contact-form__field textarea { background: transparent; border: 1px solid var(--color-border); border-radius: 0; color: inherit; font: inherit; inline-size: 100%; padding: .875rem 1rem; }
  .contact-form__field textarea { resize: vertical; }
  .contact-form__field input:focus-visible, .contact-form__field textarea:focus-visible { outline: .125rem solid var(--color-accent); outline-offset: .2rem; }
  .contact-form__message { background: color-mix(in srgb, var(--color-accent) 12%, var(--color-background)); margin-block: 0 var(--space-5); padding: var(--space-3); }
  .contact-form__message--error { background: color-mix(in srgb, #a33f2b 10%, var(--color-background)); border-inline-start: .2rem solid #a33f2b; }
  .contact-form__submit { background: var(--color-foreground); border: 1px solid var(--color-foreground); border-radius: 0; color: var(--color-background); font: inherit; font-weight: 700; margin-block-start: var(--space-5); min-block-size: 3.25rem; padding-inline: var(--space-6); }
  .contact-form__submit:focus-visible { outline: .125rem solid var(--color-accent); outline-offset: .25rem; }
  @media (min-width: 48rem) { .contact-form__fields { grid-template-columns: repeat(2, minmax(0, 1fr)); } .contact-form__field--message { grid-column: 1 / -1; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact_form",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "richtext", "id": "intro", "label": "t:labels.intro" }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
