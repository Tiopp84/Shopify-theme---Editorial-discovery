<script src="{{ 'collection-facets.js' | asset_url }}" defer></script>

<collection-discovery
  data-section-id="{{ section.id }}"
  data-loading-text="{{ 'collections.facets.loading' | t | escape }}"
  data-updated-text="{{ 'collections.facets.updated' | t | escape }}"
  data-error-text="{{ 'collections.facets.error' | t | escape }}"
  style="{% render 'section-color-scheme', scheme: section.settings.color_scheme %}"
>
  <p class="visually-hidden" role="status" aria-live="polite" data-collection-status></p>

  {% liquid
    assign collection_header_layout = section.settings.header_layout | default: 'text_only'
    assign show_header_media = false
    if section.settings.show_collection_image and collection_header_layout != 'text_only' and collection.featured_image != blank
      assign show_header_media = true
    endif
    assign collection_banner_overlay = 45
    if section.settings.image_banner_overlay == 'light'
      assign collection_banner_overlay = 25
    elsif section.settings.image_banner_overlay == 'strong'
      assign collection_banner_overlay = 65
    endif
  %}
  <header class="collection-header collection-header--{{ collection_header_layout }}{% unless show_header_media %} collection-header--text-only{% endunless %}" style="--collection-banner-overlay: {{ collection_banner_overlay }}%;">
    <div class="collection-header__content">
      <p class="collection-header__eyebrow">{{ 'collections.eyebrow' | t }}</p>
      <h1>{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}<div class="collection-header__description">{{ collection.description }}</div>{% endif %}
    </div>
    {% if show_header_media %}
      <div class="collection-header__aside collection-header__aside--media">
        {% render 'image',
          class: 'collection-header__image',
          image: collection.featured_image,
          alt: collection.featured_image.alt,
          width: 1200,
          widths: '480, 720, 960, 1200',
          sizes: '(min-width: 64rem) 34vw, 100vw',
          loading: 'eager'
        %}
      </div>
    {% endif %}
  </header>

  {% paginate collection.products by section.settings.products_per_page %}
    <div class="collection-controls">
      {% if collection.filters != empty and section.settings.desktop_filter_layout == 'drawer' %}
        <div class="collection-desktop-drawer" data-facets-panel>
          <button type="button" class="collection-desktop-drawer__open" data-facets-open>
            {% render 'icon', name: 'filter' %}
            <span>{{ 'collections.facets.filters' | t }}</span>
          </button>
          <dialog class="collection-facets-dialog" aria-labelledby="DesktopFacetsTitle" data-facet-dialog="desktop" data-overlay-motion="drawer-start" scroll-lock>
            <div class="collection-facets-dialog__header">
              <div>
                <h2 id="DesktopFacetsTitle">{{ 'collections.facets.filters' | t }}</h2>
                <p>{{ 'collections.product_count' | t: count: collection.products_count }}</p>
              </div>
              <button type="button" aria-label="{{ 'collections.facets.close' | t }}" data-facets-close>
                {% render 'icon', name: 'close' %}
              </button>
            </div>
            {% render 'facets',
              results: collection,
              form_id: 'CollectionFiltersDrawer',
              show_sort: false,
              open_groups: false
            %}
          </dialog>
        </div>
      {% endif %}

      <p class="collection-controls__count" role="status" data-collection-count>
        {{ 'collections.product_count' | t: count: collection.products_count }}
      </p>

      <div class="collection-mobile-facets" data-facets-panel>
        <button type="button" class="collection-mobile-facets__open" data-facets-open>
          {{ 'collections.facets.filters' | t }}
          {% if collection.filters != empty -%}
            <span aria-hidden="true">+</span>
          {%- endif %}
        </button>
        <dialog class="collection-facets-dialog" aria-labelledby="MobileFacetsTitle" data-facet-dialog="mobile" data-overlay-motion="sheet" scroll-lock>
          <div class="collection-facets-dialog__header">
            <h2 id="MobileFacetsTitle">{{ 'collections.facets.filter_and_sort' | t }}</h2>
            <button type="button" aria-label="{{ 'collections.facets.close' | t }}" data-facets-close>
              {% render 'icon', name: 'close' %}
            </button>
          </div>
          {% render 'facets',
            results: collection,
            form_id: 'CollectionFiltersMobile',
            show_sort: true,
            sort_as_radios: true,
            open_groups: false
          %}
        </dialog>
      </div>

      <div class="collection-sort">
        {% render 'facets', results: collection, form_id: 'CollectionSort', show_sort: true, sort_as_menu: true, sort_only: true %}
      </div>
    </div>

    {% assign active_filter_count = 0 %}
    {% for filter in collection.filters %}
      {% assign active_filter_count = active_filter_count | plus: filter.active_values.size %}
      {% if filter.type == 'price_range' %}
        {% if filter.min_value.value or filter.max_value.value %}
          {% assign active_filter_count = active_filter_count | plus: 1 %}
        {% endif %}
      {% endif %}
    {% endfor %}

    <div data-collection-active-facets>
      {% if active_filter_count > 0 %}
        <div class="active-facets" aria-label="{{ 'collections.facets.active_filters' | t }}">
          {% for filter in collection.filters %}
            {% for value in filter.active_values %}
              <a href="{{ value.url_to_remove }}">
                {{- value.label | escape }}
                <span aria-hidden="true">×</span></a
              >
            {% endfor %}
            {% if filter.type == 'price_range' and filter.min_value.value or filter.max_value.value %}
              <a href="{{ filter.url_to_remove }}">
                {{ filter.min_value.value | default: 0 | money }}–
                {{- filter.max_value.value | default: filter.range_max | money }}
                <span aria-hidden="true">×</span>
              </a>
            {% endif %}
          {% endfor %}
          <a class="active-facets__clear" href="{{ collection.url }}">{{ 'collections.facets.clear_all' | t }}</a>
        </div>
      {% endif %}
    </div>

    <div
      class="collection-results"
      data-collection-results
      {% if collection.filters == empty or section.settings.desktop_filter_layout == 'drawer' %}
        data-without-filters
      {% endif %}
    >
      {% if collection.filters != empty and section.settings.desktop_filter_layout == 'sidebar' %}
        <aside class="collection-desktop-facets" aria-label="{{ 'collections.facets.filters' | t }}">
          {% render 'facets',
            results: collection,
            form_id: 'CollectionFiltersDesktop',
            show_sort: false,
            open_groups: true
          %}
        </aside>
      {% endif %}

      <div class="collection-results__products">
        {% if collection.products_count > 0 %}
          {% liquid
            assign story = collection.metafields.custom.collection_story.value
            assign show_collection_story = false
            if section.settings.show_collection_story and story != blank and story.heading.value != blank
              assign show_collection_story = true
            endif

            assign story_insert_after = section.settings.collection_story_position
            assign story_row_remainder = story_insert_after | modulo: section.settings.columns_desktop
            if story_row_remainder != 0
              assign story_insert_after = story_insert_after | plus: section.settings.columns_desktop | minus: story_row_remainder
            endif
          %}
          <div class="product-grid" style="--product-grid-columns: {{ section.settings.columns_desktop }}; --product-grid-columns-mobile: {{ section.settings.columns_mobile }};">
            {% for product in collection.products %}
              {% render 'product-card',
                product: product,
                show_vendor: section.settings.show_vendor,
                show_badge: section.settings.show_badge,
                show_quick_add: section.settings.show_quick_add,
                image_ratio: section.settings.image_ratio,
                sizes: '(min-width: 60rem) 25vw, 50vw',
                card_index: forloop.index,
                card_count: forloop.length,
                entrance_delay: 0
              %}
              {% if show_collection_story and forloop.index == story_insert_after %}
                <article class="collection-story-card" aria-labelledby="CollectionStory-{{ section.id }}">
                  {% if story.image.value %}
                    {% render 'image',
                      class: 'collection-story-card__image',
                      image: story.image.value,
                      alt: story.image.value.alt,
                      width: 1200,
                      widths: '480, 720, 960, 1200',
                      sizes: '(min-width: 60rem) 50vw, 100vw'
                    %}
                  {% endif %}
                  <div class="collection-story-card__content">
                    {% if story.eyebrow.value != blank %}
                      <p>{{ story.eyebrow.value | escape }}</p>
                    {% endif %}
                    <h2 id="CollectionStory-{{ section.id }}">{{ story.heading.value | escape }}</h2>
                    {% if story.body.value != blank %}
                      <div>{{ story.body | metafield_tag }}</div>
                    {% endif %}
                    {% if story.link.value != blank %}
                      <a href="{{ story.link.value }}">
                        {{- story.link_label.value | default: story.link.value | escape -}}
                      </a>
                    {% endif %}
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>

          {% render 'pagination', paginate: paginate %}
        {% else %}
          <div class="collection-empty">
            <h2>{{ 'collections.empty_title' | t }}</h2>
            <p>{{ 'collections.empty_text' | t }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  {% endpaginate %}
</collection-discovery>

{% stylesheet %}
  .collection-header {
    padding-block: clamp(var(--space-12), 4vw, var(--space-16));
    border-block-end: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    align-items: end;
    gap: clamp(var(--space-6), 6vw, 6rem);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  collection-discovery {
    display: block;
    min-width: 0;
  }

  collection-discovery[aria-busy] .collection-results__products {
    pointer-events: none;
  }

  .collection-header__eyebrow {
    margin-block-end: var(--space-3);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .collection-header h1 {
    font-size: clamp(3rem, 7vw, 6rem);
  }

  .collection-header__description {
    max-width: 34rem;
    margin-block-start: var(--space-4);
  }

  .collection-header__aside {
    width: 100%;
    align-self: center;
    justify-self: center;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .collection-header__aside--media {
    place-items: stretch;
  }

  .collection-header__image {
    aspect-ratio: 16 / 10;
    background: color-mix(in srgb, var(--color-border) 30%, var(--color-background));
  }

  .collection-header__image > img {
    height: 100%;
    object-fit: cover;
  }

  .collection-header--text_only,
  .collection-header--text-only { grid-template-columns: minmax(0, 1fr); }
  .collection-header--image_banner { align-items: end; grid-template-columns: minmax(0, 1fr); min-block-size: clamp(22rem, 48vw, 38rem); overflow: hidden; position: relative; }
  .collection-header--image_banner .collection-header__content { color: var(--color-foreground); max-inline-size: 42rem; padding: clamp(var(--space-5), 4vw, var(--space-8)); position: relative; z-index: 1; }
  .collection-header--image_banner .collection-header__aside { inset: 0; position: absolute; }
  .collection-header--image_banner .collection-header__image { aspect-ratio: auto; block-size: 100%; position: relative; }
  .collection-header--image_banner .collection-header__image::after { background: color-mix(in srgb, var(--color-background) var(--collection-banner-overlay, 45%), transparent); content: ''; inset: 0; position: absolute; }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--product-grid-columns), minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    padding-block-start: var(--space-6);
  }

  .collection-story-card {
    min-width: 0;
    grid-column: 1 / -1;
    min-block-size: 30rem;
    border-block: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.9fr);
    align-items: stretch;
  }

  .collection-story-card .collection-story-card__image {
    height: 100%;
    min-height: 0;
    aspect-ratio: auto;
    background: color-mix(in srgb, var(--color-border) 30%, var(--color-background));
  }

  .collection-story-card .collection-story-card__image > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-story-card__content {
    min-width: 0;
    padding: clamp(var(--space-6), 5vw, var(--space-12));
    display: grid;
    align-content: center;
    gap: var(--space-3);
  }

  .collection-story-card__content p {
    color: color-mix(in srgb, currentcolor 62%, transparent);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .collection-story-card__content h2 {
    font-size: clamp(1.5rem, 2.4vw, 2.5rem);
    line-height: 1.05;
  }

  .collection-story-card__content a {
    width: fit-content;
    margin-block-start: var(--space-2);
    text-underline-offset: 0.2em;
  }

  .collection-controls {
    min-height: 3.5rem;
    padding-block: var(--space-1);
    border-block-end: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
  }

  .collection-controls__count {
    color: color-mix(in srgb, currentcolor 70%, transparent);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .collection-mobile-facets {
    display: none;
  }

  .collection-desktop-drawer__open {
    min-height: 2.25rem;
    padding: var(--space-2) 0;
    border: 0;
    background: transparent;
    color: currentcolor;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .collection-facets-dialog {
    width: min(85vw, 28rem);
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    margin-inline-end: auto;
    padding: var(--space-4);
    border: 0;
  }

  .collection-facets-dialog::backdrop { background: transparent; }
  .collection-facets-dialog[open][data-overlay-visible]::backdrop { background: rgb(0 0 0 / 45%); }

  .collection-facets-dialog__header {
    margin-block-end: var(--space-4);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: center;
  }

  .collection-facets-dialog__header::before {
    content: '';
    width: 2.75rem;
    flex: none;
  }

  .collection-facets-dialog__header > div {
    flex: 1;
  }

  .collection-facets-dialog__header h2 {
    font-family: var(--font-primary--family);
    font-size: 1rem;
  }

  .collection-facets-dialog__header p {
    color: color-mix(in srgb, currentcolor 65%, transparent);
    font-size: 0.8rem;
  }

  .collection-facets-dialog__header button {
    min-width: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: currentcolor;
    display: grid;
    place-items: center;
  }

  .collection-facets-dialog .facets__group summary {
    padding-block: var(--space-6);
  }

  .collection-sort .facets {
    position: relative;
    min-block-size: 2.5rem;
    gap: 0;
  }

  .collection-sort .facets__sort-menu--popover {
    position: absolute;
    z-index: 3;
    inset-block-start: 0;
    inset-inline-end: 0;
    min-inline-size: 12rem;
    border: 0;
  }

  .collection-sort .facets__sort-menu--popover summary {
    min-height: 2.5rem;
    padding: .4rem .75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 48%, var(--color-border));
    border-radius: .625rem;
    background: var(--color-background);
    font-size: .85rem;
  }

  .collection-sort .facets__sort-menu--popover summary > span {
    display: none;
  }

  .collection-sort .facets__sort-menu--popover summary strong {
    font: inherit;
  }

  .collection-sort .facets__sort-menu--popover summary:is(:hover, :focus-visible) {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-options {
    position: absolute;
    z-index: 1;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-end: 0;
    min-inline-size: 100%;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: .625rem;
    background: var(--color-background);
    box-shadow: 0 .75rem 1.5rem color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-option {
    position: relative;
    min-height: 2.4rem;
    border-radius: .35rem;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-option:hover {
    background: var(--color-accent-tint);
    transform: translateX(.2rem);
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-option:has(input:checked) {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-option:has(input:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-option input[type='radio'] {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
  }

  .collection-results {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: var(--space-8);
  }

  .collection-results[data-without-filters] {
    grid-template-columns: 1fr;
  }

  .collection-desktop-facets {
    padding-block-start: var(--space-6);
  }

  .active-facets {
    padding-block: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .active-facets a {
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .active-facets__clear {
    border-color: transparent !important;
    text-decoration: underline !important;
    text-underline-offset: 0.2em;
  }

  .collection-empty {
    padding-block: clamp(var(--space-8), 12vw, 10rem);
    text-align: center;
  }

  @media (max-width: 63.99rem) {
    .collection-header {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .product-grid {
      grid-template-columns: repeat(var(--product-grid-columns-mobile, 2), minmax(0, 1fr));
    }

    .collection-story-card {
      grid-column: 1 / -1;
      min-block-size: 0;
      grid-template-columns: 1fr;
    }

    .collection-story-card .collection-story-card__image {
      height: auto;
      aspect-ratio: 16 / 10;
    }

    .collection-header--image_banner { min-block-size: 20rem; }

    .collection-controls {
      min-height: 3rem;
      display: flex;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .collection-controls__count {
      flex: 1;
    }

    .collection-sort {
      display: none;
    }

    .collection-mobile-facets {
      display: block;
      flex: none;
    }

    .collection-mobile-facets__open {
      width: auto;
      min-height: 2.25rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: currentcolor;
      font-size: 0.8rem;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }

    .collection-desktop-drawer {
      display: none;
    }

    .collection-results {
      grid-template-columns: 1fr;
    }

    .collection-desktop-facets {
      display: none;
    }
  }

  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .collection-header {
      grid-template-columns: minmax(0, 1.35fr) minmax(14rem, .65fr);
    }

    .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .collection-story-card {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, .8fr);
      min-block-size: 24rem;
    }

    .collection-story-card .collection-story-card__image {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  @media (max-width: 21.25rem) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "t:labels.show_collection_image",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "base", "label": "t:options.color_scheme.base" },
        { "value": "soft", "label": "t:options.color_scheme.soft" },
        { "value": "dark", "label": "t:options.color_scheme.dark" }
      ],
      "default": "base"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "t:labels.collection_header_layout",
      "options": [
        { "value": "text_only", "label": "t:options.collection_header_layout.text_only" },
        { "value": "image_beside", "label": "t:options.collection_header_layout.image_beside" },
        { "value": "image_banner", "label": "t:options.collection_header_layout.image_banner" }
      ],
      "default": "image_beside"
    },
    {
      "type": "select",
      "id": "image_banner_overlay",
      "label": "t:labels.image_banner_overlay",
      "visible_if": "{{ section.settings.header_layout == 'image_banner' }}",
      "options": [
        { "value": "light", "label": "t:options.overlay.light" },
        { "value": "standard", "label": "t:options.overlay.standard" },
        { "value": "strong", "label": "t:options.overlay.strong" }
      ],
      "default": "standard"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "t:labels.products_per_page",
      "default": 20
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:labels.columns_desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.mobile_product_columns",
      "options": [
        { "value": "1", "label": "t:options.columns.one" },
        { "value": "2", "label": "t:options.columns.two" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "1 / 1", "label": "t:options.image_ratio.square" },
        { "value": "4 / 5", "label": "t:options.image_ratio.portrait" },
        { "value": "3 / 4", "label": "t:options.image_ratio.tall" }
      ],
      "default": "4 / 5"
