{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections['all']
  endif
%}

<section class="featured-edit" data-home-reveal="featured-edit" {% if section.settings.heading != blank %}aria-labelledby="FeaturedEditHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <header class="featured-edit__header">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="featured-edit__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 id="FeaturedEditHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>
    {% if section.settings.link_label != blank and section.settings.link != blank %}
      <a class="featured-edit__link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
    {% elsif featured_collection != blank %}
      <a class="featured-edit__link" href="{{ featured_collection.url }}">{{ 'navigation.view_all' | t: title: featured_collection.title }}</a>
    {% endif %}
  </header>

  {% if featured_collection != blank and featured_collection.products_count > 0 %}
    <ul class="featured-edit__grid" data-home-reveal-group="cards" role="list">
      {% for product in featured_collection.products limit: section.settings.product_limit %}
        <li>{% render 'product-card', product: product, card_context: 'homepage', image_ratio: '4 / 5', sizes: '(min-width: 75rem) 22vw, (min-width: 48rem) 30vw, 46vw' %}</li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

{% stylesheet %}
  .featured-edit { margin: 0 auto var(--space-chapter); max-width: var(--page-width); padding-inline: var(--page-margin); }
  .featured-edit__header { align-items: end; border-block-start: 1px solid var(--color-border); display: flex; gap: var(--space-4); justify-content: space-between; margin-block-end: var(--space-5); padding-block-start: var(--space-4); }
  .featured-edit__eyebrow { font-size: .6875rem; font-weight: 600; letter-spacing: .1em; margin: 0 0 var(--space-2); text-transform: uppercase; }
  .featured-edit h2 { font-family: var(--font-campaign); font-size: clamp(2rem, 3.6vw, 3.5rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.03em; line-height: .98; margin: 0; }
  .featured-edit__link { color: currentcolor; flex: 0 0 auto; font-size: .6875rem; font-weight: 600; letter-spacing: .08em; padding-block-end: .25rem; text-decoration: none; text-transform: uppercase; }
  .featured-edit__link:is(:hover, :focus-visible) { color: var(--color-accent); text-decoration: underline; text-underline-offset: .2em; }
  .featured-edit__grid { display: grid; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
  .featured-edit__grid > li { min-width: 0; }
  .featured-edit .product-card__meta { display: none; }
  .featured-edit .product-card__content { border-block-start: 1px solid var(--color-border); padding-block-start: var(--space-3); }
  .featured-edit .product-card__title { font-size: .875rem; font-weight: 600; line-height: 1.25; }
  @media (min-width: 48rem) { .featured-edit__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 75rem) { .featured-edit__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 47.99rem) {
    .featured-edit { margin-block-end: var(--space-chapter-mobile); }
    .featured-edit__header { align-items: start; margin-block-end: var(--space-4); }
    .featured-edit h2 { font-size: 1.8rem; }
    .featured-edit__link { font-size: .5625rem; }
    .featured-edit__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
    .featured-edit .product-card__title { font-size: .6875rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_edit",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    { "type": "range", "id": "product_limit", "label": "t:labels.product_limit", "min": 3, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "The edit" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Pieces for right now" },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label" },
    { "type": "url", "id": "link", "label": "t:labels.link" }
  ],
  "presets": [{ "name": "t:general.featured_edit" }]
}
{% endschema %}
