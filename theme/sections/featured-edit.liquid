{% liquid
  assign featured_collection = section.settings.collection
  assign product_limit = section.settings.desktop_columns | times: section.settings.desktop_rows
  assign product_count = featured_collection.products_count | at_most: product_limit
%}

<section class="featured-edit full-width featured-edit--heading-{{ section.settings.heading_size }} featured-edit--heading-{{ section.settings.heading_alignment }} featured-edit--columns-{{ section.settings.desktop_columns }}" data-aos-section style="--featured-edit-background: var(--color-background); {% render 'section-color-scheme', scheme: section.settings.color_scheme %}" {% if section.settings.heading != blank %}aria-labelledby="FeaturedEditHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <header class="featured-edit__header" data-aos="fade-down">
    {% if section.settings.heading != blank %}<h2 id="FeaturedEditHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
  </header>

  {% if featured_collection != blank and featured_collection.products_count > 0 %}
    <div class="featured-edit__grid-actions">
      <a class="featured-edit__view-all" href="{{ featured_collection.url }}">{{ 'navigation.view_all' | t: title: featured_collection.title }}</a>
    </div>
    <ul class="featured-edit__grid curated-grid--center-incomplete" role="list">
      {% for product in featured_collection.products limit: product_limit %}
        <li data-aos-product-item data-aos="fade-up" data-aos-delay="{{ forloop.index0 | at_most: 3 | times: 100 }}">{% render 'product-card', product: product, card_context: 'homepage', card_index: forloop.index, card_count: product_count, image_ratio: section.settings.image_ratio, show_index: section.settings.show_index, show_price: section.settings.show_price, show_second_image: section.settings.show_second_image, sizes: '(min-width: 64rem) 23vw, (min-width: 48rem) 44vw, 46vw' %}</li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="featured-edit__grid-actions featured-edit__grid-actions--preview">
      <span class="featured-edit__view-all">{{ 'navigation.view_all_label' | t }}</span>
    </div>
    <ul class="featured-edit__grid featured-edit__grid--preview" role="presentation" aria-hidden="true">
      {% for index in (1..4) %}
        {% assign placeholder_image = 'product-' | append: index %}
        <li class="featured-edit__preview-card">
          <span class="featured-edit__preview-media" style="--featured-edit-preview-ratio: {{ section.settings.image_ratio }};">{{ placeholder_image | placeholder_svg_tag }}</span>
          <span class="featured-edit__preview-meta">
            <span class="featured-edit__preview-title">{{ 'products.card.placeholder_title' | t }}</span>
            <span class="featured-edit__preview-price">{{ 'products.card.placeholder_price' | t }}</span>
          </span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

{% stylesheet %}
  .featured-edit { --featured-edit-gutter: clamp(1.25rem, 3.3vw, 3.75rem); background: var(--featured-edit-background, transparent); margin: 0 0 var(--space-chapter); max-width: none; padding: clamp(1.5rem, 4vw, 3rem) var(--featured-edit-gutter); }
  .featured-edit__header { margin-block-end: clamp(1.5rem, 5vw, 3rem); }
  .featured-edit h2 { font-family: var(--font-campaign); font-size: clamp(2.35rem, 4.2vw, 4rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.04em; line-height: .93; margin: 0; }
  .featured-edit--heading-small h2 { font-size: clamp(1.85rem, 3vw, 2.75rem); }
  .featured-edit--heading-medium h2 { font-size: clamp(2.35rem, 4.2vw, 4rem); }
  .featured-edit--heading-large h2 { font-size: clamp(2.75rem, 5.5vw, 5.5rem); }
  .featured-edit--heading-left .featured-edit__header { text-align: start; }
  .featured-edit--heading-center .featured-edit__header { text-align: center; }
  .featured-edit--heading-right .featured-edit__header { text-align: end; }
  .featured-edit__grid-actions { display: flex; justify-content: end; margin-block-end: var(--space-4); }
  .featured-edit__view-all { align-items: center; color: currentcolor; display: inline-flex; font-size: .6875rem; font-weight: 700; gap: .55rem; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
  .featured-edit__view-all::after { content: '→'; font-size: 1.1rem; font-weight: 400; line-height: .7; transition: transform 180ms ease; }
  .featured-edit__view-all:is(:hover, :focus-visible) { color: var(--color-accent); }
  .featured-edit__view-all:is(:hover, :focus-visible)::after { transform: translateX(.25rem); }
  .featured-edit__grid { --featured-edit-grid-gap: clamp(var(--space-3), 2vw, var(--space-5)); align-items: start; display: flex; flex-wrap: wrap; gap: var(--featured-edit-grid-gap); justify-content: center; list-style: none; margin: 0; padding: 0; }
  .featured-edit__grid > li { flex: 0 0 calc((100% - var(--featured-edit-grid-gap)) / 2); min-width: 0; }
  .featured-edit__preview-card { display: grid; gap: var(--space-2); }
  .featured-edit__preview-media { aspect-ratio: var(--featured-edit-preview-ratio); background: color-mix(in srgb, var(--color-foreground) 8%, var(--featured-edit-background, var(--color-background))); border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent); display: block; overflow: hidden; }
  .featured-edit__preview-media > svg { block-size: 100%; inline-size: 100%; }
  .featured-edit__preview-meta { display: grid; gap: .1rem; }
  .featured-edit__preview-title { font-size: .6875rem; line-height: 1.2; }
  .featured-edit__preview-price { font-size: .625rem; line-height: 1.2; }
  .featured-edit .product-card { align-content: start; gap: var(--space-3); min-height: 0; }
  .featured-edit .product-card__media { background: color-mix(in srgb, var(--featured-edit-background, var(--color-background)) 82%, white); border: 0; padding: 0; }
  .featured-edit .product-card__media::after { content: none; }
  .featured-edit .product-card__content { display: grid; gap: var(--space-2); min-width: 0; padding-block-start: var(--space-3); }
  .featured-edit .product-card__meta { display: block; font-size: .625rem; font-weight: 700; letter-spacing: .12em; }
  .featured-edit .product-card__decision { align-items: start; display: grid; gap: var(--space-3); grid-template-columns: minmax(0, 1fr) max-content; min-width: 0; }
  .featured-edit .product-card__title { font-family: var(--font-campaign); font-size: clamp(.95rem, 1.2vw, 1.15rem); font-weight: var(--font-heading--weight); line-height: 1.12; min-block-size: 2.24em; }
  .featured-edit .product-card__price { align-self: start; font-size: .875rem; font-weight: 700; justify-content: flex-end; min-inline-size: 0; }
  /* When Featured Edit directly follows the hero, its introduction becomes a
   * continuation panel rather than starting a visually separate chapter. The
   * product grid remains in normal flow, so section editing and long copy stay safe. */
  @supports selector(.shopify-section:has(> .editorial-hero)) {
    .shopify-section:has(> .editorial-hero) > .editorial-hero { border-block-end: 0; margin-block-end: 0; }
    .shopify-section:has(> .editorial-hero) + .shopify-section:has(> .featured-edit) > .featured-edit {
      --featured-edit-bridge: clamp(2.5rem, 5vw, 4.5rem);
      margin-block-end: 0;
      padding-block-end: var(--space-chapter);
      padding-block-start: 0;
      position: relative;
    }
    .shopify-section:has(> .editorial-hero) + .shopify-section:has(> .featured-edit) .featured-edit__header {
      background: var(--featured-edit-background, var(--color-background));
      border-radius: clamp(1.25rem, 2.4vw, 2rem) clamp(1.25rem, 2.4vw, 2rem) 0 0;
      margin-block-start: calc(var(--featured-edit-bridge) * -1);
      padding: clamp(1.5rem, 3vw, 2.5rem);
      position: relative;
      z-index: 2;
    }
  }

  @media (min-width: 64rem) {
    .featured-edit { padding-inline: clamp(7.5rem, 10vw, 12rem); }
    .featured-edit--columns-3 .featured-edit__grid > li { flex-basis: calc((100% - var(--featured-edit-grid-gap) - var(--featured-edit-grid-gap)) / 3); }
    .featured-edit--columns-4 .featured-edit__grid > li { flex-basis: calc((100% - var(--featured-edit-grid-gap) - var(--featured-edit-grid-gap) - var(--featured-edit-grid-gap)) / 4); }
  }
  @media (max-width: 47.99rem) {
    .featured-edit { margin-block-end: var(--space-chapter-mobile); padding-block: var(--space-5); }
    .featured-edit__header { margin-block-end: var(--space-5); }
    .featured-edit h2 { font-size: 2.25rem; }
    .featured-edit__view-all { font-size: .5625rem; }
    .featured-edit__grid { --featured-edit-grid-gap: var(--space-3); }
    .featured-edit .product-card { gap: var(--space-2); }
    .featured-edit .product-card__status { padding: .3rem .4rem; }
    .featured-edit .product-card__content { gap: .35rem; padding-block-start: var(--space-2); }
    .featured-edit .product-card__meta { font-size: .55rem; letter-spacing: .09em; }
    .featured-edit .product-card__decision { gap: var(--space-2); }
    .featured-edit .product-card__title { font-size: .9rem; line-height: 1.08; min-inline-size: 0; }
    .featured-edit .product-card__price { font-size: .75rem; max-inline-size: 100%; min-inline-size: 0; }
  }
  @media (max-width: 30rem) {
    .featured-edit .product-card__decision { grid-template-columns: minmax(0, 1fr); }
    .featured-edit .product-card__price { justify-content: flex-start; text-align: start; }
  }
  @media (max-width: 47.99rem) {
    @supports selector(.shopify-section:has(> .editorial-hero)) {
      .shopify-section:has(> .editorial-hero) + .shopify-section:has(> .featured-edit) > .featured-edit { --featured-edit-bridge: 1.5rem; margin-block-end: 0; padding-block-end: var(--space-chapter-mobile); }
      .shopify-section:has(> .editorial-hero) + .shopify-section:has(> .featured-edit) .featured-edit__header { border-radius: 1.25rem 1.25rem 0 0; padding: var(--space-5); }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_edit",
  "settings": [
    { "type": "header", "content": "t:general.content" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Featured collection" },
    { "type": "select", "id": "heading_size", "label": "t:labels.heading_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "medium" },
    { "type": "select", "id": "heading_alignment", "label": "t:labels.heading_alignment", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left" },
    { "type": "header", "content": "t:general.products" },
    { "type": "checkbox", "id": "show_price", "label": "t:labels.show_price", "default": true },
    { "type": "checkbox", "id": "show_index", "label": "t:labels.show_index", "default": true },
    { "type": "select", "id": "desktop_columns", "label": "t:labels.desktop_product_columns", "options": [{ "value": "3", "label": "t:options.columns.three" }, { "value": "4", "label": "t:options.columns.four" }], "default": "4" },
    { "type": "range", "id": "desktop_rows", "label": "t:labels.desktop_product_rows", "min": 1, "max": 4, "step": 1, "default": 1 },
    { "type": "header", "content": "t:general.layout" },
    { "type": "select", "id": "image_ratio", "label": "t:labels.image_size", "options": [{ "value": "1 / 1", "label": "t:options.image_ratio.square" }, { "value": "4 / 5", "label": "t:options.image_ratio.portrait" }, { "value": "3 / 4", "label": "t:options.image_ratio.tall" }], "default": "4 / 5" },
    { "type": "checkbox", "id": "show_second_image", "label": "t:labels.show_second_image", "default": true },
    { "type": "header", "content": "t:general.style" },
    { "type": "select", "id": "color_scheme", "label": "t:labels.color_scheme", "options": [{ "value": "base", "label": "t:options.color_scheme.base" }, { "value": "soft", "label": "t:options.color_scheme.soft" }, { "value": "dark", "label": "t:options.color_scheme.dark" }], "default": "base" }
  ],
  "enabled_on": { "templates": ["index"] },
  "presets": [{ "name": "t:general.featured_edit", "category": "Products & collections" }]
}
{% endschema %}
