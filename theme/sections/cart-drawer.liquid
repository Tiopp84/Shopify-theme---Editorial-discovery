{% liquid
  assign cart_discount_total = 0
  for discount in cart.cart_level_discount_applications
    assign cart_discount_total = cart_discount_total | plus: discount.total_allocated_amount
  endfor
%}

<cart-drawer class="cart-drawer" data-cart-drawer data-cart-url="{{ routes.cart_url }}" data-cart-currency="{{ cart.currency.iso_code }}" data-cart-total-cents="{{ cart.total_price }}" data-cart-discount-cents="{{ cart_discount_total }}" data-cart-note="{{ cart.note | escape }}" data-cart-empty-text="{{ 'cart.empty_text' | t | escape }}" data-cart-continue-shopping="{{ 'cart.continue_shopping' | t | escape }}" data-cart-view-cart="{{ 'cart.view_cart' | t | escape }}" data-cart-subtotal-label="{{ 'cart.subtotal' | t | escape }}" data-cart-checkout-label="{{ 'cart.checkout' | t | escape }}" data-cart-updating-label="{{ 'cart.updating' | t | escape }}" data-cart-taxes-note="{{ 'cart.taxes_and_shipping_at_checkout' | t | escape }}" data-cart-remove-label="{{ 'cart.remove' | t | escape }}" data-cart-decrease-label="{{ 'cart.decrease_quantity' | t | escape }}" data-cart-increase-label="{{ 'cart.increase_quantity' | t | escape }}" data-cart-each-label="{{ 'cart.each' | t | escape }}" data-cart-show-note="{{ settings.cart_show_note }}" data-cart-note-label="{{ 'cart.note' | t | escape }}" data-cart-note-placeholder="{{ 'cart.note_placeholder' | t | escape }}" data-cart-note-saving-message="{{ 'cart.note_saving' | t | escape }}" data-cart-note-saved-message="{{ 'cart.note_saved' | t | escape }}" data-cart-note-error-message="{{ 'cart.note_error' | t | escape }}">
  <dialog class="cart-drawer__dialog" aria-labelledby="CartDrawerTitle-{{ section.id }}" data-cart-dialog data-overlay-motion="drawer-end" scroll-lock>
    <div class="cart-drawer__header" data-drawer-entrance="header">
      <h2 id="CartDrawerTitle-{{ section.id }}">{{ 'cart.title' | t }}</h2>
      <button type="button" aria-label="{{ 'cart.close' | t }}" data-cart-close>×</button>
    </div>
    <p class="cart-drawer__status" role="status" aria-live="polite" data-cart-status hidden></p>
    <div class="cart-drawer__body" data-cart-content data-drawer-entrance="body">
      {% if cart.item_count == 0 %}
        <div class="cart-drawer__empty"><p>{{ 'cart.empty_text' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a></div>
      {% else %}
        <form action="{{ routes.cart_url }}" method="post" data-cart-form>
          <div class="cart-drawer__lines">
            {% for item in cart.items %}
              {% assign cart_reference_unit_price = item.original_price %}
              {% if item.variant.compare_at_price > cart_reference_unit_price %}{% assign cart_reference_unit_price = item.variant.compare_at_price %}{% endif %}
              {% if item.selling_plan_allocation.compare_at_price > cart_reference_unit_price %}{% assign cart_reference_unit_price = item.selling_plan_allocation.compare_at_price %}{% endif %}
              {% assign cart_reference_line_price = cart_reference_unit_price | times: item.quantity %}
              <article class="cart-drawer__line" data-cart-line="{{ item.key }}" data-cart-variant-id="{{ item.variant.id }}" data-cart-quantity="{{ item.quantity }}" data-cart-unit-price="{{ item.final_price }}" data-cart-compare-unit-price="{{ cart_reference_unit_price }}">
                <a href="{{ item.url }}">{% render 'image', image: item.image, alt: item.product.title, width: 160, sizes: '80px' %}</a>
                <div class="cart-drawer__line-details">
                  <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}
                  {% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
                  {% for property in item.properties %}{% unless property.last == blank %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endunless %}{% endfor %}
                  {% if item.line_level_discount_allocations.size > 0 %}<ul class="cart-drawer__discounts" role="list">{% for discount in item.line_level_discount_allocations %}<li>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</li>{% endfor %}</ul>{% endif %}
                  <div class="cart-drawer__line-actions">
                    <label class="visually-hidden" for="DrawerQuantity-{{ item.index }}">{{ 'cart.quantity' | t }}</label>
                    <div class="cart-drawer__quantity-control">
                      <button type="button" aria-label="{{ 'cart.decrease_quantity' | t }}" data-cart-quantity-step="-1" data-cart-key="{{ item.key }}" data-cart-quantity-input="DrawerQuantity-{{ item.index }}">−</button>
                      <input id="DrawerQuantity-{{ item.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" inputmode="numeric" data-cart-quantity data-cart-key="{{ item.key }}">
                      <button type="button" aria-label="{{ 'cart.increase_quantity' | t }}" data-cart-quantity-step="1" data-cart-key="{{ item.key }}" data-cart-quantity-input="DrawerQuantity-{{ item.index }}">+</button>
                    </div>
                    <button type="button" aria-label="{{ 'cart.remove' | t }}" title="{{ 'cart.remove' | t }}" data-cart-remove data-cart-key="{{ item.key }}">{% render 'icon', name: 'trash' %}</button>
                  </div>
                </div>
                <div class="cart-drawer__line-price">
                  {% if cart_reference_line_price > item.final_line_price %}<s data-cart-line-compare>{{ cart_reference_line_price | money }}</s>{% endif %}
                  <strong data-cart-line-total>{{ item.final_line_price | money }}</strong>
                  <small data-cart-unit-price>{{ item.final_price | money }} {{ 'cart.each' | t }}</small>
                  {% if item.unit_price_measurement %}<small>{{ item.unit_price | money }} / {{ item.unit_price_measurement.reference_unit }}</small>{% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
          <footer class="cart-drawer__footer">
            {% if cart.cart_level_discount_applications.size > 0 %}<ul class="cart-drawer__discounts" role="list" data-cart-discounts>{% for discount in cart.cart_level_discount_applications %}<li data-cart-cart-discount>{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</li>{% endfor %}</ul>{% endif %}
            {% if settings.cart_show_note %}
              <div class="cart-drawer__note">
                <label for="DrawerCartNote-{{ section.id }}">{{ 'cart.note' | t }}</label>
                <textarea id="DrawerCartNote-{{ section.id }}" name="note" placeholder="{{ 'cart.note_placeholder' | t }}" data-cart-note-input>{{ cart.note }}</textarea>
                <p class="cart-drawer__note-status" data-cart-note-status aria-live="polite"></p>
              </div>
            {% endif %}
            <p class="cart-drawer__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong data-cart-subtotal>{{ cart.total_price | money_with_currency }}</strong></p>
            <p class="cart-drawer__checkout-note">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>
            <button type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
            <a href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
          </footer>
        </form>
        <div class="cart-drawer__empty" data-cart-local-empty hidden><p>{{ 'cart.empty_text' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a></div>
      {% endif %}
    </div>
  </dialog>
</cart-drawer>

{% stylesheet %}
  .cart-drawer__dialog:not([open]) { display: none; }
  .cart-drawer__dialog[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); inset: 0 0 0 auto; inline-size: min(29rem, 100%); block-size: 100dvh; max-inline-size: 100%; max-block-size: none; margin: 0; border: 0; border-radius: 1.25rem 0 0 1.25rem; overflow: hidden; overscroll-behavior: contain; padding: 0; position: fixed; }
  .cart-drawer__header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-block-size: 4.5rem; padding: var(--space-4) var(--space-5); border-block-end: 1px solid var(--color-border); }
  .cart-drawer__status { background: var(--color-background); border: 1px solid color-mix(in srgb, var(--color-status-error) 44%, var(--color-border)); border-radius: 0; box-shadow: 0 .5rem 1.5rem color-mix(in srgb, var(--color-foreground) 14%, transparent); color: var(--color-status-error); font-size: .875rem; inset-block-start: calc(4.5rem + var(--space-3)); inset-inline: var(--space-4); margin: 0; padding: var(--space-3); position: absolute; z-index: 3; }
  .cart-drawer__header h2 { font-size: clamp(var(--heading-size-43), calc(var(--heading-size-43) + 3vw), var(--heading-size-53)); }
  .cart-drawer__header [data-cart-close] { display: grid; place-items: center; inline-size: 2.75rem; min-block-size: 2.75rem; padding: 0; border-color: transparent; border-radius: 50%; background: transparent; color: currentcolor; font-size: 1.4rem; }
  .cart-drawer__header [data-cart-close]:is(:hover, :focus-visible) { background: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background)); }
  .cart-drawer__body { min-block-size: 0; overscroll-behavior: contain; overflow-y: auto; padding: var(--space-5); -webkit-overflow-scrolling: touch; }
  .cart-drawer__body form { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-block-size: 100%; gap: var(--space-5); }
  .cart-drawer__body form[hidden] { display: none; }
  .cart-drawer__lines, .cart-drawer__empty { display: grid; align-content: start; gap: var(--space-4); }
  .cart-drawer__empty[hidden] { display: none; }
  .cart-drawer__line { display: grid; grid-template-columns: 5.25rem minmax(0, 1fr) auto; gap: var(--space-3); border-block-end: 1px solid var(--color-border); padding-block-end: var(--space-4); }
  .cart-drawer__line[hidden] { display: none; }
  .cart-drawer__line img { aspect-ratio: 4 / 5; object-fit: cover; inline-size: 100%; }
  .cart-drawer__line-details { display: grid; align-content: start; gap: var(--space-1); min-inline-size: 0; }
  .cart-drawer__line-details > a { font-weight: 600; line-height: 1.3; text-decoration-thickness: 1px; text-underline-offset: .16em; }
  .cart-drawer__line-details > p { color: color-mix(in srgb, var(--color-foreground) 68%, var(--color-background)); font-size: .9em; }
  .cart-drawer__line-details > .cart-drawer__line-error { background: color-mix(in srgb, var(--color-status-error) 8%, var(--color-background)); border-inline-start: .18rem solid var(--color-status-error); color: var(--color-status-error); font-size: .82rem; line-height: 1.4; margin-block-start: var(--space-2); padding: var(--space-2); }
  .cart-drawer__line-price { display: grid; align-self: start; font-family: var(--product-price-font); font-size: var(--product-price-size-cart-line); justify-items: end; gap: var(--space-1); white-space: nowrap; }
  .cart-drawer__line-price strong { font-size: var(--product-price-size-cart-total); }
  .cart-drawer__line-actions { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-block-start: var(--space-3); }
  .cart-drawer__quantity-control { display: inline-grid; grid-template-columns: 2rem 2.5rem 2rem; align-items: center; border: 1px solid var(--color-border); border-radius: .375rem; overflow: hidden; }
  .cart-drawer__quantity-control button { display: grid; place-items: center; min-block-size: 2.35rem; padding: 0; border: 0; border-radius: 0; background: transparent; color: currentcolor; font-size: 1.15rem; }
  .cart-drawer__quantity-control button:is(:hover, :focus-visible) { background: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background)); }
  .cart-drawer__quantity-control input { inline-size: 100%; min-block-size: 2.35rem; padding: 0; border-block: 0; border-inline: 1px solid var(--color-border); border-radius: 0; text-align: center; }
  .cart-drawer__quantity-control input::-webkit-inner-spin-button { appearance: none; margin: 0; }
  .cart-drawer__line-actions [data-cart-remove] { display: grid; place-items: center; inline-size: 2.35rem; min-block-size: 2.35rem; padding: 0; border: 0; border-radius: 50%; background: transparent; color: currentcolor; }
  .cart-drawer__line-actions [data-cart-remove]:is(:hover, :focus-visible) { background: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background)); }
  .cart-drawer__line-actions [data-cart-remove] .icon { inline-size: 1.1rem; block-size: 1.1rem; }
  .cart-drawer__discounts { margin: 0; padding: 0; list-style: none; color: var(--color-foreground); font-size: .85em; }
  .cart-drawer__footer { display: grid; gap: var(--space-3); padding-block-start: var(--space-4); border-block-start: 1px solid var(--color-border); }
  .cart-drawer__note { display: grid; gap: var(--space-2); }
  .cart-drawer__note label { font-family: var(--small-label-font); font-size: var(--small-label-size); font-weight: 600; letter-spacing: var(--small-label-letter-spacing); line-height: var(--small-label-line-height); text-transform: uppercase; }
  .cart-drawer__note textarea { min-block-size: 5rem; resize: vertical; }
  .cart-drawer__note-status { color: color-mix(in srgb, var(--color-foreground) 62%, var(--color-background)); font-size: .78rem; margin: 0; }
  .cart-drawer[data-cart-pending] [data-cart-line-total], .cart-drawer[data-cart-pending] [data-cart-subtotal] { opacity: .7; }
  .cart-drawer__subtotal { display: flex; align-items: baseline; font-family: var(--product-price-font); font-size: var(--product-price-size-cart-line); justify-content: space-between; gap: var(--space-4); margin: 0; }
  .cart-drawer__subtotal strong { font-size: var(--product-price-size-cart-total); }
  .cart-drawer__checkout-note { color: color-mix(in srgb, var(--color-foreground) 68%, var(--color-background)); font-size: .85em; }
  .cart-drawer__footer [name='checkout'] { inline-size: 100%; min-block-size: var(--button-theme-height); font-family: var(--button-theme-font); font-size: var(--button-theme-font-size); font-weight: 700; letter-spacing: var(--button-theme-letter-spacing); text-transform: uppercase; }
  .cart-drawer__footer [name='checkout'][data-cart-checkout-loading] { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; }
  .cart-drawer__footer [name='checkout'][data-cart-checkout-loading]::before { content: ''; inline-size: .85rem; block-size: .85rem; border: 2px solid currentcolor; border-inline-end-color: transparent; border-radius: 50%; animation: cart-checkout-spin .7s linear infinite; }
  @media (prefers-reduced-motion: reduce) { .cart-drawer__footer [name='checkout'][data-cart-checkout-loading]::before { animation: none; } }
  @keyframes cart-checkout-spin { to { transform: rotate(1turn); } }
  .cart-drawer__footer > a { justify-self: center; font-size: .9em; text-underline-offset: .18em; }
  .cart-drawer__dialog::backdrop { background: transparent; }
  .cart-drawer__dialog[open][data-overlay-visible]::backdrop { background: color-mix(in srgb, var(--overlay-color) var(--overlay-opacity), transparent); }
  @media (prefers-reduced-motion: no-preference) {
    .cart-drawer__dialog [data-drawer-entrance] { opacity: 0; transform: translate3d(0, 1.25rem, 0); transition: opacity 280ms ease, transform 380ms cubic-bezier(.16, 1, .3, 1); transition-delay: 350ms; }
    .cart-drawer__dialog [data-drawer-entrance='body'] { transition-delay: 420ms; }
    .cart-drawer__dialog[open]:is([data-overlay-visible], [data-overlay-closing]) [data-drawer-entrance] { opacity: 1; transform: translate3d(0, 0, 0); }
  }
  @media (max-width: 47.99rem) { dialog.cart-drawer__dialog[data-overlay-motion='drawer-end'] { --overlay-enter-transform: translate3d(0, 100%, 0); } .cart-drawer__dialog[open] { inset: auto 0 0; inline-size: 100%; block-size: min(82dvh, 44rem); margin: 0; border-radius: 1.25rem 1.25rem 0 0; } }
{% endstylesheet %}

{% schema %}
{ "name": "Cart drawer", "settings": [], "enabled_on": { "templates": ["*"] } }
{% endschema %}
