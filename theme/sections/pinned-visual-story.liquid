{% liquid
  assign image_width = section.settings.image_width | default: 58
  assign text_width = 100 | minus: image_width

  assign has_chapters = false
  for block in section.blocks
    if block.settings.heading != blank or block.settings.text != blank or block.settings.image != blank
      assign has_chapters = true
      break
    endif
  endfor
%}

<section class="pinned-visual-story full-width pinned-visual-story--media-{{ section.settings.media_position }} pinned-visual-story--heading-{{ section.settings.heading_size }} pinned-visual-story--heading-{{ section.settings.heading_alignment }} pinned-visual-story--text-{{ section.settings.text_position }} pinned-visual-story--chapters-heading-{{ section.settings.chapter_heading_size }} pinned-visual-story--chapters-text-{{ section.settings.chapter_text_size }} pinned-visual-story--chapters-{{ section.settings.chapter_alignment }}{% unless section.settings.show_chapter_index %} pinned-visual-story--hide-chapter-index{% endunless %}{% if section.settings.enable_image_flip %} pinned-visual-story--image-flip{% endif %}" data-header-scroll-policy="hold-compact-header" data-motion="editorial-chapters"{% if section.settings.enable_image_flip %} data-pinned-story-flip{% endif %}{% if section.settings.enable_chapter_wheel %} data-pinned-story-wheel{% endif %} style="--pinned-story-background: {{ section.settings.background_color }}; --pinned-story-media-height: {{ section.settings.image_height | default: 600 }}px; --pinned-story-media-width: {{ image_width }}fr; --pinned-story-text-width: {{ text_width }}fr;" {% if section.settings.heading != blank %}aria-labelledby="PinnedVisualStoryHeading-{{ section.id }}"{% endif %} {{ section.shopify_attributes }}>
  <header class="pinned-visual-story__intro">
    {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 id="PinnedVisualStoryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
  </header>
  <div class="pinned-visual-story__layout">
    <div class="pinned-visual-story__media" data-header-scroll-target>
      {% assign media_index = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.heading != blank or block.settings.text != blank or block.settings.image != blank %}
          {% assign story_image = block.settings.image %}
          <div class="pinned-visual-story__media-item{% if media_index == 0 %} is-active{% endif %}" data-pinned-story-media>
            {% if story_image != blank %}
              {% render 'image', class: 'pinned-visual-story__image', image: story_image, alt: story_image.alt, width: 1800, widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 64rem) 50vw, 100vw' %}
            {% else %}
              <div class="pinned-visual-story__placeholder" aria-hidden="true">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
            {% endif %}
          </div>
          {% assign media_index = media_index | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% unless has_chapters %}
        <div class="pinned-visual-story__placeholder" aria-hidden="true">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
      {% endunless %}
    </div>
    {% if has_chapters %}
      <div class="pinned-visual-story__chapters">
        <div class="pinned-visual-story__chapter-spacer" aria-hidden="true"></div>
        {% for block in section.blocks %}
          {% if block.settings.heading != blank or block.settings.text != blank or block.settings.image != blank %}
            {% assign story_image = block.settings.image %}
            <article class="pinned-visual-story__chapter" data-home-reveal-chapter {{ block.shopify_attributes }}>
              {% if story_image != blank %}
                <div class="pinned-visual-story__chapter-media">
                  {% render 'image', class: 'pinned-visual-story__chapter-image', image: story_image, alt: story_image.alt, width: 1200, widths: '480, 720, 960, 1200', sizes: '100vw' %}
                </div>
              {% endif %}
              <p class="pinned-visual-story__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
              {% if block.settings.heading != blank %}<h3 data-pinned-story-heading>{{ block.settings.heading | escape }}</h3>{% endif %}
              {% if block.settings.text != blank %}<div class="pinned-visual-story__body">{{ block.settings.text }}</div>{% endif %}
              {% if block.settings.link_label != blank and block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}
            </article>
          {% endif %}
        {% endfor %}
        <div class="pinned-visual-story__chapter-spacer" aria-hidden="true"></div>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .pinned-visual-story { background: var(--pinned-story-background, var(--color-panel-01)); border-block: 1px solid var(--color-border); margin-block-end: var(--space-chapter); padding: clamp(4rem, 7vw, 7rem) max(var(--page-margin), calc((100vw - var(--page-width)) / 2)); }
  .pinned-visual-story__intro { margin-block-end: clamp(2.5rem, 5vw, 5rem); max-width: 35rem; }
  .pinned-visual-story__intro p, .pinned-visual-story__number { font-size: .6875rem; font-weight: 600; letter-spacing: .1em; margin: 0 0 var(--space-3); text-transform: uppercase; }
  .pinned-visual-story__intro h2 { font-family: var(--font-campaign); font-size: clamp(2.4rem, 4.7vw, 5rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.04em; line-height: .94; margin: 0; }
  .pinned-visual-story--heading-small .pinned-visual-story__intro h2 { font-size: clamp(2rem, 3.5vw, 3.5rem); }
  .pinned-visual-story--heading-medium .pinned-visual-story__intro h2 { font-size: clamp(2.4rem, 4.7vw, 5rem); }
  .pinned-visual-story--heading-large .pinned-visual-story__intro h2 { font-size: clamp(2.8rem, 5.8vw, 6rem); }
  .pinned-visual-story--heading-left .pinned-visual-story__intro { text-align: start; }
  .pinned-visual-story--heading-center .pinned-visual-story__intro { text-align: center; }
  .pinned-visual-story--heading-right .pinned-visual-story__intro { text-align: end; }
  .pinned-visual-story--text-left .pinned-visual-story__intro { margin-inline-end: auto; }
  .pinned-visual-story--text-center .pinned-visual-story__intro { margin-inline: auto; }
  .pinned-visual-story--text-right .pinned-visual-story__intro { margin-inline-start: auto; }
  .pinned-visual-story__layout { display: grid; gap: clamp(2.5rem, 7vw, 8rem); }
  .pinned-visual-story__media { block-size: var(--pinned-story-media-height, 600px); background: var(--color-panel-02); overflow: hidden; position: relative; }
  .pinned-visual-story__media-item { backface-visibility: hidden; inset: 0; opacity: 0; position: absolute; transform: perspective(75rem) rotateY(-10deg) scale(.98); }
  .pinned-visual-story--image-flip .pinned-visual-story__media-item { transition: opacity 460ms ease, transform 460ms cubic-bezier(.22, .61, .36, 1); }
  .pinned-visual-story--media-right .pinned-visual-story__media-item { transform: perspective(75rem) rotateY(10deg) scale(.98); }
  .pinned-visual-story__media-item.is-active { opacity: 1; transform: perspective(75rem) rotateY(0) scale(1); }
  .pinned-visual-story--media-right .pinned-visual-story__media-item.is-active { transform: perspective(75rem) rotateY(0) scale(1); }
  .pinned-visual-story__media.is-transitioning .pinned-visual-story__media-item { will-change: opacity, transform; }
  .pinned-visual-story__image, .pinned-visual-story__image > img, .pinned-visual-story__placeholder, .pinned-visual-story__placeholder > svg, .pinned-visual-story__chapter-image, .pinned-visual-story__chapter-image > img { block-size: 100%; display: block; height: 100%; inline-size: 100%; object-fit: cover; width: 100%; }
  .pinned-visual-story__chapters { display: grid; }
  .pinned-visual-story__chapter-spacer { min-block-size: var(--pinned-story-edge-space, clamp(12rem, 30vw, 24rem)); }
  .pinned-visual-story__chapter { align-content: center; border-block-start: 1px solid var(--color-border); display: grid; gap: var(--space-3); min-height: clamp(24rem, 52vh, 38rem); opacity: var(--pinned-story-chapter-opacity, 1); padding-block: var(--space-6); transform: translate3d(var(--pinned-story-chapter-arc, 0), 0, 0) scale(var(--pinned-story-chapter-scale, 1)); transform-origin: center; }
  .pinned-visual-story__chapter:focus-within { opacity: 1; transform: none; }
  .pinned-visual-story__chapter-media { display: none; }
  .pinned-visual-story__chapter h3 { font-family: var(--font-campaign); font-size: clamp(2rem, 3.6vw, 3.8rem); font-style: var(--font-heading--style); font-weight: var(--font-heading--weight); letter-spacing: -.035em; line-height: .98; margin: 0; max-width: 12ch; }
  .pinned-visual-story--chapters-heading-small .pinned-visual-story__chapter h3 { font-size: clamp(1.65rem, 2.5vw, 2.5rem); }
  .pinned-visual-story--chapters-heading-medium .pinned-visual-story__chapter h3 { font-size: clamp(2rem, 3.6vw, 3.8rem); }
  .pinned-visual-story--chapters-heading-large .pinned-visual-story__chapter h3 { font-size: clamp(2.35rem, 4.4vw, 4.6rem); }
  .pinned-visual-story__body { color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background)); font-size: .9375rem; line-height: 1.65; max-width: 29rem; }
  .pinned-visual-story--chapters-text-small .pinned-visual-story__body { font-size: .8125rem; }
  .pinned-visual-story--chapters-text-medium .pinned-visual-story__body { font-size: .9375rem; }
  .pinned-visual-story--chapters-text-large .pinned-visual-story__body { font-size: 1.0625rem; }
  .pinned-visual-story__body > :first-child { margin-block-start: 0; }
  .pinned-visual-story__body > :last-child { margin-block-end: 0; }
  .pinned-visual-story__chapter a { color: currentcolor; font-size: .6875rem; font-weight: 600; letter-spacing: .08em; justify-self: start; text-decoration: underline; text-underline-offset: .25em; text-transform: uppercase; }
  .pinned-visual-story--chapters-left .pinned-visual-story__chapter { justify-items: start; text-align: start; }
  .pinned-visual-story--chapters-center .pinned-visual-story__chapter { justify-items: center; text-align: center; }
  .pinned-visual-story--chapters-right .pinned-visual-story__chapter { justify-items: end; text-align: end; }
  .pinned-visual-story--chapters-center .pinned-visual-story__chapter a { justify-self: center; }
  .pinned-visual-story--chapters-right .pinned-visual-story__chapter a { justify-self: end; }
  .pinned-visual-story__chapter a:is(:hover, :focus-visible) { color: var(--color-accent); }
  @media (min-width: 64rem) {
    .pinned-visual-story__layout { align-items: start; grid-template-columns: minmax(0, var(--pinned-story-media-width)) minmax(18rem, var(--pinned-story-text-width)); }
    .pinned-visual-story__media { position: sticky; top: 6rem; }
    .pinned-visual-story--media-right .pinned-visual-story__layout { grid-template-columns: minmax(18rem, var(--pinned-story-text-width)) minmax(0, var(--pinned-story-media-width)); }
    .pinned-visual-story--media-right .pinned-visual-story__media { grid-column: 2; }
    .pinned-visual-story--media-right .pinned-visual-story__chapters { grid-column: 1; grid-row: 1; }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .pinned-visual-story__layout { align-items: start; grid-template-columns: minmax(0, var(--pinned-story-media-width)) minmax(14rem, var(--pinned-story-text-width)); }
    .pinned-visual-story__media { position: sticky; top: 6rem; }
    .pinned-visual-story--media-right .pinned-visual-story__layout { grid-template-columns: minmax(14rem, var(--pinned-story-text-width)) minmax(0, var(--pinned-story-media-width)); }
    .pinned-visual-story--media-right .pinned-visual-story__media { grid-column: 2; }
    .pinned-visual-story--media-right .pinned-visual-story__chapters { grid-column: 1; grid-row: 1; }
    .pinned-visual-story__chapter { min-height: clamp(20rem, 42vw, 28rem); }
  }
  @media (min-width: 48rem) {
    .pinned-visual-story__chapter { padding-inline-start: 1.25rem; }
    .pinned-visual-story__chapter h3 { position: relative; }
    .pinned-visual-story__chapter h3::before { background: var(--color-accent); block-size: 100%; content: ''; inline-size: 2px; inset-block-start: 0; inset-inline-start: -1.25rem; opacity: 0; position: absolute; transform: scaleY(.25); transform-origin: center; transition: opacity 180ms ease, transform 240ms ease; }
    .pinned-visual-story__number { align-items: center; block-size: 2rem; border: 1px solid transparent; border-radius: 50%; display: inline-flex; inline-size: 2rem; justify-content: center; margin-block-end: 0; transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease; }
    .pinned-visual-story__chapter.is-centered h3::before { opacity: 1; transform: scaleY(1); }
    .pinned-visual-story__chapter.is-centered .pinned-visual-story__number { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-background); }
    .pinned-visual-story__chapter.is-centered h3 { color: var(--color-accent); }
    .pinned-visual-story--media-right .pinned-visual-story__chapter { padding-inline-end: 1.25rem; padding-inline-start: 0; }
    .pinned-visual-story--media-right .pinned-visual-story__chapter h3::before { inset-inline-end: -1.25rem; inset-inline-start: auto; }
  }
  @media (max-width: 47.99rem) {
    .pinned-visual-story { margin-block-end: var(--space-chapter-mobile); padding-block: var(--space-6); }
    .pinned-visual-story__intro { margin-block-end: var(--space-5); }
    .pinned-visual-story__media { display: none; }
    .pinned-visual-story__layout { display: block; }
    .pinned-visual-story__chapter-spacer { display: none; }
    .pinned-visual-story__chapter { min-height: 0; opacity: 1; padding-block: var(--space-5); transform: none; }
    .pinned-visual-story__chapter-media { aspect-ratio: 4 / 5; display: block; margin-block-end: var(--space-3); overflow: hidden; }
    .pinned-visual-story__chapter h3 { font-size: 2rem; }
  }
  .pinned-visual-story--hide-chapter-index .pinned-visual-story__number { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .pinned-visual-story__media-item { transition: none; }
    .pinned-visual-story__chapter { opacity: 1; transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.pinned_visual_story",
  "settings": [
    { "type": "header", "content": "t:general.content" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "The approach" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Built around the way a day moves" },
    { "type": "select", "id": "heading_size", "label": "t:labels.heading_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "medium" },
    { "type": "select", "id": "heading_alignment", "label": "t:labels.heading_alignment", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left" },
    { "type": "header", "content": "t:general.layout" },
    { "type": "select", "id": "text_position", "label": "t:labels.text_position", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left" },
    { "type": "range", "id": "image_width", "label": "t:labels.image_width", "min": 40, "max": 65, "step": 1, "unit": "%", "default": 58 },
    { "type": "range", "id": "image_height", "label": "t:labels.image_height", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 600 },
    { "type": "select", "id": "media_position", "label": "t:labels.media_position", "options": [{ "value": "left", "label": "t:options.position.left" }, { "value": "right", "label": "t:options.position.right" }], "default": "left" },
    { "type": "header", "content": "t:general.story_chapters" },
    { "type": "checkbox", "id": "show_chapter_index", "label": "t:labels.show_chapter_index", "default": true },
    { "type": "select", "id": "chapter_heading_size", "label": "t:labels.chapter_heading_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "medium" },
    { "type": "select", "id": "chapter_text_size", "label": "t:labels.chapter_text_size", "options": [{ "value": "small", "label": "t:options.heading_size.small" }, { "value": "medium", "label": "t:options.heading_size.medium" }, { "value": "large", "label": "t:options.heading_size.large" }], "default": "medium" },
    { "type": "select", "id": "chapter_alignment", "label": "t:labels.chapter_alignment", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "right", "label": "t:options.alignment.right" }], "default": "left" },
    { "type": "header", "content": "t:general.motion" },
    { "type": "checkbox", "id": "enable_image_flip", "label": "t:labels.enable_image_flip", "default": true },
    { "type": "checkbox", "id": "enable_chapter_wheel", "label": "t:labels.enable_chapter_wheel", "default": true },
    { "type": "header", "content": "t:general.style" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "default": "#EBE7DD" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "t:general.story_chapter",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:labels.story_image" },
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Made for movement" },
        { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Quiet proportions and useful details keep the wardrobe considered from the first appointment to the last plan.</p>" },
        { "type": "text", "id": "link_label", "label": "t:labels.link_label" },
        { "type": "url", "id": "link", "label": "t:labels.link" }
      ]
    }
  ],
  "enabled_on": { "templates": ["index"] },
  "presets": [{ "name": "t:general.pinned_visual_story", "category": "Campaign & editorial", "blocks": [{ "type": "chapter" }, { "type": "chapter" }, { "type": "chapter" }] }]
}
{% endschema %}
