<script src="{{ 'collection-facets.js' | asset_url }}" defer></script>

<collection-discovery
  data-section-id="{{ section.id }}"
  data-loading-text="{{ 'collections.facets.loading' | t | escape }}"
  data-updated-text="{{ 'collections.facets.updated' | t | escape }}"
  data-error-text="{{ 'collections.facets.error' | t | escape }}"
>
  <p class="visually-hidden" role="status" aria-live="polite" data-collection-status></p>

  {% liquid
    assign products_per_page = section.settings.columns_desktop | times: section.settings.rows_per_page
    assign description_alignment = section.settings.collection_description_alignment | default: 'left'
  %}
  {% paginate collection.products by products_per_page %}
    {% assign mobile_sort_only = false %}
    {% if section.settings.enable_filtering == false %}
      {% assign mobile_sort_only = true %}
    {% endif %}
    {% if section.settings.enable_collection_count or section.settings.enable_filtering or section.settings.enable_sorting %}
      <div class="collection-controls">
      {% if section.settings.enable_filtering and collection.filters != empty and section.settings.desktop_filter_layout == 'drawer' %}
        <div class="collection-desktop-drawer" data-facets-panel>
          <button type="button" class="collection-desktop-drawer__open" data-facets-open>
            {% render 'icon', name: 'filter' %}
            <span>{{ 'collections.facets.filters' | t }}</span>
          </button>
          <dialog class="collection-facets-dialog" aria-labelledby="DesktopFacetsTitle" data-facet-dialog="desktop" data-overlay-motion="drawer-start" scroll-lock>
            <div class="collection-facets-dialog__header">
              <div>
                <h2 id="DesktopFacetsTitle">{{ 'collections.facets.filters' | t }}</h2>
                <p>{{ 'collections.product_count' | t: count: collection.products_count }}</p>
              </div>
              <button type="button" aria-label="{{ 'collections.facets.close' | t }}" data-facets-close>
                {% render 'icon', name: 'close' %}
              </button>
            </div>
            {% render 'facets',
              results: collection,
              form_id: 'CollectionFiltersDrawer',
              show_sort: false,
              open_groups: false
            %}
          </dialog>
        </div>
      {% endif %}

      {% if section.settings.enable_collection_count %}
        <p class="collection-controls__count" role="status" data-collection-count>
          {{ 'collections.product_count' | t: count: collection.products_count }}
        </p>
      {% endif %}

      {% if section.settings.enable_filtering or section.settings.enable_sorting %}
      <div class="collection-mobile-facets" data-facets-panel>
        <button type="button" class="collection-mobile-facets__open" data-facets-open>
          {% if section.settings.enable_filtering and section.settings.enable_sorting %}
            {{ 'collections.facets.filter_and_sort' | t }}
          {% elsif section.settings.enable_filtering %}
            {{ 'collections.facets.filters' | t }}
          {% else %}
            {{ 'collections.facets.sort_by' | t }}
          {% endif %}
          {% if section.settings.enable_filtering and collection.filters != empty -%}
            <span aria-hidden="true">+</span>
          {%- endif %}
        </button>
        <dialog class="collection-facets-dialog" aria-labelledby="MobileFacetsTitle" data-facet-dialog="mobile" data-overlay-motion="sheet" scroll-lock>
          <div class="collection-facets-dialog__header">
            <h2 id="MobileFacetsTitle">{{ 'collections.facets.filter_and_sort' | t }}</h2>
            <button type="button" aria-label="{{ 'collections.facets.close' | t }}" data-facets-close>
              {% render 'icon', name: 'close' %}
            </button>
          </div>
          {% render 'facets',
            results: collection,
            form_id: 'CollectionFiltersMobile',
            show_sort: section.settings.enable_sorting,
            sort_as_radios: true,
            sort_only: mobile_sort_only,
            open_groups: false
          %}
        </dialog>
      </div>
      {% endif %}

      {% if section.settings.enable_sorting %}
      <div class="collection-sort">
        {% render 'facets', results: collection, form_id: 'CollectionSort', show_sort: true, sort_as_menu: true, sort_only: true %}
      </div>
      {% endif %}
    </div>
    {% endif %}

    {% assign active_filter_count = 0 %}
    {% for filter in collection.filters %}
      {% assign active_filter_count = active_filter_count | plus: filter.active_values.size %}
      {% if filter.type == 'price_range' %}
        {% if filter.min_value.value or filter.max_value.value %}
          {% assign active_filter_count = active_filter_count | plus: 1 %}
        {% endif %}
      {% endif %}
    {% endfor %}

    <div data-collection-active-facets>
      {% if section.settings.enable_filtering and active_filter_count > 0 %}
        <div class="active-facets" aria-label="{{ 'collections.facets.active_filters' | t }}">
          {% for filter in collection.filters %}
            {% for value in filter.active_values %}
              <a href="{{ value.url_to_remove }}">
                {{- value.label | escape }}
                <span aria-hidden="true">×</span></a
              >
            {% endfor %}
            {% if filter.type == 'price_range' and filter.min_value.value or filter.max_value.value %}
              <a href="{{ filter.url_to_remove }}">
                {{ filter.min_value.value | default: 0 | money }}–
                {{- filter.max_value.value | default: filter.range_max | money }}
                <span aria-hidden="true">×</span>
              </a>
            {% endif %}
          {% endfor %}
          <a class="active-facets__clear" href="{{ collection.url }}">{{ 'collections.facets.clear_all' | t }}</a>
        </div>
      {% endif %}
    </div>

    <div
      class="collection-results"
      data-collection-results
      {% if section.settings.enable_filtering == false or collection.filters == empty or section.settings.desktop_filter_layout == 'drawer' %}
        data-without-filters
      {% endif %}
    >
      {% if section.settings.enable_filtering and collection.filters != empty and section.settings.desktop_filter_layout == 'sidebar' %}
        <aside class="collection-desktop-facets" aria-label="{{ 'collections.facets.filters' | t }}">
          {% render 'facets',
            results: collection,
            form_id: 'CollectionFiltersDesktop',
            show_sort: false,
            open_groups: true
          %}
        </aside>
      {% endif %}

      <div class="collection-results__products">
        {% assign show_collection_description = false %}
        {% if section.settings.show_collection_description and collection.description != blank %}
          {% assign show_collection_description = true %}
        {% endif %}
        {% if show_collection_description %}
          <div class="collection-grid-description collection-grid-description--{{ description_alignment }} rte">{{ collection.description }}</div>
        {% endif %}
        {% if collection.products_count > 0 %}
          <div class="product-grid" style="--product-grid-columns: {{ section.settings.columns_desktop }}; --product-grid-columns-mobile: {{ section.settings.columns_mobile }};">
            {% for product in collection.products %}
              {% render 'product-card',
                product: product,
                show_vendor: section.settings.show_vendor,
                show_badge: section.settings.show_badge,
                show_quick_add: section.settings.enable_quick_view,
                quick_add_label: section.settings.quick_view_label,
                show_second_image: section.settings.show_second_image,
                show_swatches: section.settings.show_variants,
                show_variant_options: section.settings.show_variants,
                image_ratio: section.settings.image_ratio,
                sizes: '(min-width: 60rem) 25vw, 50vw',
                card_index: forloop.index,
                card_count: forloop.length,
                entrance_delay: 0
              %}
            {% endfor %}
          </div>

          {% render 'pagination', paginate: paginate %}
        {% else %}
          <div class="collection-empty">
            <h2>{{ 'collections.empty_title' | t }}</h2>
            <p>{{ 'collections.empty_text' | t }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  {% endpaginate %}
</collection-discovery>

{% stylesheet %}
  collection-discovery {
    display: block;
    min-width: 0;
  }

  collection-discovery[aria-busy] .collection-results__products {
    pointer-events: none;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--product-grid-columns), minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
    padding-block-start: var(--space-6);
  }

  .collection-grid-description {
    max-inline-size: 44rem;
    padding-block: var(--space-6) var(--space-2);
  }

  .collection-grid-description--center { margin-inline: auto; text-align: center; }
  .collection-grid-description--right { margin-inline-start: auto; text-align: end; }

  .collection-controls {
    min-height: 3.5rem;
    padding-block: var(--space-1);
    border-block-end: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
  }

  .collection-controls__count {
    color: color-mix(in srgb, currentcolor 70%, transparent);
    font-family: var(--small-label-font);
    font-size: var(--small-label-size);
    letter-spacing: var(--small-label-letter-spacing);
    line-height: var(--small-label-line-height);
    text-transform: uppercase;
  }

  .collection-mobile-facets {
    display: none;
  }

  .collection-desktop-drawer__open {
    min-height: 2.25rem;
    padding: var(--space-2) 0;
    border: 0;
    background: transparent;
    color: currentcolor;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--small-label-font);
    font-size: var(--small-label-size);
    letter-spacing: var(--small-label-letter-spacing);
    line-height: var(--small-label-line-height);
  }

  .collection-facets-dialog {
    width: min(85vw, 28rem);
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    margin-inline-end: auto;
    padding: var(--space-4);
    border: 0;
  }

  .collection-facets-dialog::backdrop { background: transparent; }
  .collection-facets-dialog[open][data-overlay-visible]::backdrop { background: color-mix(in srgb, var(--overlay-color) var(--overlay-opacity), transparent); }

  .collection-facets-dialog__header {
    margin-block-end: var(--space-4);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: center;
  }

  .collection-facets-dialog__header::before {
    content: '';
    width: 2.75rem;
    flex: none;
  }

  .collection-facets-dialog__header > div {
    flex: 1;
  }

  .collection-facets-dialog__header h2 {
    font-family: var(--font-primary--family);
    font-size: 1rem;
  }

  .collection-facets-dialog__header p {
    color: color-mix(in srgb, currentcolor 65%, transparent);
    font-size: 0.8rem;
  }

  .collection-facets-dialog__header button {
    min-width: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: currentcolor;
    display: grid;
    place-items: center;
  }

  .collection-facets-dialog .facets__group summary {
    padding-block: var(--space-6);
  }

  .collection-sort .facets {
    position: relative;
    min-block-size: 2.5rem;
    gap: 0;
  }

  .collection-sort .facets__sort-menu--popover {
    position: absolute;
    z-index: 3;
    inset-block-start: 0;
    inset-inline-end: 0;
    min-inline-size: 12rem;
    border: 0;
  }

  .collection-sort .facets__sort-menu--popover summary {
    min-height: var(--field-theme-height);
    padding: .4rem .75rem;
    border: var(--field-theme-border-width) solid color-mix(in srgb, var(--color-foreground) 48%, var(--color-border));
    border-radius: var(--field-theme-radius);
    background: var(--color-background);
    font-family: var(--small-label-font);
    font-size: var(--small-label-size);
    letter-spacing: var(--small-label-letter-spacing);
    line-height: var(--small-label-line-height);
  }

  .collection-sort .facets__sort-menu--popover summary > span {
    display: none;
  }

  .collection-sort .facets__sort-menu--popover summary strong {
    font: inherit;
  }

  .collection-sort .facets__sort-menu--popover summary:is(:hover, :focus-visible) {
    border-color: var(--color-interactive);
    box-shadow: var(--focus-ring);
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-options {
    position: absolute;
    z-index: 1;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-end: 0;
    min-inline-size: 100%;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: .625rem;
    background: var(--color-background);
    box-shadow: 0 .75rem 1.5rem color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-option {
    position: relative;
    min-height: 2.4rem;
    border-radius: .35rem;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-option:hover {
    background: var(--color-interactive-background);
    transform: translateX(.2rem);
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-option:has(input:checked) {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-option:has(input:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  .collection-sort .facets__sort-menu--popover .facets__sort-option input[type='radio'] {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
  }

  .collection-results {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: var(--space-8);
  }

  .collection-results[data-without-filters] {
    grid-template-columns: 1fr;
  }

  .collection-desktop-facets {
    padding-block-start: var(--space-6);
  }

  .active-facets {
    padding-block: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .active-facets a {
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .active-facets__clear {
    border-color: transparent !important;
    text-decoration: underline !important;
    text-underline-offset: 0.2em;
  }

  .collection-empty {
    padding-block: clamp(var(--space-8), 12vw, 10rem);
    text-align: center;
  }

  @media (max-width: 63.99rem) {
    .product-grid {
      grid-template-columns: repeat(var(--product-grid-columns-mobile, 2), minmax(0, 1fr));
    }

    .collection-controls {
      min-height: 3rem;
      display: flex;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .collection-controls__count {
      flex: 1;
    }

    .collection-sort {
      display: none;
    }

    .collection-mobile-facets {
      display: block;
      flex: none;
    }

    .collection-mobile-facets__open {
      width: auto;
      min-height: 2.25rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: currentcolor;
      font-family: var(--small-label-font);
      font-size: var(--small-label-size);
      letter-spacing: var(--small-label-letter-spacing);
      line-height: var(--small-label-line-height);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }

    .collection-desktop-drawer {
      display: none;
    }

    .collection-results {
      grid-template-columns: 1fr;
    }

    .collection-desktop-facets {
      display: none;
    }
  }

  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

  }

  @media (max-width: 21.25rem) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection product grid",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:labels.products_per_row",
      "default": 4
    },
    {
      "type": "range",
      "id": "rows_per_page",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:labels.rows_per_page",
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.mobile_product_columns",
      "options": [
        { "value": "1", "label": "t:options.columns.one" },
        { "value": "2", "label": "t:options.columns.two" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "1 / 1", "label": "t:options.image_ratio.square" },
        { "value": "4 / 5", "label": "t:options.image_ratio.portrait" },
        { "value": "3 / 4", "label": "t:options.image_ratio.tall" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:labels.show_vendor",
      "default": false
    },
    { "type": "checkbox", "id": "show_badge", "label": "t:labels.show_product_badges", "default": true },
    { "type": "checkbox", "id": "show_second_image", "label": "t:labels.show_second_image", "default": true },
    { "type": "checkbox", "id": "show_variants", "label": "t:labels.show_variants", "default": false },
    { "type": "checkbox", "id": "enable_quick_view", "label": "t:labels.enable_quick_view", "default": true },
    {
      "type": "text",
      "id": "quick_view_label",
      "label": "t:labels.quick_view_label",
      "default": "Quick add",
      "visible_if": "{{ section.settings.enable_quick_view }}"
    },
    { "type": "checkbox", "id": "show_collection_description", "label": "t:labels.show_collection_description", "default": true },
    {
      "type": "select",
      "id": "collection_description_alignment",
      "label": "t:labels.collection_description_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.show_collection_description }}"
    },
    {
      "type": "select",
      "id": "desktop_filter_layout",
      "label": "t:labels.desktop_filter_layout",
      "options": [
        { "value": "sidebar", "label": "t:options.filter_layout.sidebar" },
        { "value": "drawer", "label": "t:options.filter_layout.drawer" }
      ],
      "default": "drawer",
      "visible_if": "{{ section.settings.enable_filtering }}"
    },
    { "type": "checkbox", "id": "enable_collection_count", "label": "t:labels.enable_collection_count", "default": true },
    { "type": "checkbox", "id": "enable_filtering", "label": "t:labels.enable_filtering", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "t:labels.enable_sorting", "default": true }
  ],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
