{% liquid
  assign related_article_count = 0
  for related_article in blog.articles
    if related_article.id != article.id
      assign related_article_count = related_article_count | plus: 1
      if related_article_count == 4
        break
      endif
    endif
  endfor

  assign section_heading = section.settings.heading
  if section_heading == blank
    assign section_heading = 'blog.other_stories' | t
  endif
%}

{% if related_article_count > 0 %}
  <section class="related-stories" aria-labelledby="RelatedStoriesHeading-{{ section.id }}" {{ section.shopify_attributes }}>
    <header class="related-stories__header">
      <h2 id="RelatedStoriesHeading-{{ section.id }}">{{ section_heading | escape }}</h2>
    </header>
    <ul class="related-stories__grid curated-grid--center-incomplete" role="list">
      {% assign rendered_related_articles = 0 %}
      {% for related_article in blog.articles %}
        {% if related_article.id != article.id and rendered_related_articles < 4 %}
          {% assign rendered_related_articles = rendered_related_articles | plus: 1 %}
          <li>
            <article class="related-stories__card">
              <a class="related-stories__media" href="{{ related_article.url }}" aria-label="{{ related_article.title | escape }}">
                {% if related_article.image %}
                  {{ related_article.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '240, 360, 480, 720', sizes: '(min-width: 64rem) 22vw, (min-width: 48rem) 30vw, 45vw' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              </a>
              <div class="related-stories__content">
                <p>{{ related_article.published_at | time_tag: format: 'date' }}</p>
                <h3><a href="{{ related_article.url }}">{{ related_article.title | escape }}</a></h3>
              </div>
            </article>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </section>
{% endif %}

{% stylesheet %}
  .related-stories { border-block-start: 1px solid var(--color-border); margin: var(--space-8) auto; max-inline-size: min(68rem, var(--page-width)); padding: var(--space-6) var(--page-margin) 0; }
  .related-stories__header { margin-block-end: var(--space-5); text-align: center; }
  .related-stories h2 { font-size: clamp(1.5rem, 2.5vw, 2.25rem); line-height: 1.05; margin: 0; }
  .related-stories__grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 16rem)); justify-content: center; list-style: none; margin: 0; padding: 0; }
  .related-stories__grid > li { min-inline-size: 0; }
  .related-stories__card { display: grid; gap: var(--space-3); }
  .related-stories__media { aspect-ratio: 3 / 2; background: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background)); display: block; overflow: hidden; }
  .related-stories__media img, .related-stories__media svg { block-size: 100%; display: block; inline-size: 100%; object-fit: cover; transition: transform .35s ease; }
  .related-stories__content { display: grid; gap: var(--space-2); }
  .related-stories__content p { color: color-mix(in srgb, var(--color-foreground) 66%, var(--color-background)); font-size: .75rem; margin: 0; }
  .related-stories h3 { font-size: 1rem; line-height: 1.2; margin: 0; }
  .related-stories h3 a { color: inherit; text-decoration: none; }
  .related-stories h3 a:is(:hover, :focus-visible) { color: var(--color-accent); text-decoration: underline; }
  @media (hover: hover) and (pointer: fine) { .related-stories__media:hover img { transform: scale(1.025); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.related_stories",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.related_stories_heading" }
  ],
  "enabled_on": { "templates": ["article"] },
  "presets": [{ "name": "t:general.related_stories" }]
}
{% endschema %}
