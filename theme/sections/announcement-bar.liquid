{% if section.settings.text != blank %}
  {% assign marquee_repetitions = section.settings.marquee_repetitions | default: 3 %}
  <div
    class="announcement-bar full-width{% if section.settings.enable_marquee %} announcement-bar--marquee{% endif %}"
    role="region"
    aria-label="{{ 'accessibility.announcement' | t }}"
    style="--announcement-background: {{ section.settings.background_color | default: '#242119' }}; --announcement-color: {{ section.settings.text_color | default: '#F5F3EE' }}; --announcement-min-height: {{ section.settings.bar_height | default: 32 }}px; --announcement-font-size: {{ section.settings.text_size | default: 12 }}px; --announcement-marquee-duration: {{ section.settings.marquee_speed | default: 18 }}s;"
    {{ section.shopify_attributes }}
  >
    {% if section.settings.enable_marquee %}
      <div class="announcement-bar__marquee-viewport">
        <div class="announcement-bar__marquee-track">
          {% for sequence in (1..2) %}
            <div class="announcement-bar__marquee-group"{% if sequence == 2 %} aria-hidden="true"{% endif %}>
              {% for repetition in (1..marquee_repetitions) %}
                {% if section.settings.link != blank %}
                  {% if sequence == 1 and forloop.first %}
                    <a class="announcement-bar__message announcement-bar__link" href="{{ section.settings.link }}">
                      <span>{{ section.settings.text | escape }}</span><span class="announcement-bar__link-arrow" aria-hidden="true">&#8594;</span>
                    </a>
                  {% else %}
                    <a class="announcement-bar__message announcement-bar__link" href="{{ section.settings.link }}" tabindex="-1" aria-hidden="true">
                      <span>{{ section.settings.text | escape }}</span><span class="announcement-bar__link-arrow" aria-hidden="true">&#8594;</span>
                    </a>
                  {% endif %}
                {% elsif sequence == 1 and forloop.first %}
                  <p class="announcement-bar__message">{{ section.settings.text | escape }}</p>
                {% else %}
                  <span class="announcement-bar__message" aria-hidden="true">{{ section.settings.text | escape }}</span>
                {% endif %}
                <span class="announcement-bar__marquee-separator" aria-hidden="true">&middot;</span>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% elsif section.settings.link != blank %}
      <a class="announcement-bar__message announcement-bar__link" href="{{ section.settings.link }}">
        <span>{{ section.settings.text | escape }}</span><span class="announcement-bar__link-arrow" aria-hidden="true">&#8594;</span>
      </a>
    {% else %}
      <p class="announcement-bar__message">{{ section.settings.text | escape }}</p>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar { align-items: center; background: var(--announcement-background, var(--color-foreground)); color: var(--announcement-color, var(--color-background)); display: flex; font-size: var(--announcement-font-size, .75rem); letter-spacing: .04em; min-block-size: var(--announcement-min-height, 2rem); overflow: hidden; padding: var(--space-2) var(--page-margin); text-align: center; }
  .announcement-bar__message { align-items: center; color: inherit; display: inline-flex; gap: .45rem; justify-content: center; margin: 0; min-inline-size: 0; }
  .announcement-bar__link { text-decoration: none; }
  .announcement-bar__link-arrow { font-size: 1.05em; line-height: 1; transition: transform 180ms ease; }
  .announcement-bar__link:is(:hover, :focus-visible) .announcement-bar__link-arrow { transform: translateX(.22rem); }
  .announcement-bar__marquee-viewport { inline-size: 100%; overflow: hidden; }
  .announcement-bar__marquee-track { --announcement-marquee-gap: clamp(.8rem, 3vw, 1.5rem); animation: announcement-bar-scroll var(--announcement-marquee-duration, 18s) linear infinite; display: flex; inline-size: max-content; }
  .announcement-bar__marquee-group { align-items: center; display: flex; flex: 0 0 auto; gap: var(--announcement-marquee-gap); inline-size: max-content; padding-inline-end: var(--announcement-marquee-gap); }
  .announcement-bar__marquee-separator { flex: 0 0 auto; font-size: 1.3em; font-weight: 700; line-height: 1; }
  .announcement-bar--marquee .announcement-bar__message { flex: 0 0 auto; min-inline-size: auto; white-space: nowrap; }
  .announcement-bar--marquee:is(:hover, :focus-within) .announcement-bar__marquee-track { animation-play-state: paused; }

  @keyframes announcement-bar-scroll {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  @media (min-width: 48rem) {
    .announcement-bar__marquee-group { gap: 0; inline-size: max-content; justify-content: space-around; min-inline-size: 100vw; padding-inline-end: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__marquee-track { animation: none; inline-size: 100%; }
    .announcement-bar__marquee-group { inline-size: 100%; justify-content: center; padding-inline-end: 0; }
    .announcement-bar__marquee-group > :not(:first-child) { display: none; }
    .announcement-bar__marquee-group + .announcement-bar__marquee-group { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.announcement_bar",
  "settings": [
    { "type": "text", "id": "text", "label": "t:labels.text", "default": "Complimentary delivery over $150" },
    { "type": "url", "id": "link", "label": "t:labels.link" },
    { "type": "header", "content": "t:general.colors" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "default": "#242119" },
    { "type": "color", "id": "text_color", "label": "t:labels.text_color", "default": "#F5F3EE" },
    { "type": "range", "id": "bar_height", "label": "t:labels.bar_height", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "text_size", "label": "t:labels.text_size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "header", "content": "t:labels.marquee" },
    { "type": "checkbox", "id": "enable_marquee", "label": "t:labels.enable_marquee", "default": false },
    { "type": "range", "id": "marquee_repetitions", "label": "t:labels.marquee_repetitions", "min": 1, "max": 8, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "marquee_speed",
      "label": "t:labels.marquee_speed",
      "options": [
        { "value": "26", "label": "t:options.speed.slow" },
        { "value": "18", "label": "t:options.speed.standard" },
        { "value": "12", "label": "t:options.speed.fast" }
      ],
      "default": "18"
    }
  ],
  "presets": [{ "name": "t:general.announcement_bar" }]
}
{% endschema %}
