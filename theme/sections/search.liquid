<script src="{{ 'predictive-search.js' | asset_url }}" defer></script>

<section class="search-page">
  <header class="search-page__header">
    <p>{{ 'search.eyebrow' | t }}</p>
    <h1>{{ 'search.title' | t }}</h1>
  </header>

{% render 'predictive-search-form', context_id: section.id, search_terms: search.terms %}

{% if search.performed %}
  {% capture formatted_search_terms %}<span class="search-page__terms">'{{ search.terms | escape }}'</span>{% endcapture %}
  {% if search.results_count == 0 %}
    <div class="search-page__message"><p>{{ 'search.no_results_html' | t: terms: formatted_search_terms }}</p></div>
  {% else %}
    <p class="search-page__count">
      {% if search.results_count == 1 %}
        {{ 'search.result_for_html' | t: terms: formatted_search_terms, count: search.results_count }}
      {% else %}
        {{ 'search.results_for_html' | t: terms: formatted_search_terms, count: search.results_count }}
      {% endif %}
    </p>

    <div class="search-results">
      {% paginate search.results by 20 %}
        {% # Search result items may be an article, a page, or a product. %}
        {% for result in search.results %}
          {% if result.object_type == 'product' %}
            {% render 'product-card',
              product: result,
              image_ratio: '4 / 5',
              sizes: '(min-width: 60rem) 25vw, 50vw',
              card_index: forloop.index,
              card_count: forloop.length
            %}
          {% else %}
            <article class="search-result">
            {% assign featured_image = result.featured_image | default: result.image %}
            {% if featured_image %}
              {% render 'image', class: 'search-result__image', image: featured_image, url: result.url, width: 400 %}
            {% endif %}
            <div class="search-result__content">
              <p class="search-result__type">{{ result.object_type | escape }}</p>
              <h2>{{ result.title | link_to: result.url }}</h2>
            </div>
            </article>
          {% endif %}
        {% endfor %}

        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    </div>
  {% endif %}
{% endif %}
</section>

{% stylesheet %}
  .search-page {
    padding-block: clamp(var(--space-8), 8vw, 7rem);
  }

  .search-page__header {
    margin-block-end: var(--space-6);
  }

  .search-page__header p,
  .search-page__count,
  .search-result__type {
    color: color-mix(in srgb, currentcolor 65%, transparent);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .search-page__header h1 {
    font-size: clamp(var(--heading-size-96), calc(var(--heading-size-96) + 7vw), var(--heading-size-192));
  }

  .search-page__message {
    padding-block: var(--space-8);
  }

  .search-page__count {
    margin-block: var(--space-8) var(--space-4);
  }

  .search-page__terms {
    text-transform: none;
  }

  .search-results {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
  }

  .search-result {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .search-result__image,
  .search-result__image > img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .search-result__content h2 {
    margin-block-start: var(--space-2);
    font-size: clamp(var(--heading-size-35), calc(var(--heading-size-35) + 1.5vw), var(--heading-size-45));
  }

  .search-results .prev,
  .search-results .page,
  .search-results .next {
    grid-column: 1 / -1;
  }

  @media (max-width: 47.99rem) {
    .search-page {
      padding-block: var(--space-8);
    }

    .search-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-4);
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": [],
  "enabled_on": { "templates": ["search"] }
}
{% endschema %}
